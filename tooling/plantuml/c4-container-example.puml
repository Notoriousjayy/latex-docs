' --------------------------------------------------------------
' Diagram   : Ordering system container view
' Type      : C4 Container (C4-PlantUML 2.13.0 from the pinned jar)
' Owns      : Applications and data stores of the ordering system
'             used by the other framework examples, with role tags.
' Author    : framework demo
' Status    : draft
' --------------------------------------------------------------
@startuml ordering-containers

!include c4/container-diagram-style.iuml

C4_TITLE(Ordering System, framework example - illustrative technologies)

Person(customer, "Customer", "Places and tracks orders")
System_Ext(payments, "Payment Provider", "Card authorisation")

System_Boundary(ordering, "Ordering System") {
  Container(web, "Web Application", "single-page app", "Order entry and tracking UI")
  Container(api, "Order API", "HTTP service", "Order rules, pricing, fulfilment orchestration")
  ContainerDb(db, "Order Database", "relational database", "Orders, customers, payments")
  ContainerQueue(events, "Order Events", "message broker", "Order lifecycle events")
  Container(legacy, "Legacy Repricing Batch", "nightly batch", "Rewrites prices directly in the database", $tags="invalid")
}

Rel(customer, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads / writes", "SQL")
Rel(api, events, "Publishes", "AMQP")
Rel(api, payments, "Authorises payment", "HTTPS")
Rel(legacy, db, "Rewrites prices, bypassing the API", "SQL", $tags="invalid")

SHOW_LEGEND()
@enduml
