' --------------------------------------------------------------
' Diagram   : Ordering system context view
' Type      : C4 System Context (C4-PlantUML 2.13.0 from the pinned jar)
' Owns      : The ordering system, its users and neighbouring systems;
'             internal containers are deliberately absent.
' Author    : framework demo
' Status    : draft
' --------------------------------------------------------------
@startuml ordering-context

!include c4/context-diagram-style.iuml

C4_TITLE(Ordering System, framework example)

Person(customer, "Customer", "Places and tracks orders")
Person_Ext(auditor, "Auditor", "Reviews order history")
System(ordering, "Ordering System", "Accepts, prices and fulfils orders")
System_Ext(payments, "Payment Provider", "Card authorisation")
System_Ext(erp, "ERP", "Stock levels", $tags="proposed")

Rel(customer, ordering, "Places orders", "HTTPS")
Rel(auditor, ordering, "Reviews orders", "HTTPS")
Rel(ordering, payments, "Authorises payments", "HTTPS")
Rel(ordering, erp, "Reads stock levels", "protocol not specified", $tags="proposed")

SHOW_LEGEND()
@enduml
