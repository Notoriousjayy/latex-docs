' ======================================================================
'  house-tokens.iuml
'  Notation-neutral visual tokens shared by every diagram family.
' ----------------------------------------------------------------------
'  HIERARCHY POSITION
'      house-tokens            <-- THIS FILE (neutral foundation)
'        |-- uml-base          (UML 2.5.1 families: structural/behavioral/interaction)
'        |-- c4-base           (C4 model views via C4-PlantUML)
'
'  RESPONSIBILITY
'      Owns the ONE authoritative definition of every shared visual
'      decision that is independent of notation: the base palette, the
'      derived semantic role tokens, typography constants and the role
'      stereotype classes (<<ok>>, <<invalid>>, ...). It contains no
'      skinparam that assumes a diagram family; those live in uml-base
'      and c4-base.
'
'  WHAT THIS MODULE OWNS
'      - base palette tokens ($theme_*)          : navy, steel, teal, brick, paper, ink ...
'      - role tokens ($fill_*, $deep_*, $line_*) : derived from the base hues
'      - typography constants ($font_*)
'      - role stereotype <style> classes usable on any element
'
'  WHAT THIS MODULE DOES NOT OWN
'      - any UML or C4 element styling (see uml-base / c4-base)
'      - rendering configuration such as dpi (see config.puml)
'
'  DERIVATION
'      Fill tints keep the role hue and are set to HSL lightness 0.915
'      ($fill_*) and 0.82 ($deep_*) with saturation clamped to 0.50..0.75
'      (neutral: 0.06/0.05). Line tokens are the base hue itself. Meaning
'      must never rely on colour alone: pair a role with a label, shape,
'      line style or stereotype so it survives grayscale printing.
' ======================================================================

!ifndef HOUSE_TOKENS_INCLUDED
!define HOUSE_TOKENS_INCLUDED

' ----------------------------------------------------------------------
' 1. BASE PALETTE  --  named by role, never by hue, never raw hex in users
' ----------------------------------------------------------------------
!$theme_primary    = "#1F3B73"   /' navy   - primary structural emphasis '/
!$theme_secondary  = "#4A6FA5"   /' steel  - secondary emphasis '/
!$theme_accent     = "#2A8C8C"   /' teal   - behavioral / dynamic emphasis '/
!$theme_warn       = "#B5471F"   /' brick  - warnings, exceptional flow '/
!$theme_surface    = "#F7F7F2"   /' paper  - container fill '/
!$theme_surface_2  = "#ECEEE8"   /' paper2 - nested container fill '/
!$theme_border     = "#B8B8B0"   /' border - default stroke '/
!$theme_text       = "#2D2D2D"   /' ink    - body text '/
!$theme_muted      = "#6E6E6E"   /' muted  - secondary text, captions '/
!$theme_grid       = "#D8D8D2"   /' grid   - dividers, lifeline ticks '/
' Hashless on purpose: `;text:#FFFFFF` is a syntax error after an element colour
' on 1.2026.7, while `;text:FFFFFF` and `<color:FFFFFF>` both parse.
!$theme_on_dark    = "FFFFFF"    /' text placed on a $line_* filled element '/

' ----------------------------------------------------------------------
' 2. SEMANTIC ROLE TOKENS  --  the only colours a source diagram may use
' ----------------------------------------------------------------------
' role      meaning (pair with a label/shape; colour is reinforcement only)
' primary   the element of interest, the system in scope, tier/layer A
' dynamic   behaviour, runtime, data in motion, tier/layer B
' ok        valid, allowed, healthy, success path, tier/layer C
' caution   relaxed rule, degraded, pending, attention, tier/layer D
' invalid   violation, error, failure, intentionally wrong example
' alt       alternative, cross-cutting, aspect, tier/layer E
' neutral   external, out of scope, inactive, environment
'
' $fill_*  light tint for element bodies (dark text)
' $deep_*  stronger tint for nesting or a second element of the same role
' $line_*  stroke / text colour of the role; also a strong fill with $theme_on_dark text
!$fill_primary  = "#DDE5F6"
!$deep_primary  = "#B7C8EC"
!$line_primary  = $theme_primary
!$line_secondary = $theme_secondary

!$fill_dynamic  = "#DEF5F5"
!$deep_dynamic  = "#B8EAEA"
!$line_dynamic  = $theme_accent

!$fill_ok       = "#DEF4E3"
!$deep_ok       = "#BAE8C4"
!$line_ok       = "#3D7A4A"

!$fill_caution  = "#F9ECDA"
!$deep_caution  = "#F1D7B1"
!$line_caution  = "#B7791F"

!$fill_invalid  = "#F9E2DA"
!$deep_invalid  = "#F1C2B1"
!$line_invalid  = $theme_warn

!$fill_alt      = "#E4DEF4"
!$deep_alt      = "#C7BAE8"
!$line_alt      = "#6B5B95"

!$fill_neutral  = "#EBE8E8"
!$deep_neutral  = "#D3CFCF"
!$line_neutral  = $theme_muted

' ----------------------------------------------------------------------
' 3. TYPOGRAPHY  --  one family, one size hierarchy for every notation
' ----------------------------------------------------------------------
' "Helvetica" was never installed locally or on the CI runner, so Java
' silently substituted a logical font whose glyph set lacked U+25AF (the
' C4 legend border marker rendered as tofu). DejaVu Sans is shipped by
' fonts-dejavu-core on every Debian/Ubuntu fontconfig install (and is
' installed explicitly by the render action), so metrics are the same in
' CI and locally and every glyph the framework emits is present.
!$font_family     = "DejaVu Sans"
!$font_size_title = 16
!$font_size_body  = 12
!$font_size_small = 11
!$font_size_caption = 10
!$font_size_legend  = 10
!$font_size_stereo  = 10

' ----------------------------------------------------------------------
' 4. ROLE STEREOTYPE CLASSES  --  <<ok>>, <<invalid>>, ... on any element
' ----------------------------------------------------------------------
' Authors tag an element with a role stereotype instead of writing a
' colour. `hide stereotype` (set by the family bases) keeps the tag out of
' the picture; the legend explains the role. Notes and arrows keep using
' $fill_* / $line_* tokens directly because PlantUML does not style them
' through stereotype classes in every family.
<style>
.primary {
  BackgroundColor $fill_primary
  LineColor $line_primary
}
.dynamic {
  BackgroundColor $fill_dynamic
  LineColor $line_dynamic
}
.ok {
  BackgroundColor $fill_ok
  LineColor $line_ok
}
.caution {
  BackgroundColor $fill_caution
  LineColor $line_caution
}
.invalid {
  BackgroundColor $fill_invalid
  LineColor $line_invalid
  LineThickness 1.5
}
.alt {
  BackgroundColor $fill_alt
  LineColor $line_alt
}
.neutral {
  BackgroundColor $fill_neutral
  LineColor $line_neutral
  LineStyle 4
}
.external {
  BackgroundColor $fill_neutral
  LineColor $line_neutral
  LineStyle 4
}
</style>

' Role tags are presentation, not model stereotypes: keep them out of the
' picture while leaving genuine UML stereotypes (<<device>>, <<interface>>)
' visible. Verified on 1.2026.7 for class, component, sequence, activity,
' state and use-case diagrams.
hide <<primary>> stereotype
hide <<dynamic>> stereotype
hide <<ok>> stereotype
hide <<caution>> stereotype
hide <<invalid>> stereotype
hide <<alt>> stereotype
hide <<neutral>> stereotype
hide <<external>> stereotype

!endif
' ======================================================================
'  END house-tokens.iuml
' ======================================================================
