' ======================================================================
'  uml-base.iuml
'  Root style module for the UML PlantUML style framework.
' ----------------------------------------------------------------------
'  HIERARCHY POSITION
'      house-tokens            (neutral palette / typography / role tags)
'        |-- uml-base          <-- THIS FILE (UML root)
'              |-- uml-structural
'              |-- uml-behavioral
'                    |-- uml-interaction
'        |-- c4-base           (sibling: C4 views, see c4-base.iuml)
'
'  RESPONSIBILITY
'      Owns ONLY concerns genuinely shared by every UML diagram type.
'      Anything specific to a UML category (structural/behavioral/
'      interaction) or to a single diagram type belongs in a child
'      module, never here. Colours and font sizes are NOT defined here:
'      they are consumed from house-tokens so UML and C4 share one
'      authoritative palette.
'
'  WHAT THIS MODULE OWNS
'      - the global <style> defaults (background, shadow, rounding,
'        wrapping, typography roles, arrows, notes, legends, stereotypes)
'      - note styling and reusable note macros
'      - stereotype + tagged-value conventions
'      - generic helper macros (captions, dividers, monochrome mode)
'      - shared documentation comment template
'
'  WHAT THIS MODULE EXPLICITLY DOES NOT OWN
'      - palette or role tokens                      (house-tokens)
'      - any class/object/component/node-specific styling
'      - any actor/state/activity-specific styling
'      - any lifeline/message/activation-specific styling
'      - any diagram-type-specific layout overrides
'
'  NAMING CONVENTIONS USED HERE AND INHERITED BY ALL DESCENDANTS
'      Theme tokens   : $theme_*, $fill_*, $deep_*, $line_*  (house-tokens)
'      Base macros    : UML_<CONCEPT>      (e.g. UML_NOTE_INFO)
'      Category macros: STRUCT_*, BEHAV_*, INTER_*  (in child modules)
'      Diagram macros : <DIAG>_*           (e.g. CLASS_, SEQ_)
'
'  IMPLEMENTATION NOTE
'      The include chain models UML 2.5.1 Annex A's informative diagram
'      taxonomy as a convenience for sharing <style> definitions. It is a
'      preprocessor include graph, not UML generalization: nothing here
'      establishes semantic correctness of a diagram.
' ======================================================================

!ifndef UML_BASE_INCLUDED
!define UML_BASE_INCLUDED

' The neutral foundation is the only module uml-base may include.
!include house-tokens.iuml

' ----------------------------------------------------------------------
' 1. GLOBAL STYLE  --  applied to every UML diagram
' ----------------------------------------------------------------------
' One CSS-like <style> block owns every repository-wide presentation
' default; skinparam is banned from first-party sources (enforced by
' tooling/scripts/plantuml_lint.py). Each mapping below was verified
' pixel-equivalent (or better) against the legacy skinparam on the
' pinned PlantUML 1.2026.7 jar; the only intentional differences are
' documented inline.
'
' Transparent background keeps PNG/SVG composable on the LaTeX page; the
' JPEG derivative is flattened onto $theme_surface by the renderer.
'
' CSS Padding only reaches activity boxes (the deprecated skinparam
' padding drew a banner since 1.2026.7); 14 = PlantUML's default 10 + the
' 4 the legacy skinparam added. Other element types keep PlantUML defaults.
<style>
document {
  BackgroundColor transparent
}
root {
  Shadowing 0
  RoundCorner 6
  HorizontalAlignment center
  MaximumWidth 220
  FontName $font_family
  FontSize $font_size_body
  FontColor $theme_text
}
title {
  FontName $font_family
  FontSize $font_size_title
  FontColor $theme_primary
  FontStyle bold
}
caption {
  FontName $font_family
  FontSize $font_size_caption
  FontColor $theme_muted
  FontStyle italic
}
' Arrow / line defaults (descendants override only the heads/styles
' that are semantically different in their category).
arrow {
  LineColor $theme_text
  LineThickness 1
  FontColor $theme_text
  FontSize $font_size_small
}
' Notes (plain note style; categories override accent variants)
note {
  BackgroundColor $theme_surface
  LineColor $theme_border
  FontColor $theme_text
  FontSize $font_size_small
}
' Legend (house convention: every published view carries a compact legend
' when it uses role colours or non-obvious notation; see UML_LEGEND_ROLES)
legend {
  BackgroundColor $theme_surface
  LineColor $theme_border
  FontColor $theme_text
  FontSize $font_size_legend
}
' Stereotype text (consistent across every diagram type)
stereotype {
  FontSize $font_size_stereo
  FontStyle italic
  FontColor $theme_muted
}
activityDiagram {
  activity {
    Padding 14
  }
}
</style>

' ----------------------------------------------------------------------
' 2. SHARED HELPER MACROS
' ----------------------------------------------------------------------
' Every macro defined here is safe to call from ANY descendant module
' or any user diagram. Category-specific helpers live in child modules.

' --- Note variants (all UML diagrams use notes the same way) ---
' Attached notes accept no alias in class/sequence diagrams; $id is kept for call-site compatibility only.
!unquoted procedure UML_NOTE_INFO($id, $target, $text)
note right of $target $theme_surface
  $text
end note
!endprocedure

!unquoted procedure UML_NOTE_WARN($id, $target, $text)
note right of $target $fill_invalid
  <color:$line_invalid><b>!</b></color> $text
end note
!endprocedure

' --- Caption helper: standardised italic muted footer line ---
!unquoted procedure UML_CAPTION($text)
caption $text
!endprocedure

' --- Optional edge label ---
' `A -- B : ` with an empty label is a syntax error in class, component
' and state diagrams on 1.2026.7, so every helper with a $label="" default
' appends the label through this function instead of a literal " : ".
!unquoted function $uml_label($label)
  !if ($label == "")
    !return ""
  !endif
  !return ": " + $label
!endfunction

' --- Stereotype helper: keeps guillemets consistent everywhere ---
!unquoted function UML_STEREO($s)
!return "<<" + $s + ">>"
!endfunction

' --- Tagged-value helper: prints {key = value} in muted italic ---
!unquoted function UML_TAG($k, $v)
!return "<color:" + $theme_muted + "><i>{" + $k + " = " + $v + "}</i></color>"
!endfunction

' --- Section divider ---
' `== text ==` is the sequence-diagram divider only. In a class body it
' is a member separator and in activity syntax it is a syntax error, so
' this helper is valid in sequence/communication diagrams alone; other
' families should use `partition`/`package` grouping instead.
!unquoted procedure UML_DIVIDER($text)
== $text ==
!endprocedure

' --- Role legend: one row per role the diagram actually uses ---
' Every published view that relies on role colours must explain them
' (ISO/IEC/IEEE 42010:2022, 6.8: a view component without a governing
' model kind carries a legend; the house adopts this for all views).
' Usage:
'   UML_LEGEND_BEGIN()                 (or UML_LEGEND_BEGIN(bottom))
'   UML_LEGEND_ROLE(ok, allowed dependency)
'   UML_LEGEND_ROLE(invalid, architectural violation)
'   UML_LEGEND_END()
' Unknown roles render with the neutral swatch so a typo is visible in review.
!unquoted function $uml_role_swatch($role)
  !if ($role == "primary")
    !return $fill_primary
  !elseif ($role == "dynamic")
    !return $fill_dynamic
  !elseif ($role == "ok")
    !return $fill_ok
  !elseif ($role == "caution")
    !return $fill_caution
  !elseif ($role == "invalid")
    !return $fill_invalid
  !elseif ($role == "alt")
    !return $fill_alt
  !endif
  !return $fill_neutral
!endfunction

!unquoted procedure UML_LEGEND_BEGIN($position="right")
legend $position
!endprocedure

!unquoted procedure UML_LEGEND_ROLE($role, $meaning)
  |<$uml_role_swatch($role)>   | $meaning |
!endprocedure

!unquoted procedure UML_LEGEND_END()
end legend
!endprocedure

' --- Monochrome presentation (notation-reference diagrams) ---
' The legacy `skinparam monochrome true` is banned with every other
' skinparam. This macro is the supported black-on-white presentation for
' diagrams whose subject is the notation itself (e.g. the UML 2.5.1
' legend). It overrides every selector the shared modules colour, so it
' must be called once, immediately after the leaf style !include.
' Difference vs the legacy directive: PlantUML's monochrome also forced
' grey ramps on a handful of built-in icons; this override keeps those
' icons' default rendering while making all framework-owned fills white,
' strokes black and text black.
!unquoted procedure UML_MONOCHROME()
<style>
document {
  BackgroundColor white
}
root {
  BackgroundColor white
  LineColor black
  FontColor black
}
title {
  FontColor black
  LineColor transparent
  BackgroundColor transparent
}
caption {
  FontColor black
  LineColor transparent
  BackgroundColor transparent
}
arrow {
  LineColor black
  FontColor black
}
note {
  BackgroundColor white
  LineColor black
  FontColor black
}
legend {
  BackgroundColor white
  LineColor black
  FontColor black
}
stereotype {
  FontColor black
}
class, object, component, interface, node, package, rectangle, database, queue, storage, cloud, folder, frame, card, hexagon, artifact, agent, collections, file, actor, usecase, person {
  BackgroundColor white
  LineColor black
  FontColor black
}
activityDiagram {
  activity {
    BackgroundColor white
    LineColor black
    FontColor black
  }
  diamond {
    BackgroundColor white
    LineColor black
    FontColor black
  }
  start {
    BackgroundColor black
  }
  stop {
    BackgroundColor black
  }
  end {
    BackgroundColor black
  }
  activityBar {
    BackgroundColor black
  }
  arrow {
    LineColor black
    FontColor black
  }
  swimlane {
    LineColor black
    FontColor black
  }
}
stateDiagram {
  state {
    BackgroundColor white
    LineColor black
    FontColor black
  }
  circle {
    BackgroundColor black
  }
  arrow {
    LineColor black
    FontColor black
  }
}
sequenceDiagram {
  participant {
    BackgroundColor white
    LineColor black
    FontColor black
  }
  actor {
    BackgroundColor white
    LineColor black
  }
  lifeLine {
    BackgroundColor white
    LineColor black
  }
  box {
    BackgroundColor white
    LineColor black
  }
  group {
    LineColor black
  }
  groupHeader {
    BackgroundColor white
    LineColor black
    FontColor black
  }
  separator {
    BackgroundColor white
    LineColor black
    FontColor black
  }
  reference {
    BackgroundColor white
    LineColor black
    FontColor black
  }
  referenceHeader {
    BackgroundColor white
    LineColor black
    FontColor black
  }
  arrow {
    LineColor black
    FontColor black
  }
}
</style>
!endprocedure

' ----------------------------------------------------------------------
' 3. DOCUMENTATION COMMENT TEMPLATE
' ----------------------------------------------------------------------
' Every diagram authored against this framework should begin with a
' header comment of this form so reviewers can locate the spec quickly:
'
'   ' --------------------------------------------------------------
'   ' Diagram   : <name>
'   ' Type      : <UML diagram type, e.g. Class | Sequence | ...>
'   ' Owns      : <which architectural concern this diagram captures>
'   ' Author    : <author / team>
'   ' Status    : draft | review | approved
'   ' --------------------------------------------------------------
'
' A diagram-specific module MAY emit this header automatically via
' a macro, but it is not enforced here.

!endif
' ======================================================================
'  END uml-base.iuml
' ======================================================================



