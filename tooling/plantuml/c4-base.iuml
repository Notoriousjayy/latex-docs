' ======================================================================
'  c4-base.iuml
'  Root style module for C4 model views rendered with C4-PlantUML.
' ----------------------------------------------------------------------
'  HIERARCHY POSITION
'      house-tokens            (neutral palette / typography / role tags)
'        |-- c4-base           <-- THIS FILE (C4 root)
'              |-- c4/context-diagram-style     (System Context / Landscape)
'              |-- c4/container-diagram-style
'              |-- c4/component-diagram-style
'              |-- c4/dynamic-diagram-style
'              |-- c4/deployment-diagram-style
'        |-- uml-base          (sibling: UML families)
'
'  RESPONSIBILITY
'      Bind the house tokens to C4-PlantUML's documented customisation
'      surface. C4-PlantUML reads its colour and size variables with
'      `?=` (default-if-unset) when a C4_* library file is included, so
'      every preset below MUST be assigned before the library include
'      and every skinparam that the library itself sets MUST be applied
'      after it. The leaf modules therefore set $C4_LEVEL and include
'      this file once; this file performs the library include in the
'      middle of its own body.
'
'  LIBRARY PROVENANCE
'      C4-PlantUML is consumed from the standard library bundled inside
'      the manifest-pinned PlantUML jar (`java -jar plantuml.jar -stdlib`
'      reports "c4 Version 2.13.0", delivered by
'      https://github.com/plantuml-stdlib/C4-PlantUML, MIT licence). The
'      version is recorded in tooling/manifests/plantuml.json and no
'      network URL is ever included, so renders are deterministic and
'      offline once the jar is provisioned.
'
'  WHAT THIS MODULE OWNS
'      - C4 colour presets derived from house tokens (levels darken with
'        abstraction: person navy > system steel > container deep tint >
'        component light tint; externals are neutral)
'      - C4 typography, wrap widths and legend colours
'      - house role tags for C4 elements/relations (<<ok>>, <<invalid>>...)
'      - title convention helper C4_TITLE
'
'  WHAT THIS MODULE DOES NOT OWN
'      - any UML skinparam (uml-base)
'      - the meaning of C4 abstractions: a C4 "container" is an
'        application or data store, a C4 "component" is a grouping of
'        functionality inside one container, and neither equals a UML
'        Component or a Docker container. Authors record any UML mapping
'        in the diagram header, never by mixing notations in one view.
'
'  NOTATION CHOICES (house conventions, not C4 requirements)
'      - C4 boxes keep C4-PlantUML's sharp corners so that a C4 view is
'        recognisably not a UML component/rectangle view (rounded 6).
'      - SHOW_LEGEND() is expected at the end of every published C4 view.
' ======================================================================

!ifndef C4_BASE_INCLUDED
!define C4_BASE_INCLUDED

!include house-tokens.iuml

' Leaf modules set this before including c4-base; Context is the safe floor.
!$C4_LEVEL ?= "Context"

' ----------------------------------------------------------------------
' 1. PRESETS  --  must precede the library include (`?=` semantics)
' ----------------------------------------------------------------------
!$ELEMENT_FONT_COLOR = "#FFFFFF"

!$PERSON_BG_COLOR = $line_primary
!$PERSON_BORDER_COLOR = $line_primary
!$EXTERNAL_PERSON_BG_COLOR = $line_neutral
!$EXTERNAL_PERSON_BORDER_COLOR = $line_neutral

!$SYSTEM_BG_COLOR = $line_secondary
!$SYSTEM_BORDER_COLOR = $line_primary
!$EXTERNAL_SYSTEM_BG_COLOR = $line_neutral
!$EXTERNAL_SYSTEM_BORDER_COLOR = $line_neutral

!$CONTAINER_FONT_COLOR = $theme_text
!$CONTAINER_BG_COLOR = $deep_primary
!$CONTAINER_BORDER_COLOR = $line_secondary
!$EXTERNAL_CONTAINER_FONT_COLOR = $theme_text
!$EXTERNAL_CONTAINER_BG_COLOR = $deep_neutral
!$EXTERNAL_CONTAINER_BORDER_COLOR = $line_neutral

!$COMPONENT_FONT_COLOR = $theme_text
!$COMPONENT_BG_COLOR = $fill_primary
!$COMPONENT_BORDER_COLOR = $line_secondary
!$EXTERNAL_COMPONENT_FONT_COLOR = $theme_text
!$EXTERNAL_COMPONENT_BG_COLOR = $fill_neutral
!$EXTERNAL_COMPONENT_BORDER_COLOR = $line_neutral

!$NODE_FONT_COLOR = $theme_text
!$NODE_BG_COLOR = $theme_surface_2
!$NODE_BORDER_COLOR = $theme_border

!$BOUNDARY_COLOR = $theme_muted
!$BOUNDARY_BG_COLOR = "transparent"

!$ARROW_COLOR = $theme_text
!$ARROW_FONT_COLOR = $theme_text

!$LEGEND_TITLE_COLOR = $theme_primary
!$LEGEND_FONT_COLOR = $theme_text
!$LEGEND_BG_COLOR = $theme_surface
!$LEGEND_BORDER_COLOR = $theme_border

!$STEREOTYPE_FONT_SIZE = $font_size_stereo
!$TECHN_FONT_SIZE = $font_size_small
!$ARROW_FONT_SIZE = $font_size_small
!$DEFAULT_WRAP_WIDTH = 220
!$MAX_MESSAGE_SIZE = 180

' ----------------------------------------------------------------------
' 2. LIBRARY  --  one level per leaf, always from the pinned jar's stdlib
' ----------------------------------------------------------------------
!if ($C4_LEVEL == "Container")
!include <C4/C4_Container>
!elseif ($C4_LEVEL == "Component")
!include <C4/C4_Component>
!elseif ($C4_LEVEL == "Dynamic")
!include <C4/C4_Dynamic>
!elseif ($C4_LEVEL == "Deployment")
!include <C4/C4_Deployment>
!else
!include <C4/C4_Context>
!endif

' ----------------------------------------------------------------------
' 3. POST-INCLUDE STYLING  --  what the library does not expose as a variable
' ----------------------------------------------------------------------
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName $font_family
skinparam defaultFontSize $font_size_body
skinparam defaultFontColor $theme_text
skinparam titleFontName $font_family
skinparam titleFontSize $font_size_title
skinparam titleFontColor $theme_primary
skinparam titleFontStyle bold
skinparam captionFontName $font_family
skinparam captionFontSize $font_size_caption
skinparam captionFontColor $theme_muted
skinparam captionFontStyle italic
skinparam NoteBackgroundColor $theme_surface
skinparam NoteBorderColor $theme_border
skinparam NoteFontColor $theme_text
skinparam NoteFontSize $font_size_small

' House role tags, registered with the C4 legend so SHOW_LEGEND() explains
' them. Use as `$tags="invalid"` on any element or relation.
AddElementTag("ok", $bgColor=$fill_ok, $fontColor=$theme_text, $borderColor=$line_ok, $legendText="valid / healthy")
AddElementTag("caution", $bgColor=$fill_caution, $fontColor=$theme_text, $borderColor=$line_caution, $legendText="attention / degraded")
AddElementTag("invalid", $bgColor=$fill_invalid, $fontColor=$theme_text, $borderColor=$line_invalid, $legendText="invalid / failure (intentional example)")
AddElementTag("alt", $bgColor=$fill_alt, $fontColor=$theme_text, $borderColor=$line_alt, $legendText="alternative / cross-cutting")
AddElementTag("proposed", $bgColor=$theme_surface, $fontColor=$theme_text, $borderColor=$line_secondary, $borderStyle=DashedLine(), $legendText="proposed (target state)")
AddRelTag("ok", $textColor=$line_ok, $lineColor=$line_ok, $legendText="valid / allowed")
AddRelTag("caution", $textColor=$line_caution, $lineColor=$line_caution, $lineStyle=DashedLine(), $legendText="attention")
AddRelTag("invalid", $textColor=$line_invalid, $lineColor=$line_invalid, $lineStyle=DashedLine(), $legendText="invalid / violation")
AddRelTag("proposed", $textColor=$line_secondary, $lineColor=$line_secondary, $lineStyle=DottedLine(), $legendText="proposed")

' ----------------------------------------------------------------------
' 4. HELPERS
' ----------------------------------------------------------------------
' C4 review checklist: the title states the diagram type and its scope.
'   C4_TITLE(Order Management System)
'   -> "[Container] Order Management System"
!unquoted procedure C4_TITLE($scope, $suffix="")
  !if ($suffix == "")
title [$C4_LEVEL] $scope
  !else
title [$C4_LEVEL] $scope\n<size:$font_size_small>$suffix</size>
  !endif
!endprocedure

!endif
' ======================================================================
'  END c4-base.iuml
' ======================================================================
