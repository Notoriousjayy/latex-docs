% =============================================================================
% cloudsuite.sty
% =============================================================================
% Role in the hierarchy: CONCRETE FAMILY MODULE.
% Generalizes from: base.sty (hierarchy root), which delegates presentation
% foundations to the canonical house style tooling/latex/style.sty.
%
% Functional class served:
%   The cloud-engineering document suite migrated from the repository-root
%   intake (seven numbered engineering deliverables plus the eighteen
%   chapter-keyed study companions). Those documents were authored against a
%   `styles/cloudsuite.sty` package that was never supplied with the intake;
%   this module is the semantic compatibility implementation of that API,
%   rebuilt on the shared house style so the suite inherits the canonical
%   geometry, typography, tables, hyperlinks and code rendering.
%
% Public API preserved from the source documents:
%   \DocShort                  short label shown in the running header
%                              (documents \renewcommand it after loading)
%   \coverpage{title}{subtitle}{tagline}
%                              renders the suite cover block + sets metadata
%   \sourceStatement           standing provenance statement box
%   \sourceRef{chapter}{page}  inline pointer to the primary source text
%   \refs                      closing source-mapping section
%   \field{label}              labeled fill-in line for template documents
%   takeaway (env)             key-takeaway callout
%   workbox  (env)             review/worksheet callout; accepts tcolorbox
%                              options, e.g. \begin{workbox}[title={Review gate}]
%   colors: navy, petrol, pale, gold (suite palette, lowercase legacy names)
%
% The suite's chapter/page pointers (\sourceRef) refer to the primary source
% text the documents were keyed against; this module intentionally renders
% them as neutral "Source: Ch. N, p. M" markers and does not invent a
% bibliographic entry that was not part of the intake.
% =============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cloudsuite}%
  [2026/10/12 v1.0 latex-docs cloud-engineering suite module]

\RequirePackage{base}
\LdsRegisterModule{cloudsuite}{Cloud Engineering Suite}

% --- extra packages the suite bodies rely on (not in the house style) -------
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,fit}
\RequirePackage{needspace}
\RequirePackage{ragged2e}
\RequirePackage{pdflscape}

% --- suite palette (lowercase legacy names used throughout the bodies) ------
\providecolor{navy}{HTML}{15334B}
\providecolor{petrol}{HTML}{1C6E91}
\providecolor{pale}{HTML}{EAF3F7}
\providecolor{gold}{HTML}{B98A2F}

% --- layout conventions carried by the original suite ------------------------
\geometry{letterpaper,margin=0.8in,headheight=16pt,footskip=30pt}
\setlength{\parindent}{0pt}
\renewcommand{\arraystretch}{1.22}

% --- metadata ----------------------------------------------------------------
\providecommand{\DocShort}{CLOUD SUITE}

% --- running header / footer -------------------------------------------------
\fancyhf{}
\fancyhead[L]{\footnotesize\sffamily\color{Steel}CLOUD COMPUTING ENGINEERING SUITE}
\fancyhead[R]{\footnotesize\sffamily\color{petrol}\DocShort}
\fancyfoot[L]{\footnotesize\color{Steel}Concepts \textbullet{} decisions \textbullet{} verification artifacts}
\fancyfoot[R]{\footnotesize\color{Steel}\thepage\ of \pageref*{LastPage}}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\footrulewidth}{0.35pt}

% --- cover page ---------------------------------------------------------------
% \coverpage{title}{subtitle}{tagline}
\newcommand{\coverpage}[3]{%
  \thispagestyle{empty}%
  \hypersetup{pdftitle={#1},pdfsubject={#2}}%
  \begin{center}
    \vspace*{0.9in}
    {\footnotesize\sffamily\color{petrol}\bfseries\DocShort}\\[4pt]
    {\color{gold}\rule{0.62\textwidth}{2pt}}\\[18pt]
    {\Huge\bfseries\color{navy}#1\par}
    \vspace{14pt}
    {\Large\color{Steel}#2\par}
    \vspace{10pt}
    {\normalsize\color{petrol}#3\par}
    \vspace{16pt}
    {\color{gold}\rule{0.62\textwidth}{2pt}}
  \end{center}
  \vspace{20pt}%
}

% --- provenance ----------------------------------------------------------------
\newcommand{\sourceStatement}{%
  \begin{tcolorbox}[colback=pale,colframe=petrol,boxrule=0.6pt,arc=1.5mm,
      left=3mm,right=3mm,top=2mm,bottom=2mm]
    \small\textbf{Source alignment.} This deliverable is keyed to the primary
    source text used by the cloud-engineering suite. Pointers rendered as
    \textit{Source: Ch.~N, p.~M} refer to that text's chapter and page
    numbering; they are navigation aids, not reproduced content.
  \end{tcolorbox}%
}

\newcommand{\sourceRef}[2]{%
  {\small\color{petrol}\textit{Source: Ch.~#1, p.~#2}}%
}

\newcommand{\refs}{%
  \par\vspace{10pt}
  \Needspace{6\baselineskip}
  {\large\bfseries\color{navy}Source mapping}\par
  {\color{gold}\rule{\linewidth}{1pt}}\par\vspace{4pt}
  \small All \textit{Source: Ch.~N, p.~M} pointers in this document refer to
  the suite's primary source text. Chapter-keyed companions in this folder
  follow the same numbering, so pointers can be traced across documents.\par
}

% --- callouts -------------------------------------------------------------------
\newtcolorbox{takeaway}[1][]{%
  enhanced,breakable,colback=pale,colframe=petrol,boxrule=0.8pt,arc=2mm,
  left=3mm,right=3mm,top=2mm,bottom=2mm,
  title={Key takeaway},fonttitle=\bfseries,coltitle=white,#1}

\newtcolorbox{workbox}[1][]{%
  enhanced,breakable,colback=white,colframe=gold,boxrule=0.8pt,arc=2mm,
  left=3mm,right=3mm,top=2mm,bottom=2mm,
  title={Worksheet},fonttitle=\bfseries,coltitle=white,#1}

% --- template fill-in line -------------------------------------------------------
\newcommand{\field}[1]{%
  \par\Needspace{3\baselineskip}%
  {\small\bfseries\color{navy}#1}\\[2pt]%
  {\color{petrol!55}\hrulefill}\par\vspace{7pt}%
}
