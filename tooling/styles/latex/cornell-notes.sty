% =============================================================================
% cornell-notes.sty
% =============================================================================
% Role in the hierarchy: CONCRETE FAMILY MODULE.
% Generalizes from: base.sty.
%
% Functional class served:
%   Cornell-style study-note documents across any subject domain.
%
% Public API (namespaced):
%   Metadata setters:
%     \setCornellCollection{...}
%     \setCornellUnitType{...}
%     \setCornellUnitNumber{...}
%     \setCornellUnitTitle{...}
%     \setCornellSourceTitle{...}
%     \setCornellSourceLabel{...}
%     \setCornellSourceAuthor{...}
%     \setCornellSourceEdition{...}
%     \setCornellSourceRange{...}
%     \setCornellCompanionLabel{...}
%
%   Front matter:
%     \CornellMakeTitle
%     % example: \CornellMakeTitle
%
%   Cornell table:
%     \begin{CornellNotesTable} ... \end{CornellNotesTable}
%     \CornellNoteRow{Cue}{Detailed notes}
%     % example:
%     % \begin{CornellNotesTable}
%     % \CornellNoteRow{Prompt}{Expanded notes}
%     % \end{CornellNotesTable}
%
%   Source annotation:
%     \CornellSourceNote{pp. 10--18}
%     % example: \CornellSourceNote{pp. 10--18}
%
%   Callouts:
%     \begin{CornellSummaryBox}{Review Objectives} ... \end{CornellSummaryBox}
%     \begin{CornellExamBox}{Key Distinction} ... \end{CornellExamBox}
%
%   Optional study helpers:
%     \begin{CornellChecklist} ... \end{CornellChecklist}
%     \begin{CornellRecallList} ... \end{CornellRecallList}
%
% Compatibility aliases (guarded):
%   cornell, noterow, source, summarybox, exambox, makecornelltitle
% =============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cornell-notes}%
  [2026/08/13 v1.0 latex-docs cornell notes family module]

\RequirePackage{base}
\LdsRegisterModule{cornell-notes}{Study / Cornell Notes}

% -----------------------------------------------------------------------------
% 1. Cornell metadata
% -----------------------------------------------------------------------------
\providecommand{\CornellCollection}{}
\providecommand{\CornellUnitType}{}
\providecommand{\CornellUnitNumber}{}
\providecommand{\CornellUnitTitle}{}
\providecommand{\CornellSourceTitle}{}
\providecommand{\CornellSourceLabel}{Source}
\providecommand{\CornellSourceAuthor}{}
\providecommand{\CornellSourceEdition}{}
\providecommand{\CornellSourceRange}{}
\providecommand{\CornellCompanionLabel}{Study companion}

\newcommand{\setCornellCollection}[1]{\def\CornellCollection{#1}}
\newcommand{\setCornellUnitType}[1]{\def\CornellUnitType{#1}}
\newcommand{\setCornellUnitNumber}[1]{\def\CornellUnitNumber{#1}}
\newcommand{\setCornellUnitTitle}[1]{\def\CornellUnitTitle{#1}}
\newcommand{\setCornellSourceTitle}[1]{\def\CornellSourceTitle{#1}}
\newcommand{\setCornellSourceLabel}[1]{\def\CornellSourceLabel{#1}}
\newcommand{\setCornellSourceAuthor}[1]{\def\CornellSourceAuthor{#1}}
\newcommand{\setCornellSourceEdition}[1]{\def\CornellSourceEdition{#1}}
\newcommand{\setCornellSourceRange}[1]{\def\CornellSourceRange{#1}}
\newcommand{\setCornellCompanionLabel}[1]{\def\CornellCompanionLabel{#1}}

\newcommand{\CornellIfNonEmpty}[2]{\ifstrempty{#1}{}{#2}}

\newcommand{\CornellUnitLabel}{%
  \ifstrempty{\CornellUnitType}{%
    \CornellUnitTitle
  }{%
    \ifstrempty{\CornellUnitNumber}{%
      \ifstrempty{\CornellUnitTitle}{%
        \CornellUnitType
      }{%
        \CornellUnitType\space\textemdash\space\CornellUnitTitle
      }%
    }{%
      \ifstrempty{\CornellUnitTitle}{%
        \CornellUnitType\space\CornellUnitNumber
      }{%
        \CornellUnitType\space\CornellUnitNumber:\space\CornellUnitTitle
      }%
    }%
  }%
}

\newcommand{\CornellRunningHeaderLeft}{%
  \ifstrempty{\CornellCollection}{\DocTitle}{\CornellCollection}
}

\AtBeginDocument{%
  \ifstrempty{\DocTitle}{%
    \ifstrempty{\CornellCollection}{}{\setDocTitle{\CornellCollection}}%
  }{%
    \ifstrempty{\CornellCollection}{\setCornellCollection{\DocTitle}}{}%
  }%

  \ifstrempty{\DocSubtitle}{%
    \ifstrempty{\CornellUnitLabel}{}{\setDocSubtitle{\CornellUnitLabel}}%
  }{}%

  \fancyhead[L]{\small\color{Steel}\CornellRunningHeaderLeft}%
}

% -----------------------------------------------------------------------------
% 2. Cornell-specific visual tokens
% -----------------------------------------------------------------------------
\colorlet{CornellCueBackground}{Teal!10}
\colorlet{CornellRowBackground}{Soft}
\colorlet{CornellRuleColor}{CardFrame}
\providecolor{CornellExamAccent}{HTML}{C9922E}

\renewcommand{\LdsExtraHeader}{%
  \ifstrempty{\CornellUnitLabel}{}{\quad\textbar\quad\CornellUnitLabel}%
  \ifstrempty{\DocClass}{}{\quad\textbar\quad\DocClass}%
}

% -----------------------------------------------------------------------------
% 3. Cornell table and row API
% -----------------------------------------------------------------------------
\newenvironment{CornellNotesTable}{%
  \begingroup
  \arrayrulecolor{CornellRuleColor}%
  \rowcolors{2}{white}{CornellRowBackground}%
  \begin{longtable}{@{}>{\raggedright\arraybackslash\columncolor{CornellCueBackground}\color{Navy}\bfseries}p{0.29\linewidth}>{\raggedright\arraybackslash}p{0.67\linewidth}@{}}
  \rowcolor{Navy}\color{white}\textbf{Cue / Active Recall} & \color{white}\textbf{Detailed Notes}\\ \hline
  \endfirsthead
  \rowcolor{Navy}\color{white}\textbf{Cue / Active Recall (cont.)} & \color{white}\textbf{Detailed Notes}\\ \hline
  \endhead
}{%
  \end{longtable}
  \endgroup
}

\newcommand{\CornellNoteRow}[2]{#1 & #2\\\arrayrulecolor{CornellRuleColor}\hline}

\newcommand{\CornellSourceNote}[1]{%
  \par{\footnotesize\color{Teal}\textit{Source: \CornellSourceLabel, #1}}\par
}

% -----------------------------------------------------------------------------
% 4. Cornell callouts and optional study helpers
% -----------------------------------------------------------------------------
\newtcolorbox{CornellSummaryBox}[1]{%
  breakable,colback=CornellCueBackground,colframe=Teal,boxrule=0.7pt,arc=2mm,
  title=\textbf{#1},fonttitle=\color{white},colbacktitle=Teal}

\newtcolorbox{CornellExamBox}[1]{%
  breakable,colback=white,colframe=CornellExamAccent,boxrule=0.7pt,arc=2mm,
  title=\textbf{#1},fonttitle=\color{white},colbacktitle=CornellExamAccent}

\newenvironment{CornellChecklist}{%
  \begin{itemize}[label=\(\square\),leftmargin=1.4em,itemsep=1pt,topsep=2pt]
}{%
  \end{itemize}
}

\newenvironment{CornellRecallList}{%
  \begin{enumerate}[leftmargin=1.5em,itemsep=1pt,topsep=2pt]
}{%
  \end{enumerate}
}

% -----------------------------------------------------------------------------
% 5. Cornell title page
% -----------------------------------------------------------------------------
\newcommand{\CornellMakeTitle}{%
  \hypersetup{pageanchor=false}%
  \begin{titlepage}
    \pagecolor{Navy}\color{white}
    \vspace*{1.0in}

    \CornellIfNonEmpty{\CornellSourceTitle}{{\Large \CornellSourceTitle\par}}
    \vspace{0.25in}
    \CornellIfNonEmpty{\CornellSourceEdition}{{\large \CornellSourceEdition\par}}

    \vfill
    {\Huge\bfseries Cornell Notes\par}
    \vspace{0.25in}
    \CornellIfNonEmpty{\CornellUnitType}{{\LARGE \CornellUnitType\space\CornellUnitNumber\par}}
    \vspace{0.08in}
    \CornellIfNonEmpty{\CornellUnitTitle}{{\LARGE\bfseries \CornellUnitTitle\par}}
    \vfill

    \CornellIfNonEmpty{\CornellSourceAuthor}{{\large \CornellSourceAuthor\par}}
    \vspace{0.12in}
    \CornellIfNonEmpty{\CornellCompanionLabel}{{\normalsize \CornellCompanionLabel\par}}
    \vspace{0.35in}

    {\small Primary source: \textit{\CornellSourceTitle}%
    \CornellIfNonEmpty{\CornellSourceEdition}{, \CornellSourceEdition}%
    \CornellIfNonEmpty{\CornellSourceRange}{, \CornellSourceRange}%
    .\par}
  \end{titlepage}
  \hypersetup{pageanchor=true}%
  \nopagecolor\color{black}
}

% -----------------------------------------------------------------------------
% 6. Guarded legacy aliases
% -----------------------------------------------------------------------------
\makeatletter
\@ifundefined{makecornelltitle}{\newcommand{\makecornelltitle}{\CornellMakeTitle}}{}
\@ifundefined{cornell}{\newenvironment{cornell}{\begin{CornellNotesTable}}{\end{CornellNotesTable}}}{}
\@ifundefined{noterow}{\newcommand{\noterow}[2]{\CornellNoteRow{#1}{#2}}}{}
\@ifundefined{source}{\newcommand{\source}[1]{\CornellSourceNote{#1}}}{}
\@ifundefined{summarybox}{\newenvironment{summarybox}[1]{\begin{CornellSummaryBox}{#1}}{\end{CornellSummaryBox}}}{}
\@ifundefined{exambox}{\newenvironment{exambox}[1]{\begin{CornellExamBox}{#1}}{\end{CornellExamBox}}}{}
\makeatother

\endinput