% soc2style.sty
% Suite style package for the SOC 2 Trust Services Criteria engineering suite.
%
% RECONSTRUCTION PROVENANCE: the eight uploaded suite documents load
% `\usepackage{soc2style}`, but no `soc2style.sty` was present in the upload
% batches or anywhere in this repository's history. This package is a
% documented, suite-specific reconstruction of the interface the documents
% actually use:
%   \doctitle{<title>}{<subtitle>}{<document id>}  front-matter renderer
%   aicpabox        criterion-quotation callout
%   engineeringbox  engineering-interpretation callout
%   \sourcepage{N}  page-trace marker into the 2017 TSC (2022 revision) PDF
%   \Needspace, landscape, longtable, lstlisting[language={},caption=...]
% It is NOT the recovered original style; the original visual design is
% unknown.
%
% pdfLaTeX only.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{soc2style}[2026/10/18 Reconstructed SOC 2 suite style (original not recovered)]
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage[letterpaper,margin=0.88in,headheight=15pt]{geometry}
\RequirePackage[table]{xcolor}
\definecolor{socnavy}{HTML}{16324F}
\definecolor{socteal}{HTML}{0B6E74}
\definecolor{socgray}{HTML}{5A6672}
\definecolor{socpale}{HTML}{F0F5F7}
\definecolor{socsand}{HTML}{FAF4E8}
\RequirePackage{amsmath,amssymb}
\RequirePackage{array,booktabs,longtable,tabularx,multirow}
\RequirePackage{enumitem}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{needspace}
\RequirePackage{pdflscape}
\RequirePackage{graphicx}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{titlesec}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=socnavy,urlcolor=socteal,citecolor=socnavy,pdfauthor={SOC 2 Compliance Engineering Suite},pdfsubject={Original supporting guidance for the AICPA 2017 Trust Services Criteria}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt}
\setlength{\emergencystretch}{2em}
\renewcommand{\arraystretch}{1.18}
\setlist[itemize]{itemsep=2pt,topsep=3pt,leftmargin=1.5em}
\setlist[enumerate]{itemsep=2pt,topsep=3pt,leftmargin=1.7em}
\titleformat{\chapter}[display]{\sffamily\bfseries\color{socnavy}}{\large\color{socteal}\MakeUppercase{\chaptertitlename}~\thechapter}{6pt}{\huge}[\vspace{4pt}\color{socteal}\titlerule]
\titlespacing*{\chapter}{0pt}{-10pt}{18pt}
\titleformat{\section}{\Large\bfseries\color{socnavy}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\large\bfseries\color{socteal}}{\thesubsection}{0.6em}{}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\footnotesize SOC 2 | Trust Services Criteria Engineering}
\fancyhead[R]{\sffamily\footnotesize\color{socgray} Independent companion}
\fancyfoot[L]{\sffamily\scriptsize Original explanatory material; not an AICPA publication or audit opinion}
\fancyfoot[R]{\sffamily\scriptsize\thepage\ / \pageref{LastPage}}
\renewcommand{\headrulewidth}{0.3pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[R]{\sffamily\scriptsize\thepage}\renewcommand{\headrulewidth}{0pt}}
\lstdefinestyle{soc2code}{basicstyle=\ttfamily\footnotesize,breaklines=true,columns=fullflexible,keepspaces=true,showstringspaces=false,frame=single,rulecolor=\color{socteal},backgroundcolor=\color{socpale},aboveskip=8pt,belowskip=8pt,captionpos=b}
\lstset{style=soc2code}
% Criterion-quotation callout: holds the AICPA criterion statement.
\newtcolorbox{aicpabox}[1][]{enhanced,breakable,colback=socpale,colframe=socnavy,boxrule=0.5pt,arc=1.5mm,title={AICPA criterion},fonttitle=\bfseries\small,#1}
% Engineering-interpretation callout: original implementation guidance.
\newtcolorbox{engineeringbox}[1][]{enhanced,breakable,colback=socsand,colframe=socteal,boxrule=0.5pt,arc=1.5mm,title={Engineering interpretation},fonttitle=\bfseries\small,#1}
% Page-trace marker into the source criteria document.
\newcommand{\sourcepage}[1]{{\footnotesize\color{socgray}\textit{(TSC printed page #1)}}}
% Front-matter renderer: \doctitle{title}{subtitle}{document id}.
\newcommand{\doctitle}[3]{%
  \thispagestyle{plain}%
  {\color{socteal}\rule{\textwidth}{3pt}}\par\vspace{16pt}
  {\sffamily\small\color{socgray}\bfseries #3\par}\vspace{10pt}
  {\Huge\bfseries\color{socnavy} #1\par}\vspace{12pt}
  {\Large\color{socgray} #2\par}\vspace{14pt}
  {\small Independent educational and engineering implementation reference for the AICPA 2017 Trust Services Criteria (2022 points-of-focus revision). Not an AICPA publication, audit methodology, or attestation opinion.\par}
  \vspace{10pt}{\color{socteal}\rule{\textwidth}{1pt}}\par\vspace{8pt}
  {\setcounter{tocdepth}{1}\tableofcontents}\clearpage}
