' ======================================================================
'  profile-diagram-style.iuml
'  Diagram-specific specialization for UML PROFILE diagrams.
' ----------------------------------------------------------------------
'  PARENT: uml-structural
'
'  Profile diagrams define UML profile extensions: stereotypes,
'  tagged values, and constraints that extend the metamodel. Their
'  distinguishing visual is the "extension" arrow (filled triangle,
'  dashed line) from a stereotype to a metaclass.
' ======================================================================

!ifndef PROFILE_DIAGRAM_STYLE_INCLUDED
!define PROFILE_DIAGRAM_STYLE_INCLUDED

!include ../../../plantuml/uml-structural.iuml

' Profile diagrams visually distinguish stereotypes from regular
' classes. We highlight the "stereotype" border in the accent colour
' so reviewers can scan the diagram and find extensions quickly.
skinparam class {
  BorderColor<<stereotype>> $theme_accent
  BackgroundColor<<stereotype>> $theme_surface
}

skinparam class {
  BorderColor<<metaclass>> $theme_secondary
  BackgroundColor<<metaclass>> $theme_surface_2
}

' Extension (UML 2.5.1, 12.3.4 / Figure 12.18): a SOLID line from the
' Stereotype to the extended metaclass ending in a FILLED triangle. It is
' neither a Generalization nor an InterfaceRealization, so the former
' dashed `..|>` + "extends" rendering was wrong on both counts.
' LIMITATION: PlantUML class diagrams have no filled-triangle arrowhead,
' so the closest supported notation is the solid-line triangle (`--|>`)
' labelled <<extension>>. The label is what distinguishes it from a
' generalization in the rendered picture; state this in the legend.
!unquoted procedure PROF_EXTENSION($stereo, $metaclass, $required="")
  !if ($required == "required")
$stereo --|> $metaclass : <<extension>>\n{required}
  !else
$stereo --|> $metaclass : <<extension>>
  !endif
!endprocedure

' A profile-level Generalization between stereotypes keeps UML notation.
!unquoted procedure PROF_GENERALIZATION($child, $parent)
$child --|> $parent
!endprocedure

!endif



