' ======================================================================
'  component-diagram-style.iuml
'  Diagram-specific specialization for UML COMPONENT diagrams.
' ----------------------------------------------------------------------
'  PARENT: uml-structural
'
'  Component diagrams emphasise provided/required interfaces (the
'  "lollipop" + "socket" notation) and assembly connectors. Most
'  visual rules already come from uml-structural; we only set the
'  component-style hint and provide assembly macros.
' ======================================================================

!ifndef COMPONENT_DIAGRAM_STYLE_INCLUDED
!define COMPONENT_DIAGRAM_STYLE_INCLUDED

!include ../../../plantuml/uml-structural.iuml

' Use rectangular components with the embedded component icon
' (UML 2.x convention; preferred over the legacy box-with-tabs).
skinparam componentStyle rectangle

' Provided interface (UML 2.5.1, 11.6.2): lollipop attached to the
' component. PlantUML's `-()` creates the ball on the interface side
' when the interface has been declared with `interface`/`()`.
'   interface IOrders
'   COMP_PROVIDES(OrderService, IOrders)
!unquoted procedure COMP_PROVIDES($comp, $iface)
$comp -() $iface
!endprocedure

' Required interface: socket (half circle) on the component side.
!unquoted procedure COMP_REQUIRES($comp, $iface)
$comp -( $iface
!endprocedure

' Assembly connector (UML 11.6.2, Figure 11.44): the consumer's required
' socket plugs into the provider's provided ball, drawn ball-and-socket
' on one line. PlantUML reads `-(0-` as socket at the LEFT end and ball
' at the RIGHT end, so the consumer must be the left operand. Verified on
' 1.2026.7: `X -(0- Y : IFoo` renders X)(o)Y with the label on the joint.
!unquoted procedure COMP_ASSEMBLY($provider, $iface, $consumer)
$consumer -(0- $provider : $iface
!endprocedure

' Delegation connector (11.6.2): from a port/interface on the boundary to
' an internal part, drawn as a dependency-style dashed arrow.
!unquoted procedure COMP_DELEGATE($from, $to)
$from ..> $to : <<delegate>>
!endprocedure

!endif



