' ======================================================================
'  component-diagram-style.iuml
'  Leaf style for a C4 Component diagram.
' ----------------------------------------------------------------------
'  HIERARCHY POSITION
'      house-tokens -> c4-base -> component-diagram-style   <-- THIS FILE
'
'  Scope: one container. Shows the major groupings of functionality
'  (C4 components) inside it. Keep the enclosing Container_Boundary so
'  the scope stays visible; a C4 component is not independently
'  deployable and is not a UML Component.
'
'  VOCABULARY (C4-PlantUML, see https://github.com/plantuml-stdlib/C4-PlantUML)
'  Component, ComponentDb, ComponentQueue, Component_Ext,
'  Container_Boundary plus everything from the container level
'
'  HOUSE EXPECTATIONS
'      - start with C4_TITLE(<scope>) so type and scope are in the title
'      - label every relationship with a verb phrase; add the protocol as
'        $techn where it is known, and say "unknown" rather than invent it
'      - end with SHOW_LEGEND()
'      - reuse element aliases across the views of one system so
'        correspondences can be checked
' ======================================================================

!ifndef C4_COMPONENT_DIAGRAM_STYLE_INCLUDED
!define C4_COMPONENT_DIAGRAM_STYLE_INCLUDED

!$C4_LEVEL = "Component"
!include ../../../plantuml/c4-base.iuml

!endif
