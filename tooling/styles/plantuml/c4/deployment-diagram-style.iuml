' ======================================================================
'  deployment-diagram-style.iuml
'  Leaf style for a C4 Deployment diagram.
' ----------------------------------------------------------------------
'  HIERARCHY POSITION
'      house-tokens -> c4-base -> deployment-diagram-style   <-- THIS FILE
'
'  Scope: how container INSTANCES run in one particular environment.
'  Deployment_Node models infrastructure (regions, hosts, runtimes);
'  place Container(...) inside nodes for the instances. Use the UML
'  deployment leaf instead when artifact/node semantics are the point.
'
'  VOCABULARY (C4-PlantUML, see https://github.com/plantuml-stdlib/C4-PlantUML)
'  Deployment_Node, Deployment_Node_L/R, Node, Container(...) inside
'  nodes, Rel, plus everything from the container level
'
'  HOUSE EXPECTATIONS
'      - start with C4_TITLE(<scope>) so type and scope are in the title
'      - label every relationship with a verb phrase; add the protocol as
'        $techn where it is known, and say "unknown" rather than invent it
'      - end with SHOW_LEGEND()
'      - reuse element aliases across the views of one system so
'        correspondences can be checked
' ======================================================================

!ifndef C4_DEPLOYMENT_DIAGRAM_STYLE_INCLUDED
!define C4_DEPLOYMENT_DIAGRAM_STYLE_INCLUDED

!$C4_LEVEL = "Deployment"
!include ../../../plantuml/c4-base.iuml

!endif
