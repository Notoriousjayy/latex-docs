' ======================================================================
'  dynamic-diagram-style.iuml
'  Leaf style for a C4 Dynamic diagram.
' ----------------------------------------------------------------------
'  HIERARCHY POSITION
'      house-tokens -> c4-base -> dynamic-diagram-style   <-- THIS FILE
'
'  Scope: one scenario traversing elements of the static model at a
'  stated abstraction (context, container or component). Number the
'  interactions with Rel(..., $index=Index()) or RelIndex so the order
'  is explicit; say in the title which scenario and which level.
'
'  VOCABULARY (C4-PlantUML, see https://github.com/plantuml-stdlib/C4-PlantUML)
'  Rel with $index, RelIndex, Index(), LastIndex(), SetIndex() plus
'  the element procedures of every lower level
'
'  HOUSE EXPECTATIONS
'      - start with C4_TITLE(<scope>) so type and scope are in the title
'      - label every relationship with a verb phrase; add the protocol as
'        $techn where it is known, and say "unknown" rather than invent it
'      - end with SHOW_LEGEND()
'      - reuse element aliases across the views of one system so
'        correspondences can be checked
' ======================================================================

!ifndef C4_DYNAMIC_DIAGRAM_STYLE_INCLUDED
!define C4_DYNAMIC_DIAGRAM_STYLE_INCLUDED

!$C4_LEVEL = "Dynamic"
!include ../../../plantuml/c4-base.iuml

!endif
