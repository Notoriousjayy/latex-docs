' ======================================================================
'  container-diagram-style.iuml
'  Leaf style for a C4 Container diagram.
' ----------------------------------------------------------------------
'  HIERARCHY POSITION
'      house-tokens -> c4-base -> container-diagram-style   <-- THIS FILE
'
'  Scope: one software system. Shows the applications and data stores
'  (C4 containers) that make it up, their responsibilities and
'  technologies, and how they communicate. A C4 container is not a
'  Docker container, a host, a source directory or a UML package.
'
'  VOCABULARY (C4-PlantUML, see https://github.com/plantuml-stdlib/C4-PlantUML)
'  Container, ContainerDb, ContainerQueue, Container_Ext,
'  Container_Boundary plus everything from the context level
'
'  HOUSE EXPECTATIONS
'      - start with C4_TITLE(<scope>) so type and scope are in the title
'      - label every relationship with a verb phrase; add the protocol as
'        $techn where it is known, and say "unknown" rather than invent it
'      - end with SHOW_LEGEND()
'      - reuse element aliases across the views of one system so
'        correspondences can be checked
' ======================================================================

!ifndef C4_CONTAINER_DIAGRAM_STYLE_INCLUDED
!define C4_CONTAINER_DIAGRAM_STYLE_INCLUDED

!$C4_LEVEL = "Container"
!include ../../../plantuml/c4-base.iuml

!endif
