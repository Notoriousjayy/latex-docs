' ======================================================================
'  context-diagram-style.iuml
'  Leaf style for a C4 System Context / System Landscape diagram.
' ----------------------------------------------------------------------
'  HIERARCHY POSITION
'      house-tokens -> c4-base -> context-diagram-style   <-- THIS FILE
'
'  Scope: one software system (context) or several related systems
'  (landscape) together with the people and neighbouring systems they
'  interact with. Keep the internal design of the system in scope OUT
'  of the picture: containers belong in the container view.
'
'  VOCABULARY (C4-PlantUML, see https://github.com/plantuml-stdlib/C4-PlantUML)
'  Person, Person_Ext, System, SystemDb, SystemQueue, System_Ext,
'  System_Boundary, Enterprise_Boundary, Rel, BiRel, Rel_D/U/L/R
'
'  HOUSE EXPECTATIONS
'      - start with C4_TITLE(<scope>) so type and scope are in the title
'      - label every relationship with a verb phrase; add the protocol as
'        $techn where it is known, and say "unknown" rather than invent it
'      - end with SHOW_LEGEND()
'      - reuse element aliases across the views of one system so
'        correspondences can be checked
' ======================================================================

!ifndef C4_CONTEXT_DIAGRAM_STYLE_INCLUDED
!define C4_CONTEXT_DIAGRAM_STYLE_INCLUDED

!$C4_LEVEL = "Context"
!include ../../../plantuml/c4-base.iuml

!endif
