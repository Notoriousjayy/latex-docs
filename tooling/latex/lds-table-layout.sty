\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lds-table-layout}[2026/11/24 Paragraph alignment for prose table cells]
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{etoolbox}
\RequirePackage{ragged2e}
% Paragraph cells have narrow measures. Use natural word spacing, permit
% hyphenation, and let the right margin remain ragged. This changes the
% typeset layout, not the TeX warning thresholds. Explicit column declarations
% (centering, raggedleft, justifying, etc.) still run after the default.
\newcommand{\lds@tableparagraph}{%
  \setlength{\RaggedRightRightskip}{0pt plus 1fil}%
  \RaggedRight\arraybackslash
}
\patchcmd{\@startpbox}{\@arrayparboxrestore}{\@arrayparboxrestore\lds@tableparagraph}{}{%
  \PackageError{lds-table-layout}{Unsupported array paragraph-cell implementation}{Review the array package update.}}
\patchcmd{\LT@startpbox}{\@arrayparboxrestore}{\@arrayparboxrestore\lds@tableparagraph}{}{%
  \PackageError{lds-table-layout}{Unsupported longtable paragraph-cell implementation}{Review the longtable package update.}}
\endinput
