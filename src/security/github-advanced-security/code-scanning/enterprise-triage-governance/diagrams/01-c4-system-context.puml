@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F4E79
skinparam rectangleBorderColor #1F4E79
title c4 system context (proposed; not deployed)
actor Developer as dev
actor "AppSec reviewer" as sec
rectangle "GitHub repositories and scanning" as gh
rectangle "Architecture Discovery [READ ONLY]" as discover
rectangle "AppSec policy advisor [READ ONLY]" as advisor
rectangle "Privileged review service [NOT DEPLOYED]" as executor
dev --> gh : open pull request
gh --> advisor : observed alerts, checks, rulesets
discover --> advisor : E1/E2/E3 context
advisor --> sec : recommended disposition + evidence
sec --> executor : authorized request
executor --> gh : review dismissal (future; separate authority)
@enduml
