@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
title threat boundaries (proposed; not deployed)
package "Untrusted zone" {
 rectangle "Fork PRs and issue text" as PR
 rectangle "Code scanning inputs" as SC
}
package "Read-only assessment zone" {
 rectangle "Discovery collector" as D
 rectangle "Policy evaluator" as P
}
package "Protected governance zone" {
 rectangle "Reviewed policy bundle" as POL
 rectangle "Approved exception registry" as EX
 rectangle "Audit evidence" as AUD
}
package "Privileged zone (not enabled)" {
 rectangle "GitHub App executor" as EXEC
}
PR --> D : untrusted metadata
SC --> P : normalized findings
D --> P : context
POL --> P : pinned policy
EX --> P : signed approval scope
P --> AUD : advisory + hash
P ..> EXEC : no direct execution
note bottom of EXEC : future role and execution gate
@enduml
