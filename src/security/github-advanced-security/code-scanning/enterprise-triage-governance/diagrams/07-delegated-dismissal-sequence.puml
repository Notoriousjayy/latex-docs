@startuml
!include ../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title delegated dismissal sequence (proposed; not deployed)
actor Requester
participant "GitHub dismissal requests" as GH
participant "Read-only evaluator" as E
actor "Independent AppSec reviewer" as R
participant "Privileged executor (future)" as P
Requester -> GH : submit dismissal request
E -> GH : GET request + current alert
GH --> E : request, alert and permissions
E -> R : suggested decision + evidence
R -> P : explicit approved decision
P -> GH : re-read state + verify identity/head/policy
alt authorized and unchanged
 P -> GH : PATCH delegated review
 GH --> P : response
else invalid, stale or unauthorized
 P -> R : abort and escalate
end
P -> R : reconcile audit evidence
@enduml
