@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
title policy evaluation (proposed; not deployed)
start
:Validate policy version and input schema;
if (valid?) then (yes)
 if (required scan complete?) then (yes)
  if (actionable blocking finding?) then (yes)
   if (independent approved exact scope?) then (yes)
    :EXCEPTION_CANDIDATE (no mutation);
   else (no)
    :FIX_REQUIRED or APPSEC_REVIEW_REQUIRED;
   endif
  else (no)
   :ALLOW_MERGE advisory; GitHub is authority;
  endif
 else (no)
  :SCAN_INCOMPLETE;
 endif
else (no)
 :POLICY_ERROR;
endif
stop
@enduml
