@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
title discovery integration (proposed; not deployed)
rectangle "GitHub org/repo APIs" as gh
rectangle "Architecture discovery collector (E1)" as e1
rectangle "Graph inference (E2)" as e2
rectangle "Independent attestation (E3)" as e3
rectangle "Context envelope" as env
rectangle "Read-only policy evaluation" as p
gh --> e1 : observed config
e1 --> e2 : graph input
e3 --> env : verified ownership/deployment
e1 --> env : paths + SHAs + time
e2 --> env : inference + uncertainty
env --> p : no authorization privileges
@enduml
