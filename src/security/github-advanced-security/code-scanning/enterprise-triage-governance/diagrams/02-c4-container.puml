@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F4E79
skinparam rectangleBorderColor #1F4E79
title c4 container (proposed; not deployed)
package "Read-only boundary" {
 rectangle "Discovery metadata adapter" as d
 rectangle "Code scanning adapter" as a
 rectangle "Merge blocker classifier" as m
 rectangle "Policy evaluator" as p
 rectangle "Exception scope matcher" as e
}
package "Reviewer and evidence boundary" {
 rectangle "Audit record generator" as audit
 actor "AppSec" as sec
}
package "Privileged boundary - future" {
 rectangle "Approved GitHub App executor" as ex
}
d --> p : observed metadata
a --> m : alerts and analyses
m --> p : blockers
e --> p : approved scopes
p --> audit : deterministic decision
audit --> sec : evidence and recommendation
sec --> ex : independent approval
ex --> a : approved mutation only
@enduml
