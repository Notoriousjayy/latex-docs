@startuml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F4E79
skinparam rectangleBorderColor #1F4E79
title c4 component (proposed; not deployed)
rectangle "Normalizer" as n
rectangle "Evidence schema validator" as v
rectangle "Coverage checker" as c
rectangle "Policy rules" as p
rectangle "Exception comparator" as x
rectangle "Decision provenance" as h
rectangle "Audit sink" as a
n --> v : typed alert
v --> c : validity
c --> p : scan completeness
p --> x : scoped candidate
x --> h : evidence decision
h --> a : signed digest + reason
note right of p : missing/invalid inputs abstain
@enduml
