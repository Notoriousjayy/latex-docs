@startuml
title IDOR (Horizontal Escalation): Vulnerable Path vs Secure Fix

!include ../../../../../../../tooling/styles/plantuml/behavioral/activity-diagram-style.iuml

partition "Vulnerable (Anti-Pattern)" <<invalid>> {
  start
  :Client sends resource-id\n(e.g., /orders/10002);
  :Server loads resource by id;
  :No ownership check;
  :Return sensitive data;
  stop
}

partition "Secure (Positive Pattern)" <<ok>> {
  start
  :Client sends resource-id;
  :Server identifies current user;
  :Load resource by id;
  if (owner == current user\nOR policy grants?) then (allow)
    :Return data;
  else (deny)
    :Return 403;
  endif
  stop
}

legend right
  |<$fill_invalid>   | intentionally vulnerable path (do not implement) |
  |<$fill_ok>   | secure pattern |
endlegend
caption Key message: ownership/policy check must be server-side.
@enduml
