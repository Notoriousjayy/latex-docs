' View of proposed AppSec Agent Harness; see study for scope and correspondence.
@startuml appsec-components
!include ../../../../../tooling/styles/plantuml/c4/component-diagram-style.iuml

C4_TITLE(AppSec Orchestrator, V3 component view)
Container_Ext(broker, "Execution broker", "Python service", "Enforces policy")
ContainerDb_Ext(state, "Run store", "PostgreSQL", "Durable state")
System_Ext(model, "Model provider", "Inference only")
Container_Boundary(orch, "Orchestrator") {
 Component(coordinator, "Run coordinator", "Python", "State machine and budget")
 Component(context, "Context builder", "Python", "Selects sanitized evidence")
 Component(adapter, "Model adapter", "Python", "Calls approved model")
 Component(validator, "Proposal validator", "Python", "Validates strict contract")
 Component(port, "Broker port", "Python", "Submits typed action")
 Component(report, "Report composer", "Python", "Builds evidence-linked recommendation")
}
Rel(coordinator, context, "Requests bounded context")
Rel(context, port, "Requests scoped evidence")
Rel(coordinator, adapter, "Requests proposal")
Rel(adapter, model, "Calls inference", "HTTPS")
Rel(coordinator, validator, "Validates model proposal")
Rel(coordinator, port, "Submits validated action")
Rel(port, broker, "Calls authorized interface", "HTTPS")
Rel(coordinator, state, "Persists checkpoints", "SQL")
Rel(coordinator, report, "Requests evidence-linked output")
SHOW_LEGEND()
@enduml
