' View of proposed AppSec Agent Harness; see study for scope and correspondence.
@startuml appsec-context
!include ../../../../../tooling/styles/plantuml/c4/context-diagram-style.iuml

C4_TITLE(AppSec Agent Harness, V1 system context)
Person(analyst, "AppSec analyst", "Reviews evidence and triage recommendations")
Person(dev, "Developer", "Reviews candidate changes")
Person(owner, "Risk owner", "Authorizes exceptions outside the agent")
System(harness, "AppSec Agent Harness", "Governs AI-assisted investigation and verification")
System_Ext(scanners, "Security scanners", "SAST, DAST, IAST, SCA and secret findings")
System_Ext(scm, "Source control", "Revision-bound code and draft PRs")
System_Ext(model, "Model provider", "Inference only")
System_Ext(ci, "CI and review systems", "Independent checks and review routing")
Rel(analyst, harness, "Reviews evidence", "HTTPS")
Rel(dev, harness, "Reviews recommendations", "HTTPS")
Rel(owner, ci, "Decides exceptions", "Human workflow")
Rel(scanners, harness, "Delivers findings", "Signed event/API")
Rel(harness, scm, "Reads authorized revision; proposes draft PR", "API")
Rel(harness, model, "Sends approved context", "HTTPS")
Rel(harness, ci, "Requests verification and routes report", "API")
SHOW_LEGEND()
@enduml
