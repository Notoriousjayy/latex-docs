@startuml
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml
actor Developer
rectangle "Untrusted / review boundary" {
  component "Pull request\nsource and tests" as PR
  component "PR CI\nread-only token" as CI
}
rectangle "Protected branch boundary" {
  component "Required check policy" as Gate
  component "Candidate artifact\nby digest" as Artifact
}
rectangle "Protected deploy boundary" {
  component "Environment reviewers" as Approval
  component "OIDC deployment job" as Deploy
  component "Cloud STS + IAM\nclaim validation" as STS
  node "Staging / production" as Env
}
Developer --> PR
PR --> CI : commit SHA
CI --> Gate : reports / status
Gate --> Artifact : accepted candidate
Artifact --> Deploy : verified digest
Approval --> Deploy : authorization
Deploy --> STS : short-lived OIDC token
STS --> Env : scoped temporary credentials
@enduml
