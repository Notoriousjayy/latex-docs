@startuml
skinparam monochrome true
title Build once, verify gates, and promote immutable artifact
rectangle "Untrusted PR context" as PR
rectangle "Commit CI / tests" as CI
rectangle "Signed artifact + digest" as B
rectangle "Acceptance + security + performance" as G
rectangle "Staging verification" as ST
rectangle "Protected production environment" as PROD
rectangle "Telemetry + rollback decision" as T
PR --> CI : no cloud deploy credentials
CI --> B : trusted mainline build
B --> G : same digest
G --> ST : approved candidate
ST --> PROD : explicit authorization
PROD --> T : observe
T ..> PROD : abort / revert
@enduml
