# Fill with PRE-EXISTING isolated state bucket, not committed actual credentials.
# Backend bucket must exist before terraform init. No automatic bootstrap.
bucket       = "REPLACE_WITH_SANDBOX_STATE_BUCKET"
key          = "cd-suite/sandbox/terraform.tfstate"
region       = "us-east-2"
use_lockfile = true
# Enforce state-bucket encryption and least privilege via separate bootstrap controls.
