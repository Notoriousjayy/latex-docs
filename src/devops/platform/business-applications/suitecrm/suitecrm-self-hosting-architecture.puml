@startuml
' ------------------------------------------------------------------
' Diagram   : SuiteCRM Self-Hosting - Deployment View
' Type      : C4 Deployment diagram (C4-PlantUML, house c4 style)
' Model kind: C4 deployment view (see src/architecture/readme.md, AD index)
' Subject   : Where the SuiteCRM container instances run in a single
'             self-hosted LAMP deployment. The entity of interest is the
'             SuiteCRM installation; users, DNS and the corporate network
'             are its environment.
' Evidence  : suitecrm-self-hosting-architecture-guide.md,
'             suitecrm-lamp-lemp-deployment-guide.md,
'             suitecrm-backup-restore-and-maintenance-guide.md
'             (SuiteCRM 8.10.x, Apache 2.4 with DocumentRoot
'             /var/www/suitecrm/public, PHP 8.2-8.4, MariaDB/MySQL,
'             ./bin/console schedulers:run as a non-root user, backup
'             scope = database + files + config).
' Status    : Reference deployment (default target). The Nginx/LEMP
'             variant is an operator pattern that must be validated
'             separately and is not drawn here.
' Notes     : Operational processes (monitoring, patching, restore test)
'             are practices, not deployment elements; they are recorded as
'             notes so the picture keeps C4 deployment semantics.
' History   : Migrated 2026-09 from a UML deployment-styled sketch; a
'             verbatim duplicate one directory up was retired.
' ------------------------------------------------------------------
!include ../../../../../tooling/styles/plantuml/c4/deployment-diagram-style.iuml

C4_TITLE(SuiteCRM Self-Hosting, default LAMP target - SuiteCRM 8.10.x)

Person(users, "CRM Users", "Sales, service and marketing staff")
Person(admins, "CRM Administrators", "Configure, upgrade and operate the instance")

Deployment_Node(edge, "Public Edge", "Internet / corporate network") {
  Deployment_Node(dns, "DNS", "crm.example.com") {
    Container_Ext(tls, "TLS Termination and HTTPS Redirect", "certificate + redirect", "Terminates HTTPS in front of the vhost")
  }
}

Deployment_Node(appHost, "SuiteCRM Application Host", "Linux server") {
  Deployment_Node(apache, "Apache 2.4 vHost", "DocumentRoot /var/www/suitecrm/public") {
    Deployment_Node(php, "PHP Runtime", "PHP 8.2-8.4 with required extensions") {
      Container(suitecrm, "SuiteCRM Application", "PHP / Symfony", "Web UI and API layer (Api/, Api/V8/); serves only the public/ web root")
      Container(scheduler, "Scheduler Command", "./bin/console schedulers:run via cron", "Recurring jobs; runs as an allowed non-root user")
    }
  }
  Deployment_Node(files, "Application File Storage", "local filesystem") {
    ContainerDb(appfiles, "public/, custom/, uploads / cache / logs", "filesystem", "Customisations and runtime files")
  }
}

Deployment_Node(dbHost, "Database Host", "same or separate host") {
  ContainerDb(db, "MariaDB / MySQL", "MariaDB or MySQL", "CRM data and metadata; workflow, e-mail, report and index state")
}

Deployment_Node(backup, "Backup Target", "off-host storage") {
  ContainerDb(dbDump, "Database Dumps / Snapshots", "mysqldump or snapshots", "Database part of the backup scope")
  ContainerDb(fileArchive, "File Archives", "archive of application files", "Files and config part of the backup scope")
}

Rel(users, tls, "Uses the CRM", "HTTPS")
Rel(admins, tls, "Administers the CRM", "HTTPS")
Rel(tls, suitecrm, "Forwards requests", "HTTPS to Apache vhost")
Rel(suitecrm, appfiles, "Reads / writes uploads, cache, logs, customisations")
Rel(suitecrm, db, "Reads / writes CRM data", "MySQL protocol")
Rel(scheduler, suitecrm, "Runs recurring jobs")
Rel(scheduler, db, "Updates workflow / e-mail / report / index state", "MySQL protocol")
Rel(db, dbDump, "Backed up to", "scheduled dump or snapshot")
Rel(appfiles, fileArchive, "Backed up to", "scheduled archive")

note right of apache
  Point the vhost at the public directory.
  Do not expose the full SuiteCRM root.
end note

Lay_D(appHost, dbHost)
Lay_D(dbHost, backup)

caption Production backup scope = database + files + config; a tested restore into a separate environment is the acceptance criterion. Monitoring and patch/upgrade runbooks are operational practices documented in the guides, not deployment elements.

SHOW_LEGEND()
@enduml
