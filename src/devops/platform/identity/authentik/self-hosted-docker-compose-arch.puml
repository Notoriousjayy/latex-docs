@startuml
' ------------------------------------------------------------------
' Diagram   : Authentik Self-Hosted Docker Compose - Deployment View
' Type      : C4 Deployment diagram (C4-PlantUML, house c4 style)
' Model kind: C4 deployment view (see src/architecture/readme.md, AD index)
' Subject   : Where the authentik container instances run in the official
'             Docker Compose topology. The entity of interest is the
'             authentik installation; relying applications, outposts and
'             the reverse proxy are its environment.
' Evidence  : authentik-self-hosting-architecture-guide.tex and
'             authentik-docker-compose-deployment-guide.tex (official
'             Docker Compose, reverse proxy with WebSocket upgrade and
'             X-Forwarded-* headers, server on 9000/9443, worker running
'             background tasks and watching blueprints/certificates,
'             PostgreSQL, /data /certs /custom-templates /blueprints
'             volumes, health endpoints, metrics on 9300, outposts that
'             must match the core version).
' Status    : Reference deployment derived from vendor documentation.
' Notes     : Health and metrics endpoints are recorded on the
'             relationships and in a note rather than as elements, because
'             they are interfaces of the containers, not separate
'             deployables.
' History   : Migrated 2026-09 from a UML deployment-styled sketch with a
'             local folder skinparam; the Docker Compose host, volumes and
'             containers map directly onto C4 deployment nodes and
'             containers.
' ------------------------------------------------------------------
!include ../../../../../tooling/styles/plantuml/c4/deployment-diagram-style.iuml

C4_TITLE(Authentik Self-Hosted Docker Compose, official topology)

Person(users, "Users / Admins", "Authenticate and administer through the browser")

Deployment_Node(proxyNode, "HTTPS Reverse Proxy", "operator-provided") {
  Container_Ext(proxy, "Reverse Proxy", "TLS termination", "HTTP to HTTPS redirect, WebSocket upgrade, required forwarding headers")
}

Deployment_Node(host, "Docker Compose Host", "Docker Engine + Compose") {
  Container(server, "authentik Server", "authentik container", "Web UI, API, identity flows; HTTP 9000 / HTTPS 9443 by default")
  Container(worker, "authentik Worker", "authentik container", "Background tasks; blueprint and certificate watchers; optional outpost automation")
  ContainerDb(db, "PostgreSQL", "PostgreSQL container", "Users, policies, providers, flows and configuration")
  Deployment_Node(volumes, "Static Volumes", "bind mounts / volumes") {
    ContainerDb(storage, "/data, /certs, /custom-templates, /blueprints", "filesystem", "Media, certificates, templates and blueprint files")
  }
}

Deployment_Node(outpostNode, "Outpost Hosts", "same or remote hosts") {
  Container(outposts, "Outposts", "authentik proxy / LDAP outposts", "Extension points; version must match the core instance")
}

System_Ext(apps, "Relying Applications", "Application + provider pairs: OIDC / OAuth2, SAML, LDAP, proxy provider")
System_Ext(monitoring, "Monitoring", "Scrapes health endpoints and Prometheus metrics")

Rel(users, proxy, "HTTPS requests", "HTTPS")
Rel(proxy, server, "Forwarded HTTPS context", "Host + X-Forwarded-*; WebSocket upgrades")
Rel(server, db, "Persistent data", "PostgreSQL protocol")
Rel(worker, db, "Background task state", "PostgreSQL protocol")
Rel(server, storage, "Local file storage")
Rel(worker, storage, "Blueprints and certificates")
Rel(apps, server, "IdP protocol endpoints", "OIDC / OAuth2, SAML, LDAP")
Rel(outposts, server, "Registers and receives configuration", "outpost API")
Rel(apps, outposts, "Proxy / LDAP access", "HTTP(S) / LDAP")
Rel(monitoring, server, "Health and metrics", "/-/health/live/, /-/health/ready/, port 9300")
Rel(monitoring, worker, "Worker health", "ak healthcheck")
Rel(monitoring, outposts, "Outpost health", "/outpost.goauthentik.io/ping")

SHOW_LEGEND()
@enduml
