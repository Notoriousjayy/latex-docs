@startuml
!include ../../../../../tooling/styles/plantuml/structural/class-diagram-style.iuml
' Original logical ERD for an illustrative manufacturing lab.
entity "PART" as part {
 * part_id : bigint <<PK>>
--
* part_code : text <<UK>>
}
entity "PART_REVISION" as revision {
 * revision_id : bigint <<PK>>
--
* part_id : bigint <<FK>>
* revision_code : text
}
entity "BOM_LINE" as line {
 * parent_revision_id : bigint <<FK>>
* component_revision_id : bigint <<FK>>
* effective_from : date
--
* quantity_per : numeric
}
entity "PRODUCTION_RUN" as run {
 * run_id : bigint <<PK>>
--
* produced_revision_id : bigint <<FK>>
}
part ||--o{ revision : has
revision ||--o{ line : parent of
revision ||--o{ line : component of
revision ||--o{ run : produces
@enduml
