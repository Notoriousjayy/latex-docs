@startuml
!include ../../../../../tooling/styles/plantuml/structural/class-diagram-style.iuml
' Original educational UML-style class model; illustrative, not the book diagram.
class Party {
 +partyId: ID
+displayName: String
}
class PartyRole {
 +roleAssignmentId: ID
+roleCode: String
+effectiveFrom: Date
+effectiveTo: Date?
}
class Agreement {
 +agreementId: ID
+agreementRef: String
+status: AgreementStatus
}
class AgreementParticipant {
 +responsibility: String
}
Party "1" -- "0..*" PartyRole : has assignments
PartyRole "1" -- "0..*" AgreementParticipant : acts as
Agreement "1" -- "1..*" AgreementParticipant : has parties
note right of PartyRole
  Overlapping role periods require
  explicit business policy.
end note
@enduml
