@startuml
!include ../../../../../tooling/styles/plantuml/structural/class-diagram-style.iuml
' Original logical marketplace ERD; omits payment as a separate bounded context.
entity "SELLER_OFFER" as offer {
 * offer_id : bigint <<PK>>
--
* seller_id : bigint
* price : numeric
* currency : char(3)
}
entity "PURCHASE_ORDER" as purchase {
 * order_id : bigint <<PK>>
--
* buyer_id : bigint
* placed_at : timestamp
}
entity "ORDER_LINE" as orderline {
 * order_line_id : bigint <<PK>>
--
* offer_id : bigint <<FK>>
* agreed_price : numeric
* quantity : integer
}
offer ||--o{ orderline : selected as
purchase ||--|{ orderline : contains
@enduml
