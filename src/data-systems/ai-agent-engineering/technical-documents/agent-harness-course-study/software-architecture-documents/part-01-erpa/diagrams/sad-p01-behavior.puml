@startuml
' SAD-AHC-P01 | C02 | SAD-P01-EVD-6 SAD-P01-EVD-9 SAD-P01-EVD-2 SAD-P01-EVD-4 SAD-P01-EVD-5
!include ../../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Critical runtime control trace
participant User
participant Graph
participant Cache
participant Memory
participant Tools
User -> Graph : run
Graph -> Cache : get(message)
alt hit
Cache --> Graph : cached envelope
Graph --> User : answer and trace
else miss
Graph -> Memory : recall
Graph -> Graph : call model
Graph -> Tools : dispatch
Graph -> Memory : persist
Graph -> Cache : put with user_id
Graph --> User : answer
end
legend right
Solid = call; dashed = result
alt = conditional branch
endlegend
@enduml
