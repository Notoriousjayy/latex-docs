@startuml
' AD-AHC-P02 P02-UML-SQ-003 | P02-EVD-006 P02-EVD-007 P02-EVD-023
!include ../../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Workspace tool boundary
participant "Agent graph" as x_loop
participant "Typed tools" as x_tools
participant "Workspace client" as x_workspace
participant "Workspace services" as external
x_loop -> x_tools : validate
x_tools -> x_workspace : invoke (logical)
x_workspace -> external : capability request
alt error
external --> x_workspace : failure
else success
external --> x_workspace : result
end
legend right
Solid = call; dashed = result
alt = conditional branch
endlegend
@enduml
