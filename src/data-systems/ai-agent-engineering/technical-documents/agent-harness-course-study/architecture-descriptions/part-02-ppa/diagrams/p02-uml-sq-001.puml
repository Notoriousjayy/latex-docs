@startuml
' AD-AHC-P02 P02-UML-SQ-001 | P02-EVD-002 P02-EVD-021 P02-EVD-023
!include ../../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Bounded agent loop
participant "Course user" as owner
participant "Agent graph" as x_loop
participant "System Two adapter" as x_model
participant "Typed tools" as x_tools
owner -> x_loop : request
x_loop -> x_model : respond
x_model --> x_loop : tool proposals or text
alt within budget
x_loop -> x_tools : validate and tier
x_tools --> x_loop : result or gated calls
x_loop -> x_model : next call
else no calls or exhausted
x_loop -> x_loop : persist
x_loop --> owner : answer
end
legend right
Solid = call; dashed = result
alt = conditional branch
endlegend
@enduml
