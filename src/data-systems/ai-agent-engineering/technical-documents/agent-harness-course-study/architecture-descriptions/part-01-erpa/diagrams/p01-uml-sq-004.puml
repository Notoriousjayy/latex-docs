@startuml
' AD-AHC-P01 P01-UML-SQ-004 | P01-EVD-023
!include ../../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Sandbox execution boundary
participant "Sandbox executor" as x_sandbox
participant "Remote sandbox" as remote
x_sandbox -> x_sandbox : validate and compute expected
alt remote policy denies egress
x_sandbox -> remote : execute known program
remote --> x_sandbox : observed result
x_sandbox -> x_sandbox : compare
else bad configuration
x_sandbox -> x_sandbox : refuse
end
x_sandbox -> remote : close
legend right
Solid = call; dashed = result
alt = conditional branch
endlegend
@enduml
