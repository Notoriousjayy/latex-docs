@startuml
' AD-AHC-P01 P01-UML-SQ-001 | P01-EVD-006 P01-EVD-009 P01-EVD-014
!include ../../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title ERPA cache hit and miss
participant "Course user" as owner
participant "Response cache" as x_cache
participant "ERPA graph" as x_loop
participant "Memory provider" as x_memory
participant "Tool registry" as x_tools
owner -> x_cache : lookup
alt hit
x_cache --> owner : cached answer
else miss
x_cache -> x_loop : assemble context
x_loop -> x_memory : recall
x_loop -> x_loop : call model
x_loop -> x_tools : dispatch
x_loop -> x_memory : persist
x_loop -> x_cache : put
x_loop --> owner : answer
end
legend right
Solid = call; dashed = result
alt = conditional branch
endlegend
@enduml
