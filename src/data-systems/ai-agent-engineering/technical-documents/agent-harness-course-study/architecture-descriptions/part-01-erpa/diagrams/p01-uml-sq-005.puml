@startuml
' AD-AHC-P01 P01-UML-SQ-005 | P01-EVD-020 P01-EVD-021 P01-EVD-029
!include ../../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Workflow lifecycle
participant "Course user" as owner
participant "Workflow API" as x_wf
participant "Oracle run and approval stores" as x_audit
owner -> x_wf : start_run
x_wf -> x_audit : persist (logical)
owner -> x_wf : decide_run
owner -> x_wf : resume_run
x_wf -> x_audit : recover (logical)
owner -> x_wf : inspect
legend right
Solid = call; dashed = result
alt = conditional branch
endlegend
@enduml
