@startuml
' AD-AHC-P03 P03-UML-SQ-009 | P03-EVD-022 P03-EVD-014
!include ../../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Scorecard evidence completeness
participant "Readiness scorecard" as x_scorecard
participant "Learning and correction" as x_learning
participant "Usage ledger" as x_ledger
x_scorecard -> x_scorecard : governed triage
alt WorkspaceError
x_scorecard -> x_scorecard : empty quarantine and note
else success
x_scorecard -> x_scorecard : quarantine IDs
end
x_scorecard -> x_learning : frozen_selection
x_scorecard -> x_ledger : summary
x_scorecard -> x_scorecard : BLOCKED if blocking false
legend right
Solid = call; dashed = result
alt = conditional branch
endlegend
@enduml
