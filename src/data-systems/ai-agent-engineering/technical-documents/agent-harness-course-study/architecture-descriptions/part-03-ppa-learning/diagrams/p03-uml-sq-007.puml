@startuml
' AD-AHC-P03 P03-UML-SQ-007 | P03-EVD-016 P03-EVD-017 P03-EVD-018 P03-EVD-019 P03-EVD-021
!include ../../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Candidate gate and promotion
participant "Course user" as owner
participant "Learning and correction" as x_learning
participant "Versioned skill registry" as x_skills
owner -> x_learning : draft skill
x_learning -> x_skills : store candidate
owner -> x_learning : gate_skill
x_learning -> x_skills : trial pointer
x_learning -> x_learning : five checks
x_learning -> x_skills : restore and set gate
alt all pass
owner -> x_learning : promote
x_learning -> x_skills : activate
else failure
x_learning --> owner : promotion denied
end
legend right
Solid = call; dashed = result
alt = conditional branch
endlegend
@enduml
