@startuml
' AD-AHC-P03 P03-UML-SQ-002 | P03-EVD-002 P03-EVD-004 P03-EVD-012
!include ../../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Approval and execution
participant "Course user" as owner
participant "Agent graph" as x_loop
participant "Approval audit" as x_approval
participant "Typed tools" as x_tools
x_loop -> x_approval : assess and draft
x_loop --> owner : interrupt
owner -> x_approval : record decision
owner -> x_loop : resume
x_loop -> x_approval : read audit
alt APPROVED
x_loop -> x_tools : revalidate and execute
x_loop -> x_approval : record outcome
else DRAFTED or rejected
x_loop -> x_approval : reject if undecided
x_loop --> owner : declined
end
legend right
Solid = call; dashed = result
alt = conditional branch
endlegend
@enduml
