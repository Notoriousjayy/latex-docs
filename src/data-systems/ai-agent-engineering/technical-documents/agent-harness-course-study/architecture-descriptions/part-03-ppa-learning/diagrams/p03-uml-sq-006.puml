@startuml
' AD-AHC-P03 P03-UML-SQ-006 | P03-EVD-002 P03-EVD-013 P03-EVD-014 P03-EVD-015
!include ../../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Model cost and trajectory
participant "Agent graph" as x_loop
participant "Model adapter" as x_model
participant "Usage ledger" as x_ledger
participant "Trajectory recorder" as x_trajectory
x_loop -> x_trajectory : plan
x_loop -> x_model : respond
x_model --> x_loop : usage
x_loop -> x_ledger : record call
x_loop -> x_trajectory : progress and close
legend right
Solid = call; dashed = result
alt = conditional branch
endlegend
@enduml
