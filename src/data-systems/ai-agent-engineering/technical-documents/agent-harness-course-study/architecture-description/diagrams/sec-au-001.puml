@startuml
!include ../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title SandboxedToolExecutor execution
participant Host
participant "Sandbox provider" as Sandbox
Host -> Host : resolve tool, validate arguments
Host -> Host : compute expected result
Host -> Sandbox : obtain config
alt Remote policy permits no egress
Host -> Sandbox : upload input and program
Host -> Sandbox : execute with empty env
Sandbox --> Host : observed output
Host -> Host : compare with expected
else Remote policy not fail-closed
Host -> Host : raise error
end
Host -> Sandbox : close in finally
legend right
  Local test profile is not proven isolation
endlegend
@enduml
