@startuml
!include ../../../../../../../tooling/styles/plantuml/c4/container-diagram-style.iuml
title Part 3 logical containers
Person(learner, "Course user", "Interacts with separate teaching examples")
System_Ext(model, "Model provider", "Returns model responses; not execution authority")
System_Ext(workspace, "Workspace providers", "Mail, calendar and notes operations")
System_Boundary(p3, "PPA learning") {
Container(p3_app, "PPA learning Appbook", "Python / HTTP", "Browser-facing application and Python backend, grouped as one teaching runtime for this view")
ContainerDb(p3_store, "Persistence", "Local / configured database", "Logical persistence; configuration-specific implementation")
Container(mcp3, "Workspace MCP server (Part 3)", "FastMCP", "Corresponding workspace boundary; Part 3 counterpart inferred")
}
Rel(learner, p3_app, "Uses", "HTTP")
Rel(p3_app, p3_store, "Reads / writes")
Rel(p3_app, model, "Requests inference (live)")
Rel(p3_app, mcp3, "Invokes tools", "MCP")
Rel(mcp3, workspace, "Accesses workspace")
SHOW_LEGEND()
@enduml
