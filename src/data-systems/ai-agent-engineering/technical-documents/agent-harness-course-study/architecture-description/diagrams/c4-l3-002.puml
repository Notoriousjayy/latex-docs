@startuml
!include ../../../../../../../tooling/styles/plantuml/c4/component-diagram-style.iuml
title Part 2 Appbook components
Container_Boundary(p2_app, "PPA productivity Appbook") {
Component(ppa_graph, "PPA agent graph", "Python", "Context and orchestration")
Component(ppa_approval, "Approval module", "Python", "Risk and action record")
Component(ppa_scheduler, "Scheduler", "Python", "Scheduled work")
Component(ppa_policy, "Policy helpers", "Python", "Heuristic input and recipient risk")
}
Rel(ppa_graph, ppa_approval, "Reviews effects (inferred)")
Rel(ppa_scheduler, ppa_graph, "Starts scheduled work (inferred)")
Rel(ppa_approval, ppa_policy, "Assesses risk (inferred)")
SHOW_LEGEND()
@enduml
