@startuml
!include ../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Part 3 bounded agent loop
SEQ_AUTONUMBER()
participant "Course user" as learner
participant "Agent graph" as loop
participant "Memory provider" as memory
participant "Model adapter" as llm
participant "Usage ledger" as ledger
participant "Tool dispatcher" as dispatch
participant "Trajectory recorder" as trajectory
learner -> loop : request
loop -> memory : standing + recall
loop -> trajectory : plan context layers
loop -> llm : respond
llm --> loop : response and tool calls
loop -> ledger : record usage
loop -> dispatch : validate / tier / refusal
alt No tool calls or budget exhausted
loop -> trajectory : close run
loop --> learner : answer
else Tool results
dispatch --> loop : result or gated calls
loop -> llm : next model call
end
legend right
  Solid arrow: request or call
  Dashed arrow: response
  alt: conditional path
endlegend
@enduml
