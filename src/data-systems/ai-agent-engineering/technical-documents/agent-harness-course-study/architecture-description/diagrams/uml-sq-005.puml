@startuml
!include ../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Workspace MCP integration
SEQ_AUTONUMBER()
participant "Agent graph" as loop
participant "Tool dispatcher" as dispatch
participant "Workspace MCP server (Part 3)" as mcp3
participant "Workspace providers" as workspace
loop -> dispatch : validate tool proposal
dispatch -> mcp3 : invoke workspace tool (inferred)
mcp3 -> workspace : provider call
alt Provider error
workspace --> mcp3 : exception
mcp3 --> dispatch : structured provider failure
else Successful call
workspace --> mcp3 : result
mcp3 --> dispatch : tool result
end
dispatch --> loop : result
legend right
  Solid arrow: request or call
  Dashed arrow: response
  alt: conditional path
endlegend
@enduml
