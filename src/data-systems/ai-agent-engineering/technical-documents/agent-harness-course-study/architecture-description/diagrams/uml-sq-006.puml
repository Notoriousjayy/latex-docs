@startuml
!include ../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Skill trial and promotion
SEQ_AUTONUMBER()
participant "Course user" as learner
participant "Learning gate" as learning
participant "Skill registry" as skills
learner -> learning : gate_skill(version)
learning -> skills : read stored version
learning -> skills : enter temporary trial
learning -> learning : real tools / regression / held-out / approval / replay
learning -> skills : restore live pointer
learning -> skills : persist PASSED or FAILED
learner -> learning : promote(version)
alt PASSED
learning -> skills : activate candidate
else Other state
learning --> learner : permission error
end
legend right
  Solid arrow: request or call
  Dashed arrow: response
  alt: conditional path
endlegend
@enduml
