@startuml
!include ../../../../../../../tooling/styles/plantuml/c4/container-diagram-style.iuml
title Part 2 logical containers
Person(learner, "Course user", "Interacts with separate teaching examples")
System_Ext(model, "Model provider", "Returns model responses; not execution authority")
System_Ext(workspace, "Workspace providers", "Mail, calendar and notes operations")
System_Boundary(p2, "PPA productivity") {
Container(p2_app, "PPA productivity Appbook", "Python / HTTP", "Browser-facing application and Python backend, grouped as one teaching runtime for this view")
ContainerDb(p2_store, "Persistence", "Local / configured database", "Logical persistence; configuration-specific implementation")
Container(mcp, "Workspace MCP server", "FastMCP", "Stateless HTTP tool server")
}
Rel(learner, p2_app, "Uses", "HTTP")
Rel(p2_app, p2_store, "Reads / writes")
Rel(p2_app, model, "Requests inference (live)")
Rel(p2_app, mcp, "Invokes tools", "MCP")
Rel(mcp, workspace, "Accesses workspace")
SHOW_LEGEND()
@enduml
