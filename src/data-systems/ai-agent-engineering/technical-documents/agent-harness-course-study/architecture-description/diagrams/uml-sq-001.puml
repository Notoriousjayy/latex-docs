@startuml
!include ../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title ERPA cache hit and miss
SEQ_AUTONUMBER()
participant "Course user" as learner
participant "Boundary cache" as cache
participant "ERPA graph" as erpa_graph
participant "Memory provider" as erpa_memory
participant "Tool registry" as erpa_tools
learner -> cache : lookup request
alt Cache hit
cache --> learner : cached answer
else Cache miss
cache -> erpa_graph : proceed
erpa_graph -> erpa_memory : recall context
erpa_graph -> erpa_tools : dispatch chosen intent
erpa_graph -> erpa_memory : persist
erpa_graph -> cache : store answer
erpa_graph --> learner : answer
end
legend right
  Solid arrow: request or call
  Dashed arrow: response
  alt: conditional path
endlegend
@enduml
