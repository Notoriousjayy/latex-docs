@startuml
!include ../../../../../../../tooling/styles/plantuml/c4/component-diagram-style.iuml
title Part 3 Appbook components
Container_Boundary(p3_app, "PPA learning Appbook") {
Component(loop, "Agent graph", "Python", "Checkpointed bounded loop")
Component(memory, "Memory provider", "Python", "Standing and recalled context")
Component(dispatch, "Tool dispatcher", "Python", "Validates proposals and determines tier")
Component(approval, "Approval audit", "Python", "Persisted approval decision and execution record")
Component(ledger, "Usage ledger", "Python", "Records model call costs")
Component(trajectory, "Trajectory recorder", "Python", "Records plan and outcome")
Component(skills, "Skill registry", "Python", "Versioned active pointer and disclosure")
Component(learning, "Learning gate", "Python", "Evaluates and promotes candidates")
Component(llm, "Model adapter", "Python", "Model response and usage mapping")
}
Rel(loop, memory, "Recalls")
Rel(loop, llm, "Requests response")
Rel(loop, dispatch, "Validates and dispatches")
Rel(loop, approval, "Drafts / checks audit state")
Rel(loop, ledger, "Records usage")
Rel(loop, trajectory, "Records outcome")
Rel(learning, skills, "Trials and promotes")
SHOW_LEGEND()
@enduml
