@startuml
!include ../../../../../../../tooling/styles/plantuml/c4/container-diagram-style.iuml
title Part 1 logical containers
Person(learner, "Course user", "Interacts with separate teaching examples")
System_Ext(model, "Model provider", "Returns model responses; not execution authority")
System_Boundary(p1, "ERPA retail planning") {
Container(p1_app, "ERPA retail planning Appbook", "Python / HTTP", "Browser-facing application and Python backend, grouped as one teaching runtime for this view")
ContainerDb(p1_store, "Persistence", "Local / configured database", "Logical persistence; configuration-specific implementation")
}
Rel(learner, p1_app, "Uses", "HTTP")
Rel(p1_app, p1_store, "Reads / writes")
Rel(p1_app, model, "Requests inference (live)")
SHOW_LEGEND()
@enduml
