@startuml
!include ../../../../../../../tooling/styles/plantuml/c4/component-diagram-style.iuml
title Part 1 Appbook components
Container_Boundary(p1_app, "ERPA retail planning Appbook") {
Component(cache, "Boundary cache", "Python", "Returns cached answer before context assembly")
Component(erpa_graph, "ERPA graph", "Python", "Coordinates context, model, dispatch and persistence")
Component(erpa_memory, "Memory provider", "Python", "Recall and persist scoped memory")
Component(erpa_tools, "Tool registry", "Python", "Dispatch by decision intent")
Component(erpa_approval, "Approval service", "Python", "Separate approval and execution")
}
Rel(cache, erpa_graph, "Miss: executes")
Rel(erpa_graph, erpa_memory, "Recalls / persists")
Rel(erpa_graph, erpa_tools, "Dispatches")
SHOW_LEGEND()
@enduml
