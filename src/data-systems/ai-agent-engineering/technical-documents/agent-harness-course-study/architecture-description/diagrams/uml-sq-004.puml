@startuml
!include ../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Memory context assembly
SEQ_AUTONUMBER()
participant "Agent graph" as loop
participant "Memory provider" as memory
participant "Trajectory recorder" as trajectory
participant "Model adapter" as llm
loop -> memory : standing()
memory --> loop : standing records
loop -> memory : recall(request, limit=6)
memory --> loop : typed recalled records
loop -> trajectory : plan context layers
loop -> llm : context plus request
legend right
  Solid arrow: request or call
  Dashed arrow: response
  alt: conditional path
endlegend
@enduml
