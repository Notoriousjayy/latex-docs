@startuml
!include ../../../../../../../tooling/styles/plantuml/interaction/sequence-diagram-style.iuml
title Approval interrupt and audit authority
SEQ_AUTONUMBER()
participant "Course user" as learner
participant "Agent graph" as loop
participant "Tool dispatcher" as dispatch
participant "Approval audit" as approval
loop -> dispatch : validate and determine tier
dispatch --> loop : approval required
loop -> approval : assess and draft
loop --> learner : interrupt with action IDs
learner -> approval : record decision
learner -> loop : resume
loop -> approval : read persisted action
alt APPROVED
loop -> dispatch : revalidate and execute
loop -> approval : record execution
else DRAFTED or rejected
loop -> approval : reject if undecided
loop --> learner : declined result
end
legend right
  Solid arrow: request or call
  Dashed arrow: response
  alt: conditional path
endlegend
@enduml
