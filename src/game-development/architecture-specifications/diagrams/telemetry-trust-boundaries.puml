@startuml
skinparam componentStyle rectangle
actor "Consenting Participant" as Participant
rectangle "Game Client" {
  [Consent Manager] --> [Event Sanitizer]
  [Gameplay Events] --> [Event Sanitizer]
}
rectangle "Research Boundary" {
  [Event Sanitizer] --> [Pseudonymous Store]
  [Pseudonymous Store] --> [Aggregate Analysis]
}
Participant --> [Consent Manager]
[Consent Manager] ..> [Pseudonymous Store] : delete/revoke policy
note bottom of [Event Sanitizer]
Allowlisted schema; do not collect PII
end note
@enduml
