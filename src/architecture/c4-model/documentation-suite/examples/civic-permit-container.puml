@startuml civic-permit-container
' Original fictional Civic Permit Portal teaching system.
' Reference: documentation-suite reference/plantuml-engineering-reference.tex
' House style requires a single C4 leaf include and no local style overrides.
!include ../../../../../tooling/styles/plantuml/c4/container-diagram-style.iuml
C4_TITLE(Civic Permit Container, illustrative fictional design)
Person(resident, "Resident", "Permit applicant")
System_Ext(identity, "Identity Provider", "Authenticates users")
System_Ext(payments, "Payment Gateway", "Authorizes fees")
System_Boundary(portal, "Civic Permit Portal") {
 Container(web, "Applicant Web App", "React / TypeScript", "Permit submission UI")
 Container(api, "Permit API", "Python / FastAPI", "Workflow and integration endpoints")
 Container(worker, "Review Worker", "Python", "Processes background review jobs")
 ContainerDb(db, "Permit Store", "PostgreSQL", "Persists applications")
 ContainerQueue(queue, "Work Queue", "Amazon SQS", "Schedules background jobs")
}
Rel(resident, web, "Uses", "HTTPS")
Rel(web, api, "Submits and reads applications", "HTTPS/JSON")
Rel(api, identity, "Verifies identity", "OIDC")
Rel(api, payments, "Requests authorization", "HTTPS/JSON")
Rel(api, db, "Reads and writes permit records", "SQL/TLS")
Rel(api, queue, "Queues review work", "SQS API")
Rel(worker, queue, "Consumes review work", "SQS API")
Rel(worker, db, "Updates review status", "SQL/TLS")
SHOW_LEGEND()
@enduml
