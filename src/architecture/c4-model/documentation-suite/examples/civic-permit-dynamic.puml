@startuml civic-permit-dynamic
' Original fictional Civic Permit Portal teaching system.
' Reference: documentation-suite reference/plantuml-engineering-reference.tex
' House style requires a single C4 leaf include and no local style overrides.
!include c4/dynamic-diagram-style.iuml
C4_TITLE(Civic Permit Dynamic, illustrative fictional design)
Person(resident, "Resident", "Permit applicant")
Container(web, "Applicant Web App", "React", "Browser client")
Container(api, "Permit API", "FastAPI", "Processes permits")
ContainerDb(db, "Permit Store", "PostgreSQL", "Persists applications")
System_Ext(payments, "Payment Gateway", "Authorizes fees")
Rel(resident, web, "Starts application", $index=Index())
Rel(web, api, "Submits validated request", "HTTPS/JSON", $index=Index())
Rel(api, payments, "Authorizes fee", "HTTPS/JSON", $index=Index())
Rel(api, db, "Stores permitted application", "SQL/TLS", $index=Index())
Rel(api, web, "Returns submission reference", "HTTPS/JSON", $index=Index())
SHOW_LEGEND()
@enduml
