@startuml civic-permit-component
' Original fictional Civic Permit Portal teaching system.
' Reference: documentation-suite reference/plantuml-engineering-reference.tex
' House style requires a single C4 leaf include and no local style overrides.
!include ../../../../../tooling/styles/plantuml/c4/component-diagram-style.iuml
C4_TITLE(Civic Permit Component, illustrative fictional design)
Container_Ext(web, "Applicant Web App", "React", "Calls the Permit API")
Container_Ext(db, "Permit Store", "PostgreSQL", "Stores applications")
Container_Ext(queue, "Work Queue", "SQS", "Schedules reviews")
Container_Boundary(api, "Permit API") {
 Component(routes, "Permit Routes", "FastAPI", "Accepts and validates requests")
 Component(workflow, "Permit Workflow", "Python", "Coordinates state changes")
 Component(payment, "Payment Adapter", "Python", "Requests fee authorization")
 Component(repo, "Permit Repository", "Python", "Persists domain records")
}
Rel(web, routes, "Invokes", "HTTPS/JSON")
Rel(routes, workflow, "Delegates decisions")
Rel(workflow, payment, "Requests fee checks")
Rel(workflow, repo, "Saves and loads permits")
Rel(repo, db, "Queries", "SQL/TLS")
Rel(workflow, queue, "Enqueues review", "SQS API")
SHOW_LEGEND()
@enduml
