@startuml civic-permit-context
' Original fictional Civic Permit Portal teaching system.
' Reference: documentation-suite reference/plantuml-engineering-reference.tex
' House style requires a single C4 leaf include and no local style overrides.
!include c4/context-diagram-style.iuml
C4_TITLE(Civic Permit Context, illustrative fictional design)
Person(resident, "Resident", "Submits and tracks permit requests")
Person(reviewer, "City Reviewer", "Reviews submitted requests")
System(portal, "Civic Permit Portal", "Receives and processes permit applications")
System_Ext(identity, "Identity Provider", "Authenticates residents and reviewers")
System_Ext(payments, "Payment Gateway", "Processes application fees")
System_Ext(gis, "City GIS", "Provides parcel and zoning information")
Rel(resident, portal, "Submits and tracks permits", "HTTPS")
Rel(reviewer, portal, "Reviews applications", "HTTPS")
Rel(portal, identity, "Authenticates users", "OIDC")
Rel(portal, payments, "Requests fee authorization", "HTTPS/JSON")
Rel(portal, gis, "Checks zoning information", "HTTPS/JSON")
SHOW_LEGEND()
@enduml
