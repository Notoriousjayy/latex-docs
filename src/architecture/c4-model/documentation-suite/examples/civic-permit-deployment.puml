@startuml civic-permit-deployment
' Original fictional Civic Permit Portal teaching system.
' Reference: documentation-suite reference/plantuml-engineering-reference.tex
' C4 deployment nodes host container definitions; replicas are identified in labels.
!include ../../../../../tooling/styles/plantuml/c4/deployment-diagram-style.iuml
C4_TITLE(Civic Permit Deployment, illustrative fictional design)
Deployment_Node(cloud, "Production Cloud", "AWS Account", "Fictional deployment") {
 Deployment_Node(vpc, "Application VPC", "VPC", "Private workload network") {
  Deployment_Node(ecs, "API Services", "ECS Fargate", "Service tasks") {
   Container(api, "Permit API (replica 1)", "FastAPI", "Processes permit requests")
   Container(worker, "Review Worker (replica 1)", "Python", "Runs review jobs")
  }
  Deployment_Node(rds, "Managed Database", "Amazon RDS") {
   ContainerDb(db, "Permit Store", "PostgreSQL", "Stores permit data")
  }
 }
}
Rel(api, db, "Reads/writes permit data", "SQL/TLS")
Rel(worker, db, "Updates review status", "SQL/TLS")
SHOW_LEGEND()
@enduml
