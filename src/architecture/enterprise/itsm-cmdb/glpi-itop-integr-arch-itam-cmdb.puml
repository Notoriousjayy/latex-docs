@startuml
' ------------------------------------------------------------------
' Diagram   : GLPI + iTop Integration - Container View
' Type      : C4 Container diagram (C4-PlantUML, house c4 style)
' Model kind: C4 container view (see src/architecture/readme.md, AD index)
' Subject   : The ITAM-to-CMDB integration service that synchronises
'             GLPI (asset source of record) into iTop (governed CMDB).
'             GLPI, iTop and the endpoint fleet are neighbouring systems
'             and therefore appear as external systems; their internals
'             (e.g. iTop incident/change processes) are out of scope and
'             are summarised on the relationships instead.
' Evidence  : glpi-itop/integr-arch-guide-itam-cmdb-synchronization.tex
'             (REST/JSON API or controlled import; GLPI Agent, GLPI
'             Inventory and OCS-style inputs; scheduler + ETL + connector;
'             deterministic identity matching, duplicate prevention,
'             mandatory-field validation, lifecycle translation, exception
'             queue and audit log).
' Status    : PROPOSED integration pattern (the guide is a reference
'             design, not a record of an implemented system). Elements
'             tagged "proposed" are design choices the guide leaves open.
' History   : Migrated 2026-09 from a UML deployment-styled sketch in which
'             GLPI/iTop were drawn as databases and the connector as a
'             queue; C4 container abstractions match the guide's
'             "which applications and stores make up the integration"
'             question better than deployment nodes did.
' ------------------------------------------------------------------
!include ../../../../tooling/styles/plantuml/c4/container-diagram-style.iuml

C4_TITLE(ITAM-to-CMDB Integration Service, proposed pattern - GLPI to iTop synchronisation)

Person(assetOwner, "Asset / Endpoint Owner", "Maintains ownership, lifecycle, location and licence context in GLPI")
Person(itsmUser, "IT Support / Change Manager", "Consumes CI context in iTop incident, change and impact analysis")

System_Ext(fleet, "Endpoint and Infrastructure Fleet", "Servers, workstations, network devices, software installations")
System_Ext(glpi, "GLPI", "ITAM + inventory source of record; fed by GLPI Agent / GLPI Inventory / OCS-compatible inputs")
System_Ext(itop, "iTop", "Governed CMDB with CI relationships; incident, change and service-impact processes")

System_Boundary(integration, "ITAM-to-CMDB Integration Service") {
  Container(connector, "Scheduler + ETL + Connector", "technology not specified", "Extracts approved assets, normalises them into CI candidates on a schedule")
  ContainerDb(mapping, "Mapping and Policy Store", "technology not specified", "CI classes, field ownership, lifecycle rules, identity keys", $tags="proposed")
  Container(gate, "Validation and Reconciliation Gate", "technology not specified", "Deterministic identity matching, duplicate prevention, mandatory-field validation, lifecycle-state translation")
  ContainerDb(audit, "Audit, Reporting and Exception Queue", "technology not specified", "Run metrics, rejected records, duplicate candidates, missing mandatory fields")
}

Rel(fleet, glpi, "Inventory facts and payloads", "GLPI Agent / OCS-style inputs")
Rel(assetOwner, glpi, "Asset ownership, lifecycle, location, licence context", "GLPI UI")
Rel(glpi, connector, "Approved asset extract", "REST/JSON API or controlled CSV export")
Rel(mapping, connector, "Mapping rules and field-ownership policies")
Rel(connector, gate, "Normalised CI candidate payloads")
Rel(gate, itop, "Create or update governed CIs", "REST/JSON API or controlled import")
Rel(gate, audit, "Rejected records, duplicates, missing mandatory fields")
Rel(connector, audit, "Run metrics, errors, created/updated/skipped counts")
Rel(itop, itsmUser, "CI context for incidents, changes and impact analysis", "iTop UI")

SHOW_LEGEND()
@enduml
