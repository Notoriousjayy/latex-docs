@startuml 06-normalization-progression
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

!define RED $line_invalid
!define ORANGE $line_caution
!define YELLOW $line_caution
!define GREEN $line_ok
!define BLUE $line_primary

title <size:18><b>Normalization Progression</b></size>\n<size:12>Reducing redundancy through successive normal forms</size>

rectangle "**Unnormalized**" as UNF $fill_invalid {
  rectangle "Repeating groups\nMulti-valued columns\nDuplicated rows" as u1 $deep_invalid
}

rectangle "**1NF – First Normal Form**" as NF1 $fill_caution {
  rectangle "Atomic values only\nNo repeating groups\nUnique rows via PK" as n1 $deep_caution
}

rectangle "**2NF – Second Normal Form**" as NF2 $fill_ok {
  rectangle "Meets 1NF\nNo partial dependencies\nAll non-key attrs depend\non full composite PK" as n2 $deep_ok
}

rectangle "**3NF – Third Normal Form**" as NF3 $fill_dynamic {
  rectangle "Meets 2NF\nNo transitive dependencies\nNon-key attrs depend\nonly on the key" as n3 $deep_dynamic
}

rectangle "**BCNF – Boyce-Codd NF**" as BCNF $fill_primary {
  rectangle "Meets 3NF\nEvery determinant is\na candidate key" as bc1 $deep_primary
}

UNF -[$line_invalid,bold]-> NF1 : " Eliminate\n repeating groups "
NF1 -[$line_caution,bold]-> NF2 : " Remove partial\n dependencies "
NF2 -[$line_caution,bold]-> NF3 : " Remove transitive\n dependencies "
NF3 -[$line_ok,bold]-> BCNF : " Strengthen\n determinant rule "

note right of UNF
  **Problem:** Update anomalies,
  insertion & deletion anomalies
end note

note right of BCNF
  **Goal for most systems.**
  Higher NFs (4NF, 5NF) address
  multi-valued & join dependencies.
end note

@enduml
