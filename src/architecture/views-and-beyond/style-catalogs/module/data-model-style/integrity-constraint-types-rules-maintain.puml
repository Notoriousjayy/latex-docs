@startuml 10-constraint-types
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

!define BLUE $line_primary
!define GREEN $line_ok
!define ORANGE $line_caution
!define PURPLE $line_alt
!define TEAL $line_dynamic

title <size:18><b>Data Integrity Constraint Types</b></size>\n<size:12>Rules that maintain data correctness and quality</size>

rectangle "**Entity Integrity**" as EI $deep_primary {
  rectangle "Primary keys never null" as e1 $fill_primary
  rectangle "Primary keys always unique" as e2 $fill_primary
  rectangle "Every instance identifiable" as e3 $fill_primary
}

rectangle "**Referential Integrity**" as RI $deep_ok {
  rectangle "FK matches existing PK" as r1 $fill_ok
  rectangle "No orphaned records" as r2 $fill_ok
  rectangle "Cascade / Restrict rules" as r3 $fill_ok
}

rectangle "**Domain Integrity**" as DI $deep_caution {
  rectangle "Correct data types" as d1 $fill_caution
  rectangle "Value range constraints" as d2 $fill_caution
  rectangle "NOT NULL where required" as d3 $fill_caution
}

rectangle "**Business Rule Integrity**" as BI $deep_alt {
  rectangle "Value constraints\n(salary > 0)" as b1 $fill_alt
  rectangle "State constraints\n(ship after pay)" as b2 $fill_alt
  rectangle "Cross-entity rules\n(order ≤ credit limit)" as b3 $fill_alt
}

rectangle "**Temporal Integrity**" as TI $deep_dynamic {
  rectangle "Valid time periods" as t1 $fill_dynamic
  rectangle "No overlapping intervals" as t2 $fill_dynamic
  rectangle "Bi-temporal consistency" as t3 $fill_dynamic
}

EI -[hidden]right- RI
RI -[hidden]right- DI
DI -[hidden]down- BI
BI -[hidden]left- TI

note as N1
  **Enforcement levels:**
  Database → triggers, checks, FKs
  Application → validation logic
  Documentation → non-enforceable rules
end note

@enduml
