@startuml 04-generalization-specialization
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

!define SUPER $line_primary
!define SUB1 $line_ok
!define SUB2 $line_caution
!define SUB3 $line_alt
!define LIGHT_SUPER $fill_primary
!define LIGHT_S1 $fill_ok
!define LIGHT_S2 $fill_caution
!define LIGHT_S3 $fill_alt
!define BORDER $line_primary

title <size:18><b>Generalization & Specialization</b></size>\n<size:12>Supertype/subtype inheritance hierarchy (Account example)</size>

class "Account" as acct <<Supertype>> $fill_primary {
  account_id : UUID <<PK>>
  owner_id : UUID <<FK>>
  balance : Decimal
  opened_date : Date
  status : Enum
}

class "CheckingAccount" as check <<Subtype>> $fill_ok {
  overdraft_limit : Decimal
  check_number_seq : Integer
}

class "SavingsAccount" as save <<Subtype>> $fill_caution {
  interest_rate : Decimal
  min_balance : Decimal
}

class "InvestmentAccount" as invest <<Subtype>> $fill_alt {
  risk_profile : Enum
  broker_id : UUID <<FK>>
}

acct <|-- check
acct <|-- save
acct <|-- invest

note right of acct
  Shared attributes inherited
  by all subtypes
end note

note bottom of check
  **Disjoint, Total**
  Every account must be
  exactly one subtype
end note

legend bottom
  |= Strategy |= Description |= Trade-off |
  | Single Table | One table, all columns, discriminator | Simple queries · Sparse nulls |
  | Class Table | Supertype + subtype tables, shared PK | Normalized · Requires joins |
  | Concrete Table | Separate table per subtype | No joins · Duplicated structure |
end legend

@enduml
