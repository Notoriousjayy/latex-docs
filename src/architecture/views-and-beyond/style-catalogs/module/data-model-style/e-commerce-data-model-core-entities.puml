@startuml 07-ecommerce-data-model
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

!define CORE_BG $fill_primary
!define CORE_BD $line_primary
!define REF_BG $fill_alt
!define REF_BD $line_alt
!define TRANS_BG $fill_ok
!define TRANS_BD $line_ok
!define ASSOC_BG $fill_caution
!define ASSOC_BD $line_caution

title <size:18><b>E-Commerce Data Model</b></size>\n<size:12>Core entities, relationships, and reference data</size>

class "Customer" as cust <<Core>> $fill_primary {
  customer_id : UUID <<PK>>
  email : String <<UK>>
  first_name : String
  last_name : String
  phone : String
  created_at : DateTime
}

class "Order" as ord <<Transaction>> $fill_ok {
  order_id : UUID <<PK>>
  customer_id : UUID <<FK>>
  order_date : DateTime
  status : Enum
  shipping_method_id : UUID <<FK>>
  total_amount : Decimal
}

class "OrderLine" as ol <<Association>> $fill_caution {
  order_id : UUID <<FK,PK>>
  product_id : UUID <<FK,PK>>
  quantity : Integer
  unit_price : Decimal
  line_total : Decimal
}

class "Product" as prod <<Core>> $fill_primary {
  product_id : UUID <<PK>>
  sku : String <<UK>>
  name : String
  description : Text
  price : Decimal
  stock_qty : Integer
  category_id : UUID <<FK>>
}

class "Category" as cat <<Reference>> $fill_alt {
  category_id : UUID <<PK>>
  parent_id : UUID <<FK>>
  name : String
  level : Integer
}

class "Payment" as pay <<Transaction>> $fill_ok {
  payment_id : UUID <<PK>>
  order_id : UUID <<FK>>
  method_id : UUID <<FK>>
  amount : Decimal
  status : Enum
  paid_at : DateTime
}

class "PaymentMethod" as pm <<Reference>> $fill_alt {
  method_id : UUID <<PK>>
  type : Enum
  display_name : String
}

class "ShippingMethod" as sm <<Reference>> $fill_alt {
  shipping_method_id : UUID <<PK>>
  name : String
  cost : Decimal
  est_days : Integer
}

cust "1" -- "0..*" ord : places >
ord "1" *-- "1..*" ol : contains >
ol "0..*" -- "1" prod : references >
prod "0..*" -- "1" cat : classified by >
cat "0..*" -- "0..1" cat : parent >
ord "1" -- "0..*" pay : paid by >
pay "0..*" -- "1" pm : uses >
ord "0..*" -- "1" sm : shipped via >

legend bottom left
  |= Color |= Entity Type |
  | <$fill_primary> | Core Entity |
  | <$fill_ok> | Transaction Entity |
  | <$fill_caution> | Association Entity |
  | <$fill_alt> | Reference Entity |
end legend

@enduml
