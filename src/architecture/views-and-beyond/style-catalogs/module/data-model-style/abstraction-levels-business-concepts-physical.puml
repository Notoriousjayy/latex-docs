@startuml 01-abstraction-levels
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

!define ACCENT $deep_primary
!define LIGHT $fill_primary
!define MID $deep_primary
!define DARK $line_primary
!define GRAY $theme_surface
!define BORDER $line_primary

title <size:18><b>Data Model Abstraction Levels</b></size>\n<size:12>From business concepts to physical implementation</size>

rectangle "**Conceptual Model**" as CM ACCENT {
  rectangle "Business terminology" as C1 LIGHT
  rectangle "Entity identification" as C2 LIGHT
  rectangle "High-level relationships" as C3 LIGHT
  rectangle "Technology-independent" as C4 LIGHT
}

rectangle "**Logical Model**" as LM $deep_ok {
  rectangle "Attributes & data types" as L1 $fill_ok
  rectangle "Keys & constraints" as L2 $fill_ok
  rectangle "Precise cardinalities" as L3 $fill_ok
  rectangle "Normalization applied" as L4 $fill_ok
}

rectangle "**Physical Model**" as PM $deep_caution {
  rectangle "Table & column definitions" as P1 $fill_caution
  rectangle "Indexes & partitions" as P2 $fill_caution
  rectangle "Storage parameters" as P3 $fill_caution
  rectangle "Technology-specific DDL" as P4 $fill_caution
}

CM -[DARK]-> LM : "  Add detail &\n  precision  "
LM -[DARK]-> PM : "  Optimize for\n  target technology  "

note right of CM
  **Audience:** Business stakeholders
  **Purpose:** Communication & validation
end note

note right of LM
  **Audience:** Architects & analysts
  **Purpose:** Architecture specification
end note

note right of PM
  **Audience:** Database developers
  **Purpose:** Implementation blueprint
end note

@enduml
