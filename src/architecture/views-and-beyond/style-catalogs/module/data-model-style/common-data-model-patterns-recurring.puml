@startuml 08-common-patterns
!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

!define BLUE $line_primary
!define LBLUE $fill_primary
!define GREEN $line_ok
!define LGREEN $fill_ok
!define ORANGE $line_caution
!define LORANGE $fill_caution
!define PURPLE $line_alt
!define LPURPLE $fill_alt

title <size:18><b>Common Data Model Patterns</b></size>\n<size:12>Recurring solutions to common modeling challenges</size>

package "Audit Trail Pattern" as pkg1 $fill_primary {
  class "Employee" as emp1 $theme_surface {
    employee_id : UUID <<PK>>
    name : String
    salary : Decimal
    --
    **created_by** : String
    **created_at** : DateTime
    **modified_by** : String
    **modified_at** : DateTime
  }
  class "Employee_Audit" as empaud $theme_surface {
    audit_id : UUID <<PK>>
    employee_id : UUID <<FK>>
    change_type : Enum
    old_values : JSON
    new_values : JSON
    changed_by : String
    changed_at : DateTime
  }
  emp1 "1" -- "0..*" empaud : tracks >
}

package "Soft Delete Pattern" as pkg2 $fill_ok {
  class "Document" as doc $theme_surface {
    document_id : UUID <<PK>>
    title : String
    content : Text
    --
    **is_deleted** : Boolean
    **deleted_at** : DateTime
    **deleted_by** : String
  }
  note bottom of doc
    Queries filter:
    WHERE is_deleted = FALSE
  end note
}

package "Self-Referencing Pattern" as pkg3 $fill_caution {
  class "Category" as cat2 $theme_surface {
    category_id : UUID <<PK>>
    **parent_id** : UUID <<FK>>
    name : String
    level : Integer
  }
  cat2 "0..*" --> "0..1" cat2 : parent
}

package "SCD Type 2 Pattern" as pkg4 $fill_alt {
  class "ProductPrice" as pp $theme_surface {
    product_id : UUID <<FK>>
    price : Decimal
    **effective_from** : Date
    **effective_to** : Date
    **is_current** : Boolean
    version : Integer
  }
  note bottom of pp
    Full history preserved.
    Queries use is_current
    or date range filters.
  end note
}

@enduml
