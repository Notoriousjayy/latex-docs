@startuml

title <b>Operating System — Hierarchical Decomposition</b>\nMajor subsystems and their internal modules

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

package "Operating System" $deep_dynamic {

  package "Kernel" $deep_primary {
    rectangle "Process\nManagement" as PM $fill_primary
    rectangle "Memory\nManagement" as MM $fill_primary
    rectangle "I/O\nManagement" as IO $fill_primary
  }

  package "File Systems" $deep_primary {
    rectangle "VFS Layer" as VFS $fill_primary
    rectangle "FS Implementations\n(ext4, NTFS, ...)" as FSI $fill_primary
  }

  package "Device Drivers" $deep_primary {
    rectangle "Driver\nFramework" as DF $fill_primary
    rectangle "Specific\nDrivers" as SD $fill_primary
  }

  package "Networking" $deep_primary {
    rectangle "Protocol\nStack" as PS $fill_primary
    rectangle "Network\nInterfaces" as NI $fill_primary
  }
}

rectangle "User Processes" as UP $fill_neutral
rectangle "System Call Interface" as SCI $fill_dynamic
rectangle "Hardware Abstraction" as HA $fill_dynamic

UP -[$line_neutral,bold]down-> SCI : " depends on "
SCI -[$line_neutral,bold]down-> PM
SCI -[$line_neutral]down-> MM
SCI -[$line_neutral]down-> VFS
PM -[$line_neutral]down-> HA
MM -[$line_neutral]down-> HA
IO -[$line_neutral]down-> HA

note right of HA
  Dependencies flow
  strictly downward.
end note
@enduml
