@startuml

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

title <b>Microservice — Internal Module Structure</b>\nDependencies flow inward toward the domain layer

package "API Layer" <<Rectangle>> $deep_alt {
  rectangle "REST\nControllers" as RC $fill_alt
  rectangle "DTOs" as DTO $fill_alt
}

package "Domain Layer" <<Rectangle>> $fill_dynamic {
  rectangle "Entities" as ENT $fill_primary
  rectangle "Domain\nServices" as DS $fill_primary
  rectangle "Repository\nInterfaces" as RI $fill_primary
}

package "Infrastructure Layer" <<Rectangle>> $deep_dynamic {
  rectangle "Database\nAccess" as DB $deep_primary
  rectangle "Messaging" as MSG $deep_primary
  rectangle "External\nClients" as EC $deep_primary
}

RC -[$line_invalid,bold]down-> DS : " invokes "
RC -[$line_invalid,bold]down-> DTO
DTO -[$line_invalid]down-> ENT

DB -[$line_primary,bold]up-.|> RI : " implements "
MSG -[$line_primary]up-.-> DS
EC -[$line_primary]up-.-> RI

note bottom of RI
  Domain defines interfaces;
  Infrastructure provides
  concrete implementations.
end note
@enduml
