@startuml
skinparam nodesep 40
!include ../../../../../../tooling/styles/plantuml/structural/class-diagram-style.iuml

skinparam ranksep 35

title **Common Generalization Patterns**\nDesign patterns that rely on inheritance hierarchies

package "Template Method" $fill_caution {
  abstract class "DataParser" as dp $deep_caution {
    + parse() <<final>>
    {abstract} # readData()
    {abstract} # processData()
    {abstract} # writeResult()
  }
  class "CSVParser" as csv $fill_primary {
    # readData()
    # processData()
    # writeResult()
  }
  class "XMLParser" as xml $fill_primary {
    # readData()
    # processData()
    # writeResult()
  }
  dp <|-- csv
  dp <|-- xml
}

package "Strategy" $deep_primary {
  interface "SortStrategy" as ss $fill_dynamic {
    + sort(data)
  }
  class "QuickSort" as qs $fill_primary {
    + sort(data)
  }
  class "MergeSort" as ms $fill_primary {
    + sort(data)
  }
  class "Context" as ctx $theme_surface {
    - strategy : SortStrategy
    + execute()
  }
  ss <|.. qs
  ss <|.. ms
  ctx --> ss : uses
}

package "Abstract Factory" $fill_alt {
  interface "UIFactory" as uif $deep_alt {
    + createButton()
    + createTextField()
  }
  class "DarkThemeFactory" as dtf $fill_primary {
    + createButton()
    + createTextField()
  }
  class "LightThemeFactory" as ltf $fill_primary {
    + createButton()
    + createTextField()
  }
  uif <|.. dtf
  uif <|.. ltf
}

@enduml
