@startuml
skinparam nodesep 50
!include ../../../../../../tooling/styles/plantuml/structural/class-diagram-style.iuml

skinparam ranksep 40

title **Inheritance vs. Composition**\nTwo approaches to reusing behavior

package "Inheritance (is-a)" $fill_caution {
  class "Logger" as log1 $deep_caution {
    + log(msg)
    + setLevel(lvl)
  }
  class "FileLogger" as flog $fill_primary {
    + log(msg)
    - filePath
  }
  class "DatabaseLogger" as dlog $fill_primary {
    + log(msg)
    - connection
  }
  log1 <|-- flog
  log1 <|-- dlog
}

package "Composition (has-a)" $deep_ok {
  interface "LogWriter" as lw $fill_alt {
    + write(msg)
  }
  class "FileWriter" as fw $fill_ok {
    + write(msg)
  }
  class "DatabaseWriter" as dw $fill_ok {
    + write(msg)
  }
  class "Logger " as log2 $fill_primary {
    - writer : LogWriter
    + log(msg)
    + setLevel(lvl)
  }
  lw <|.. fw
  lw <|.. dw
  log2 o--> lw : delegates
}

note bottom of log1
  **Tight coupling** to parent.
  FileLogger //is-a// Logger.
  Changes to Logger may break children.
end note

note bottom of log2
  **Loose coupling** via interface.
  Logger //has-a// writer.
  Writers are swappable at runtime.
end note

legend bottom
  Prefer **composition** for behavior reuse and flexibility.
  Use **inheritance** for true //is-a// relationships and polymorphism.
end legend

@enduml
