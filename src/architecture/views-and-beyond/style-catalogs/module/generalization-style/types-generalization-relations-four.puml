@startuml
skinparam nodesep 60
!include ../../../../../../tooling/styles/plantuml/structural/class-diagram-style.iuml

skinparam ranksep 50

title **Types of Generalization Relations**\nFour mechanisms for expressing the //is-a// relationship

package "Class Inheritance (extends)" $fill_primary {
  abstract class "Vehicle" as veh $fill_ok {
    + start()
    + stop()
  }
  class "Car" as car $fill_primary {
    + openTrunk()
  }
  veh <|-- car : extends
}

package "Interface Inheritance (extends)" $fill_primary {
  interface "Collection" as coll $fill_alt {
    + add()
    + remove()
  }
  interface "List" as list $fill_alt {
    + get(index)
  }
  coll <|-- list : extends
}

package "Interface Realization (implements)" $fill_primary {
  interface "Drawable" as draw $fill_alt {
    + draw()
  }
  class "Circle" as circ $fill_primary {
    + draw()
    + radius()
  }
  draw <|.. circ : implements
}

package "Mixin Inclusion (with)" $fill_primary {
  class "<<mixin>> Timestamped" as ts $fill_caution {
    + createdAt()
    + updatedAt()
  }
  class "Order" as ord $fill_primary {
    + total()
  }
  ts <|.. ord : includes
}

legend bottom
  **Solid line + hollow triangle** = class / interface inheritance (extends)
  **Dashed line + hollow triangle** = realization / mixin inclusion (implements / with)
end legend

@enduml
