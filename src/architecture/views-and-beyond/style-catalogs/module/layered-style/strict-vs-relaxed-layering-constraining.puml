@startuml
!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

title Strict vs. Relaxed Layering\nConstraining the allowed-to-use relation

package "Strict Layering" as strict $theme_surface {
  rectangle "Layer 4\n**Presentation**" as S4 $fill_primary
  rectangle "Layer 3\n**Application**" as S3 $fill_ok
  rectangle "Layer 2\n**Domain**" as S2 $fill_caution
  rectangle "Layer 1\n**Foundation**" as S1 $fill_alt

  S4 -[$line_primary]-> S3 : uses
  S3 -[$line_primary]-> S2 : uses
  S2 -[$line_primary]-> S1 : uses
}

package "Relaxed Layering" as relaxed $theme_surface {
  rectangle "Layer 4\n**Presentation**" as R4 $fill_primary
  rectangle "Layer 3\n**Application**" as R3 $fill_ok
  rectangle "Layer 2\n**Domain**" as R2 $fill_caution
  rectangle "Layer 1\n**Foundation**" as R1 $fill_alt

  R4 -[$line_primary]-> R3 : uses
  R3 -[$line_primary]-> R2 : uses
  R2 -[$line_primary]-> R1 : uses
  R4 -[$line_invalid,dashed]-> R2 : skip
  R4 -[$line_invalid,dashed]-> R1 : skip
  R3 -[$line_invalid,dashed]-> R1 : skip
}

note bottom of strict
  Each layer uses **only** the layer
  immediately below. Maximum isolation
  but may require pass-through methods.
end note

note bottom of relaxed
  Each layer may use **any** layer
  below it. More flexible and efficient
  but increases potential coupling.
end note
@enduml
