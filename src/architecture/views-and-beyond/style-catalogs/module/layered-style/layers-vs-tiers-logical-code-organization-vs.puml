@startuml
!include ../../../../../../tooling/styles/plantuml/structural/deployment-diagram-style.iuml

title Layers vs. Tiers\nLogical code organization vs. physical deployment

package "Layers (Logical -- Design Time)" as LAYERS $deep_primary {
  rectangle "**Presentation**" as LP $fill_primary
  rectangle "**Business Logic**" as LB $fill_ok
  rectangle "**Data Access**" as LD $fill_caution

  LP -[$line_primary]-> LB
  LB -[$line_primary]-> LD
}

package "Tiers (Physical -- Deployment Time)" as TIERS $deep_caution {
  node "**Client Tier**\nBrowser / Mobile" as TC $fill_primary
  node "**Application Tier**\nServer" as TA $fill_ok
  node "**Database Tier**\nDB Server" as TD $fill_caution

  TC -[$line_invalid]-> TA : HTTP / API
  TA -[$line_invalid]-> TD : SQL / ORM
}

LAYERS -[hidden]right-> TIERS

note bottom of LAYERS
  **Layers** constrain code
  dependencies (compile-time).
  Same layers can deploy
  as 1, 2, or 3 tiers.
end note

note bottom of TIERS
  **Tiers** constrain runtime
  distribution (deploy-time).
  Communication crosses
  network boundaries.
end note
@enduml
