@startuml
!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

title Common Layered Architectures Compared\nThree established patterns for organizing layers

package "Three-Layer\nArchitecture" as TL $theme_surface {
  rectangle "**Presentation**\nViews, Controllers" as T3 $fill_primary
  rectangle "**Business**\nRules, Entities" as T2 $fill_ok
  rectangle "**Data**\nRepositories, Queries" as T1 $fill_caution

  T3 -[$line_primary]-> T2
  T2 -[$line_primary]-> T1
}

package "Clean Architecture\n(Robert Martin)" as CA $theme_surface {
  rectangle "**Frameworks**\nWeb, DB, Drivers" as C4 $fill_primary
  rectangle "**Interface Adapters**\nControllers, Gateways" as C3 $fill_ok
  rectangle "**Use Cases**\nApp Business Rules" as C2 $fill_caution
  rectangle "**Entities**\nEnterprise Rules" as C1 $fill_alt

  C4 -[$line_primary]-> C3
  C3 -[$line_primary]-> C2
  C2 -[$line_primary]-> C1
}

package "DDD Layers\n(Eric Evans)" as DDD $theme_surface {
  rectangle "**User Interface**\nPresentation" as D4 $fill_primary
  rectangle "**Application**\nCoordination" as D3 $fill_ok
  rectangle "**Domain**\nModel, Rules" as D2 $fill_caution
  rectangle "**Infrastructure**\nTechnical Services" as D1 $fill_alt

  D4 -[$line_primary]-> D3
  D3 -[$line_primary]-> D2
  D2 ..[$deep_neutral,dashed].> D1 : infra supports\nall layers
}

note bottom of TL
  Classic separation
  of concerns
end note

note bottom of CA
  Dependencies point
  **inward** toward entities
end note

note bottom of DDD
  Domain is protected;
  infra is pluggable
end note
@enduml
