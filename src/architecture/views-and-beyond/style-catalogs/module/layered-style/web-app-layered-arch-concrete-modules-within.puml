@startuml
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Web Application -- Layered Architecture Example\nConcrete modules within each layer

rectangle "**Presentation Layer**" as PRES $deep_primary {
  rectangle "Web\nControllers" as wc $fill_primary
  rectangle "View\nTemplates" as vt $fill_primary
  rectangle "Client-Side\nJavaScript" as js $fill_primary
  rectangle "API\nEndpoints" as api $fill_primary
}

rectangle "**Business Layer**" as BIZ $deep_ok {
  rectangle "Domain\nEntities" as de $fill_ok
  rectangle "Business\nServices" as bs $fill_ok
  rectangle "Validation\nRules" as vr $fill_ok
  rectangle "Workflow\nLogic" as wl $fill_ok
}

rectangle "**Data Layer**" as DATA $deep_caution {
  rectangle "Repositories" as repo $fill_caution
  rectangle "Data\nMappers" as dm $fill_caution
  rectangle "Query\nBuilders" as qb $fill_caution
  rectangle "Connection\nMgmt" as cm $fill_caution
}

wc -[$line_primary]-> bs : invokes
api -[$line_primary]-> bs : invokes
bs -[$line_primary]-> repo : reads/writes
bs -[$line_primary]-> de : uses
repo -[$line_primary]-> dm : maps
repo -[$line_primary]-> qb : queries
qb -[$line_primary]-> cm : connects

note right of PRES
  Handles HTTP requests
  and renders responses
end note

note right of DATA
  No upward dependencies:
  pure data access
end note
@enduml
