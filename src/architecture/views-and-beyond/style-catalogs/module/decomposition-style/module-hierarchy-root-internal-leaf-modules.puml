@startuml 01-module-hierarchy
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Module Hierarchy: Root, Internal, and Leaf Modules

rectangle "**System**\n(Root Module)" as root $fill_dynamic {

  rectangle "**Subsystem A**\n(Internal Module)" as subA $deep_primary {
    rectangle "Module A.1\n(Leaf)" as a1 $fill_primary
    rectangle "Module A.2\n(Leaf)" as a2 $fill_primary
    rectangle "Module A.3\n(Leaf)" as a3 $fill_primary
  }

  rectangle "**Subsystem B**\n(Internal Module)" as subB $deep_primary {

    rectangle "**Package B.1**\n(Internal Module)" as b1 $deep_dynamic {
      rectangle "Module B.1.1\n(Leaf)" as b11 $fill_primary
      rectangle "Module B.1.2\n(Leaf)" as b12 $fill_primary
    }

    rectangle "Module B.2\n(Leaf)" as b2 $fill_primary
  }

  rectangle "**Subsystem C**\n(Internal Module)" as subC $deep_primary {
    rectangle "Module C.1\n(Leaf)" as c1 $fill_primary
    rectangle "Module C.2\n(Leaf)" as c2 $fill_primary
  }
}

legend right
  |= Color |= Module Type |
  | <$fill_dynamic> | Root Module (entire system) |
  | <$deep_primary> | Internal Module (has children) |
  | <$fill_primary> | Leaf Module (directly implemented) |
end legend

@enduml
