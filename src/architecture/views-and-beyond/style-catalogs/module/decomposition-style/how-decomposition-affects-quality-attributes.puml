@startuml 09-quality-attributes
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title How Decomposition Affects Quality Attributes

rectangle "**Decomposition\nDecisions**" as center $line_primary;text:$theme_on_dark

rectangle "**Modifiability**\nLocalized changes\nInformation hiding\nInterface stability" as mod $fill_primary

rectangle "**Understandability**\nAppropriate granularity\nMeaningful groupings\nClear naming" as und $fill_dynamic

rectangle "**Testability**\nModule isolation\nClear interfaces\nLow coupling" as test $deep_dynamic

rectangle "**Reusability**\nCohesive modules\nGeneral interfaces\nMinimal dependencies" as reuse $deep_ok

rectangle "**Dev Efficiency**\nParallel development\nClear ownership\nTeam autonomy" as dev $fill_ok

rectangle "**Performance**\nModule boundary overhead\nCommunication patterns\nGranularity trade-offs" as perf $fill_caution

center -[$line_neutral,thickness=2]-> mod
center -[$line_neutral,thickness=2]-> und
center -[$line_neutral,thickness=2]-> test
center -[$line_neutral,thickness=2]-> reuse
center -[$line_neutral,thickness=2]-> dev
center -[$line_neutral,thickness=2]-> perf

note right of mod
  **Most important:**
  Good decomposition
  is the primary driver
  of modifiability.
end note

@enduml
