@startuml 08-common-patterns
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Common Decomposition Patterns

together {
  rectangle "**Layered**" as lay_t $line_primary;text:$theme_on_dark
  rectangle " " as lay $theme_surface {
    rectangle "Presentation" as l1 $fill_dynamic
    rectangle "Business Logic" as l2 $fill_primary
    rectangle "Data Access" as l3 $deep_dynamic
    l1 -[$line_neutral]-> l2
    l2 -[$line_neutral]-> l3
  }
  note bottom of lay
    Modules by
    abstraction level
  end note
}

together {
  rectangle "**Feature-Based**" as feat_t $line_primary;text:$theme_on_dark
  rectangle " " as feat $theme_surface {
    rectangle "Feature A" as f1 $fill_dynamic
    rectangle "Feature B" as f2 $fill_primary
    rectangle "Feature C" as f3 $deep_dynamic
  }
  note bottom of feat
    Modules per
    user-visible feature
  end note
}

together {
  rectangle "**Domain-Driven**" as ddd_t $line_primary;text:$theme_on_dark
  rectangle " " as ddd $theme_surface {
    rectangle "Bounded\nContext 1" as d1 $fill_dynamic
    rectangle "Bounded\nContext 2" as d2 $fill_primary
    d1 -[$line_neutral]-> d2 : interface
  }
  note bottom of ddd
    Modules per
    bounded context
  end note
}

together {
  rectangle "**Plugin**" as plug_t $line_primary;text:$theme_on_dark
  rectangle " " as plug $theme_surface {
    rectangle "Core" as p1 $fill_dynamic
    rectangle "Plugin A" as p2 $fill_primary
    rectangle "Plugin B" as p3 $deep_dynamic
    p2 -[$line_neutral]-> p1
    p3 -[$line_neutral]-> p1
  }
  note bottom of plug
    Core + extensible
    plugin points
  end note
}

together {
  rectangle "**Facade**" as fac_t $line_primary;text:$theme_on_dark
  rectangle " " as fac $theme_surface {
    rectangle "Facade" as fa1 $fill_dynamic
    rectangle "Internal A" as fa2 $fill_primary
    rectangle "Internal B" as fa3 $fill_primary
    fa1 -[$line_neutral]-> fa2
    fa1 -[$line_neutral]-> fa3
  }
  note bottom of fac
    Simplified interface
    to complex subsystem
  end note
}

lay_t -[hidden]right-> feat_t
feat_t -[hidden]right-> ddd_t
ddd_t -[hidden]right-> plug_t
plug_t -[hidden]right-> fac_t

@enduml
