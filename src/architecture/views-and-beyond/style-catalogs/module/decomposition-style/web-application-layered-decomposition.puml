@startuml 07-webapp-example
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Web Application: Layered Decomposition

rectangle "**Web Application System**" as root $deep_primary {

  rectangle "**Presentation Layer**" as pres $fill_neutral {
    rectangle "Web UI" as p1 $fill_primary
    rectangle "Mobile API" as p2 $fill_primary
    rectangle "Admin\nInterface" as p3 $fill_primary
    rectangle "Public API" as p4 $fill_primary
  }

  rectangle "**Business Logic Layer**" as biz $fill_ok {
    rectangle "User\nManagement" as b1 $deep_dynamic
    rectangle "Content\nManagement" as b2 $deep_dynamic
    rectangle "Analytics" as b3 $deep_dynamic
    rectangle "Notifications" as b4 $deep_dynamic
  }

  rectangle "**Data Access Layer**" as dal $deep_ok {
    rectangle "Repository\nImplementations" as d1 $fill_dynamic
    rectangle "Query\nServices" as d2 $fill_dynamic
    rectangle "Caching" as d3 $fill_dynamic
  }

  rectangle "**Infrastructure Layer**" as infra $fill_invalid {
    rectangle "Logging" as i1 $deep_invalid
    rectangle "Security" as i2 $deep_invalid
    rectangle "Configuration" as i3 $deep_invalid
  }
}

pres -[$line_neutral,dashed]-> biz : "  uses  "
biz -[$line_neutral,dashed]-> dal : "  uses  "
dal -[$line_neutral,dashed]-> infra : "  uses  "

legend right
  Decomposition criteria:
  **Technical layers** at top level
  **Domain modules** within
  Business Logic layer
end legend

@enduml
