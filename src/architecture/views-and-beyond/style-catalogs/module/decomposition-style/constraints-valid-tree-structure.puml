@startuml 05-constraints
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Decomposition Constraints: Valid Tree Structure

together {
  rectangle "**Valid Decomposition (Tree)**" as valid_title $theme_surface

  rectangle "System" as v_root $fill_dynamic {
    rectangle "Module A" as v_a $deep_primary {
      rectangle "A.1" as v_a1 $fill_primary
      rectangle "A.2" as v_a2 $fill_primary
    }
    rectangle "Module B" as v_b $deep_primary {
      rectangle "B.1" as v_b1 $fill_primary
      rectangle "B.2" as v_b2 $fill_primary
    }
  }

  note bottom of v_root
    **Constraints satisfied:**
    ✓ Acyclic (tree structure)
    ✓ Single parent per module
    ✓ Complete containment
    ✓ Leaf modules implemented directly
  end note
}

together {
  rectangle "**Invalid: Shared Module**" as invalid1_title $theme_surface

  rectangle "System" as i1_root $deep_invalid {
    rectangle "Module X" as i1_x $fill_invalid {
      rectangle "Shared?" as i1_s $deep_alt
    }
    rectangle "Module Y" as i1_y $fill_invalid {
    }
  }

  i1_y -[$line_invalid,dashed]-> i1_s : <color:$line_invalid>violates</color>\n<color:$line_invalid>single parent</color>

  note bottom of i1_root
    **Constraint violated:**
    ✗ Module cannot belong to
      two parents. Use utility
      module or dependency instead.
  end note
}

valid_title -[hidden]right-> invalid1_title

@enduml
