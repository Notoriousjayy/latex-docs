@startuml 03-decomposition-relation
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Decomposition Relation Semantics

together {

  rectangle "**Containment**" as cont_title $theme_surface

  rectangle "Parent Module" as p1 $deep_primary {
    rectangle "Child A" as c1a $fill_primary
    rectangle "Child B" as c1b $fill_primary
    rectangle "Child C" as c1c $fill_primary
  }

  note bottom of p1
    Children are wholly
    contained within parent.
    Single-parent constraint
    applies.
  end note

}

together {

  rectangle "**Responsibility Partition**" as resp_title $theme_surface

  rectangle "Order Management\n//responsibilities: R1..R6//" as p2 $deep_primary {
    rectangle "Order Entry\n//R1, R2//" as c2a $fill_primary
    rectangle "Fulfillment\n//R3, R4//" as c2b $fill_primary
    rectangle "Returns\n//R5, R6//" as c2c $fill_primary
  }

  note bottom of p2
    Parent responsibilities
    are distributed among
    children. Coverage should
    be complete.
  end note

}

together {

  rectangle "**Scope Restriction**" as scope_title $theme_surface

  rectangle "Data Access (broad scope)" as p3 $deep_primary {
    rectangle "SQL Repository\n(narrow scope)" as c3a $fill_primary
    rectangle "Cache Manager\n(narrow scope)" as c3b $fill_primary
    rectangle "Query Builder\n(narrow scope)" as c3c $fill_primary
  }

  note bottom of p3
    Each child's scope is a
    subset of the parent's
    scope.
  end note

}

cont_title -[hidden]right-> resp_title
resp_title -[hidden]right-> scope_title

@enduml
