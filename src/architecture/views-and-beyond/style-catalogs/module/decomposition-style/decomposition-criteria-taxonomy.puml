@startuml 04-decomposition-criteria
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Decomposition Criteria Taxonomy

rectangle "**Decomposition Criteria**" as root $line_dynamic;text:$theme_on_dark

rectangle "**Functional**" as func $deep_primary {
  rectangle "By Business\nCapability" as f1 $fill_primary
  rectangle "By Use Case\nor Feature" as f2 $fill_primary
}

rectangle "**Information Hiding**" as info $deep_primary {
  rectangle "By Design\nDecision" as i1 $fill_primary
  rectangle "By\nVolatility" as i2 $fill_primary
}

rectangle "**Data-Driven**" as data $deep_primary {
  rectangle "By Data\nEntity" as d1 $fill_primary
  rectangle "By Data\nStore" as d2 $fill_primary
}

rectangle "**Technical**" as tech $deep_primary {
  rectangle "By\nLayer" as t1 $fill_primary
  rectangle "By\nTechnology" as t2 $fill_primary
}

rectangle "**Organizational**" as org $deep_primary {
  rectangle "By\nTeam" as o1 $fill_primary
  rectangle "By Skill\nSet" as o2 $fill_primary
}

root -[$line_neutral,thickness=2]-> func
root -[$line_neutral,thickness=2]-> info
root -[$line_neutral,thickness=2]-> data
root -[$line_neutral,thickness=2]-> tech
root -[$line_neutral,thickness=2]-> org

note bottom of root
  Real decompositions typically
  combine criteria: e.g., business
  capability at top level, technical
  layers within each capability.
end note

@enduml
