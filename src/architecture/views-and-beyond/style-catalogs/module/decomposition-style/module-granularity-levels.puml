@startuml 02-module-granularity
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Module Granularity Levels

rectangle "**System Level**\nEntire software system\n(root of decomposition)" as sys $fill_primary {
  rectangle "  " as s_spacer $fill_primary
}

rectangle "**Subsystem Level**\nMajor functional areas\n(architectural boundaries)" as sub $deep_primary {
  rectangle "  " as sub_spacer $deep_primary
}

rectangle "**Package / Namespace Level**\nGrouped classes or components\n(language-level packaging)" as pkg $fill_dynamic {
  rectangle "  " as pkg_spacer $fill_dynamic
}

rectangle "**Class / Component Level**\nIndividual implementation units\n(OO or component-based)" as cls $deep_dynamic {
  rectangle "  " as cls_spacer $deep_dynamic
}

rectangle "**Function / Method Level**\nFinest granularity\n(typically below architectural scope)" as fn $fill_ok {
  rectangle "  " as fn_spacer $fill_ok
}

sys -[$line_neutral,thickness=2]-> sub : " decomposes into"
sub -[$line_neutral,thickness=2]-> pkg : " decomposes into"
pkg -[$line_neutral,thickness=2]-> cls : " decomposes into"
cls -[$line_neutral,thickness=2]-> fn : " decomposes into"

note right of sys
  Architectural documentation
  scope typically covers the
  top three to four levels.
end note

note right of fn
  Below the scope of
  architectural documentation
  in most systems.
end note

@enduml
