@startuml

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

title Module Types by Dependency Profile

package "Top-Level Modules" as TL $deep_caution {
  rectangle "UI Controller" as UI $fill_caution
  rectangle "CLI App" as CLI $fill_caution
}

package "Intermediate Modules" as IM $deep_ok {
  rectangle "Business Logic" as BL $fill_ok
  rectangle "Data Access" as DA $fill_ok
}

package "Foundation Modules" as FM $deep_primary {
  rectangle "Utility Library" as UL $fill_primary
  rectangle "Core Abstractions" as CA $fill_primary
}

rectangle "Isolated Module" as ISO $fill_alt

UI -down--> BL : <<uses>>
CLI -down--> BL : <<uses>>
BL -down--> DA : <<uses>>
BL -down--> CA : <<uses>>
DA -down--> UL : <<uses>>
DA -down--> CA : <<uses>>

note right of TL
  **High fan-out, zero fan-in**
  Entry points; nothing
  depends on them
end note

note right of FM
  **High fan-in, low fan-out**
  Stable foundation;
  many modules depend on them
end note

note right of ISO
  **Zero fan-in, zero fan-out**
  Independent; may indicate
  design issue or standalone utility
end note
@enduml
