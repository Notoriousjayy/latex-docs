@startuml

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

title Increment Planning: Development Sequencing via Uses Order

package "Increment 1 — Foundation" as I1 $deep_primary {
  rectangle "Config" as A $fill_primary
  rectangle "Logger" as B $fill_primary
}

package "Increment 2 — Core Services" as I2 $deep_ok {
  rectangle "User Store" as C $fill_ok
  rectangle "Crypto Lib" as D $fill_ok
}

package "Increment 3 — Business Logic" as I3 $deep_caution {
  rectangle "Auth Service" as E $fill_caution
  rectangle "Report Engine" as F $fill_caution
}

package "Increment 4 — User Interfaces" as I4 $deep_invalid {
  rectangle "Auth UI" as G $fill_invalid
  rectangle "Reporting" as H $fill_invalid
}

C -down-> A : <<uses>>
C -down-> B : <<uses>>
D -down-> A : <<uses>>
E -down-> C : <<uses>>
E -down-> D : <<uses>>
E -down-> B : <<uses>>
F -down-> C : <<uses>>
F -down-> B : <<uses>>
G -down-> E : <<uses>>
G -down-> B : <<uses>>
H -down-> F : <<uses>>

note as N1
  Each increment builds
  on prior increments.
  Dependencies always
  point downward to
  already-completed work.
end note
@enduml
