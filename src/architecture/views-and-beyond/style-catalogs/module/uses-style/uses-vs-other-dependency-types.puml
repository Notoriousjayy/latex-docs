@startuml
!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

title Uses vs. Other Dependency Types

package "Compile-Time Only — NOT uses" as CT $deep_caution {
  rectangle "module_a.c" as A1 $fill_caution
  rectangle "types.h" as T1 $fill_caution
  A1 -right-> T1 : <<includes>>\nneeds type defs,\nnot behavior
}

package "Functional Dependency — IS uses" as FD $deep_ok {
  rectangle "OrderService" as A2 $fill_ok
  rectangle "PaymentGateway" as T2 $fill_ok
  A2 -right-> T2 : <<uses>>\nrequires correct\npayment processing
}

package "Creation Only — NOT uses" as CW $deep_primary {
  rectangle "Factory" as A3 $fill_primary
  rectangle "WidgetType" as T3 $fill_primary
  A3 -right-> T3 : <<creates>>\ninstantiates type,\nnot behavior
}

package "Inheritance — depends on context" as IH $deep_alt {
  rectangle "ChildClass" as A4 $fill_alt
  rectangle "ParentClass" as T4 $fill_alt
  A4 -right-> T4 : <<extends>>\nuses only if correctness\ndepends on parent
}

CT -[hidden]down- FD
FD -[hidden]down- CW
CW -[hidden]down- IH

note as N1
  **Key Test:** Could A satisfy
  its requirements if B were
  absent or incorrect?
  If not, A **uses** B.
end note
@enduml
