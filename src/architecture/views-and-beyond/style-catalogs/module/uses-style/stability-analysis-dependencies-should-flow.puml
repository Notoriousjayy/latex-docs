@startuml

!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Stability Analysis: Dependencies Should Flow Toward Stability

rectangle "**Volatile Module**\nFan-in=1, Fan-out=3\nI = 3/(1+3) = 0.75" as VM $fill_invalid
rectangle "**Intermediate Module**\nFan-in=2, Fan-out=2\nI = 2/(2+2) = 0.50" as IM $fill_caution
rectangle "**Stable Module**\nFan-in=4, Fan-out=0\nI = 0/(4+0) = 0.00" as SM $fill_ok

rectangle "Client A" as CA $fill_primary
rectangle "Client B" as CB $fill_primary

rectangle "Dep X" as DX $fill_primary
rectangle "Dep Y" as DY $fill_primary
rectangle "Dep Z" as DZ $fill_primary

CA -down-> IM : <<uses>>
CB -down-> IM : <<uses>>
VM -down-> DX : <<uses>>
VM -down-> DY : <<uses>>
VM -down-> DZ : <<uses>>
IM -down-> SM : <<uses>>
VM -down-> SM : <<uses>>
CA -down-> SM : <<uses>>
CB -down-> SM : <<uses>>

note as GOOD $deep_ok
  **Good:** Dependencies flow
  toward stable modules (I ≈ 0).
  Changes to stable modules
  are rare → low ripple effect.
end note

note as BAD $deep_invalid
  **Violation:** If a stable module
  were to depend on a volatile
  module, changes would propagate
  to all of its dependents.
end note
@enduml
