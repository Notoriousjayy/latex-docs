@startuml

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

title Example: Web Application Uses Structure

package "Presentation Layer" as PL $deep_caution {
  rectangle "User Controller" as UC $fill_caution
  rectangle "Admin Controller" as AC $fill_caution
}

package "Service Layer" as SL $deep_ok {
  rectangle "User Service" as US $fill_ok
  rectangle "Order Service" as OS $fill_ok
}

package "Domain Model" as DM $deep_primary {
  rectangle "User Entity" as UE $fill_primary
  rectangle "Order Entity" as OE $fill_primary
}

package "Repository Layer" as RL $deep_alt {
  rectangle "User Repository" as UR $fill_alt
  rectangle "Order Repository" as OR $fill_alt
}

package "Infrastructure" as IL $deep_dynamic {
  rectangle "DB Access" as DB $fill_dynamic
  rectangle "Logging" as LG $fill_dynamic
}

UC -down-> US : <<uses>>
UC -down-> LG : <<uses>>
AC -down-> US : <<uses>>
AC -down-> OS : <<uses>>
US -down-> UE : <<uses>>
US -down-> UR : <<uses>>
OS -down-> OE : <<uses>>
OS -down-> OR : <<uses>>
OS -down-> US : <<uses>>
UR -down-> DB : <<uses>>
OR -down-> DB : <<uses>>
UR -down-> LG : <<uses>>
OR -down-> LG : <<uses>>

note as N1
  **Analysis**
  Largely acyclic and layered.
  Infrastructure = foundation (high fan-in).
  Controllers = top-level (zero fan-in).
  Development proceeds bottom-up.
end note
@enduml
