@startuml

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

title Four Common Uses Patterns

package "Layered Pattern" as LP {
  rectangle "Presentation" as L1 $fill_caution
  rectangle "Business" as L2 $fill_ok
  rectangle "Data Access" as L3 $fill_primary
  L1 -down-> L2
  L2 -down-> L3
}

package "Core-Periphery Pattern" as CP {
  rectangle "Plugin A" as PA $fill_caution
  rectangle "Plugin B" as PB $fill_caution
  rectangle "Plugin C" as PC $fill_caution
  rectangle " Core " as CORE $fill_primary
  PA -down-> CORE
  PB -down-> CORE
  PC -down-> CORE
}

package "Pipeline Pattern" as PP {
  rectangle "Stage 1" as S1 $fill_primary
  rectangle "Stage 2" as S2 $fill_ok
  rectangle "Stage 3" as S3 $fill_caution
  S3 -left-> S2
  S2 -left-> S1
}

package "Hub Pattern" as HP {
  rectangle "Mod X" as MX $fill_ok
  rectangle "Mod Y" as MY $fill_ok
  rectangle "Mod Z" as MZ $fill_ok
  rectangle " Hub " as HUB $fill_invalid
  HUB -down-> MX
  HUB -down-> MY
  HUB -down-> MZ
}

note bottom of LP
  Acyclic; flows
  strictly downward
end note

note bottom of CP
  High fan-in core;
  periphery is independent
end note

note bottom of PP
  Linear chain;
  fan-in and fan-out of 1
end note

note bottom of HP
  Centralizes coordination;
  hub has high fan-out
end note
@enduml
