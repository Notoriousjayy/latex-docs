@startuml

!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Common Aspect Patterns

rectangle "**Tracing**" as trace $deep_caution {
  rectangle "before: log entry + args\nafter: log result or exception" as trace_d $fill_caution
}

rectangle "**Security**" as secpat $fill_invalid {
  rectangle "before: check authn / authz\naround: suppress if unauthorized" as sec_d $deep_invalid
}

rectangle "**Transaction**" as txpat $fill_ok {
  rectangle "around: begin tx, proceed,\ncommit on success / rollback on fail" as tx_d $deep_ok
}

rectangle "**Caching**" as cachepat $fill_alt {
  rectangle "around: check cache, return if hit\nproceed and store if miss" as cache_d $fill_primary
}

rectangle "**Retry**" as retrypat $deep_alt {
  rectangle "around: catch transient failures\nretry with backoff until limit" as retry_d $fill_dynamic
}

rectangle "**Validation**" as valpat $deep_primary {
  rectangle "before: validate preconditions\nafter: validate postconditions" as val_d $deep_dynamic
}

trace -[hidden]right-> secpat
secpat -[hidden]right-> txpat
cachepat -[hidden]right-> retrypat
retrypat -[hidden]right-> valpat
trace -[hidden]down-> cachepat

note as legend
  Each pattern encapsulates a common crosscutting
  concern using specific **advice types**.
end note

@enduml
