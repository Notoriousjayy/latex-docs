@startuml

!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Aspect Weaving Mechanisms

rectangle "**Compile-Time Weaving**" as ctw $fill_primary {
  rectangle "Source Code\n+ Aspects" as ct_in $deep_primary
  rectangle "Aspect\nCompiler\n(e.g. ajc)" as ct_comp $theme_surface
  rectangle "Woven\nBytecode" as ct_out $fill_ok

  ct_in -right-> ct_comp
  ct_comp -right-> ct_out
}

rectangle "**Load-Time Weaving**" as ltw $fill_primary {
  rectangle "Compiled\nBytecode" as lt_in $deep_primary
  rectangle "Class Loader\nAgent" as lt_comp $theme_surface
  rectangle "Woven\nClasses" as lt_out $fill_ok

  lt_in -right-> lt_comp
  lt_comp -right-> lt_out
}

rectangle "**Runtime Weaving**" as rtw $fill_primary {
  rectangle "Running\nObjects" as rt_in $deep_primary
  rectangle "Proxy\nFactory" as rt_comp $theme_surface
  rectangle "Dynamic\nProxies" as rt_out $fill_ok

  rt_in -right-> rt_comp
  rt_comp -right-> rt_out
}

ctw -[hidden]down-> ltw
ltw -[hidden]down-> rtw

note right of ctw
  Full optimization.
  Requires aspect-aware build.
  e.g. AspectJ compiler
end note

note right of ltw
  No recompilation needed.
  JVM agent intercepts loading.
  e.g. AspectJ LTW
end note

note right of rtw
  Maximum flexibility.
  Higher runtime overhead.
  e.g. Spring AOP, JDK proxies
end note

@enduml
