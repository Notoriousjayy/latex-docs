@startuml

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

title The Crosscutting Problem: Scattering and Tangling

package "OrderService" as os $theme_surface {
  rectangle "Business Logic" as os_bl $fill_primary
  rectangle "Logging" as os_log $deep_caution
  rectangle "Security" as os_sec $fill_invalid
  rectangle "Transaction" as os_tx $fill_ok
}

package "PaymentService" as ps $theme_surface {
  rectangle "Business Logic" as ps_bl $fill_primary
  rectangle "Logging" as ps_log $deep_caution
  rectangle "Security" as ps_sec $fill_invalid
  rectangle "Transaction" as ps_tx $fill_ok
}

package "InventoryService" as inv $theme_surface {
  rectangle "Business Logic" as inv_bl $fill_primary
  rectangle "Logging" as inv_log $deep_caution
  rectangle "Security" as inv_sec $fill_invalid
  rectangle "Transaction" as inv_tx $fill_ok
}

note bottom of ps
  **Code Scattering**: Logging, Security, and Transaction
  code is duplicated across every module.
  **Code Tangling**: Each module mixes business
  logic with crosscutting concerns.
end note

legend bottom right
  |= Color |= Concern |
  |<$fill_primary> | Core Business Logic |
  |<$deep_caution> | Logging (scattered) |
  |<$fill_invalid> | Security (scattered) |
  |<$fill_ok> | Transaction (scattered) |
end legend

@enduml
