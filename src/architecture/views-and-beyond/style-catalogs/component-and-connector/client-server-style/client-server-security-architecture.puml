@startuml

title Client-Server Security Architecture

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

rectangle "Client" as CLIENT $fill_primary {
    rectangle "Credentials" as CRED $deep_primary
}

package "Security Boundary" {
    rectangle "TLS Termination" as TLS $fill_invalid
    rectangle "Authentication" as AUTH $fill_invalid
    rectangle "Authorization" as AUTHZ $fill_invalid
    rectangle "Input Validation" as VAL $fill_invalid
    rectangle "Rate Limiting" as RATE $fill_invalid
}

rectangle "Server" as SERVER $fill_ok {
    rectangle "Business Logic" as BL $deep_ok
}

rectangle "Data Store" as DATA $fill_caution {
    rectangle "Encrypted at Rest" as EAR $deep_caution
}

rectangle "Audit Log" as AUDIT $fill_invalid

CLIENT --> TLS : HTTPS
TLS --> AUTH : Decrypt
AUTH --> AUTHZ : Identity
AUTHZ --> RATE : Permissions
RATE --> VAL : Throttle
VAL --> SERVER : Sanitized

SERVER --> DATA : Access
SERVER ..> AUDIT : Log events

note right of AUTH
  Methods:
  Password, API Keys
  OAuth/OIDC, mTLS
end note

note right of AUTHZ
  Models:
  RBAC, ABAC
  Policy-based
end note

note bottom of VAL
  All client input must be
  validated on the server
end note

legend right
  |= Layer |= Purpose |
  | <$fill_invalid> | Security Control |
  | <$fill_primary> | Client |
  | <$fill_ok> | Server |
  | <$fill_caution> | Data |
endlegend
@enduml
