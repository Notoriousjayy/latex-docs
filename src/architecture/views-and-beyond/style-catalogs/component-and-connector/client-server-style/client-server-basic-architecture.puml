@startuml

!include ../../../../../../tooling/styles/plantuml/structural/deployment-diagram-style.iuml

title Client-Server Basic Architecture

rectangle "Client Zone" {
    component "Client A" as CA
    component "Client B" as CB
    component "Client C" as CC
}

cloud "Request/Reply\nConnector" as CONN

rectangle "Server Zone" $fill_ok {
    component "Server" as S $fill_ok
}

CA --> CONN : request
CB --> CONN : request
CC --> CONN : request
CONN --> S : forward

S --> CONN : reply
CONN ..> CA
CONN ..> CB
CONN ..> CC

note bottom of S
  Server waits for requests,
  processes them, and
  returns results
end note

note top of CA
  Clients initiate
  interactions
end note

legend right
  |= Symbol |= Meaning |
  | <$fill_primary> | Client |
  | <$fill_ok> | Server |
  | <$fill_caution> | Connector |
endlegend
@enduml
