@startuml

title Client-Server Tiered Architecture Patterns

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

package "Two-Tier" {
    rectangle "Client\n(Presentation + Logic)" as C2 $fill_primary
    rectangle "Database Server" as D2 $fill_ok
    
    C2 --> D2 : SQL/ODBC
}

note bottom of C2
  Simple but limited:
  logic in clients
end note

package "Three-Tier" {
    rectangle "Client\n(Presentation)" as C3 $fill_primary
    rectangle "App Server\n(Business Logic)" as A3 $fill_caution
    rectangle "Database\n(Data)" as D3 $fill_ok
    
    C3 --> A3 : HTTP/API
    A3 --> D3 : SQL
}

note bottom of A3
  Enterprise web
  app foundation
end note

package "N-Tier" {
    rectangle "Web Tier" as W $fill_alt
    rectangle "API Tier" as API $fill_primary
    rectangle "Service Tier" as SVC $fill_caution
    rectangle "Integration" as INT $fill_invalid
    rectangle "Data Tier" as DATA $fill_ok
    
    W --> API
    API --> SVC
    SVC --> INT
    SVC --> DATA
}

note bottom of SVC
  Additional tiers add
  separation but also
  complexity
end note

legend right
  |= Tier |= Color |
  | Presentation | <$fill_primary> |
  | Application | <$fill_caution> |
  | Data | <$fill_ok> |
  | Web | <$fill_alt> |
  | Integration | <$fill_invalid> |
endlegend
@enduml
