@startuml

title Scalability and Deployment Patterns

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

package "Clients" {
    rectangle "Client 1" as C1 $fill_primary
    rectangle "Client 2" as C2 $fill_primary
    rectangle "Client N" as CN $fill_primary
}

package "Edge" {
    rectangle "CDN Cache" as CDN $fill_alt
}

rectangle "Load Balancer" as LB $fill_caution

package "Application Tier" {
    rectangle "Server 1" as S1 $fill_ok
    rectangle "Server 2" as S2 $fill_ok
    rectangle "Server N" as SN $fill_ok
}

package "Cache Tier" {
    rectangle "Redis/Memcached" as CACHE $fill_alt
}

package "Data Tier" {
    rectangle "Primary DB" as PDB $fill_invalid
    rectangle "Read Replica" as RDB $fill_invalid
}

C1 --> CDN
C2 --> CDN
CN --> CDN

CDN --> LB

LB --> S1 : round-robin
LB --> S2 : least-conn
LB --> SN : weighted

S1 --> CACHE
S2 --> CACHE
SN --> CACHE

CACHE --> PDB : cache miss
S1 --> RDB : reads
S2 --> RDB : reads
SN --> PDB : writes

PDB ..> RDB : replicate

note bottom of LB
  Strategies: Round-robin
  Least connections, Weighted
  Session affinity
end note

note right of CACHE
  Cache reduces
  DB load and latency
end note

note bottom of PDB
  Write to primary
  Read from replicas
end note

legend right
  |= Component |= Purpose |
  | <$fill_caution> | Load Balancer |
  | <$fill_ok> | App Server |
  | <$fill_alt> | Cache |
  | <$fill_invalid> | Database |
endlegend
@enduml
