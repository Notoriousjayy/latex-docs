@startuml

title Client and Server Component Types

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

package "Client Components" {
    rectangle "Thin Client\n<size:9>(Browser-based, UI only)</size>" as TC $fill_primary
    rectangle "Thick Client\n<size:9>(Desktop app, local logic)</size>" as ThC $deep_primary
    rectangle "Rich Client\n<size:9>(Balanced, offline capable)</size>" as RC $deep_dynamic
    rectangle "Headless Client\n<size:9>(Batch/Agent, no UI)</size>" as HC $fill_dynamic
    rectangle "Mobile Client\n<size:9>(Intermittent, limited)</size>" as MC $deep_neutral
    rectangle "Server as Client\n<size:9>(Multi-tier consumer)</size>" as SC $fill_neutral
}

package "Server Components" {
    rectangle "Web Server\n<size:9>(HTTP/HTTPS, static)</size>" as WS $fill_ok
    rectangle "Application Server\n<size:9>(Business logic)</size>" as AS $deep_ok
    rectangle "Database Server\n<size:9>(Data storage)</size>" as DS $deep_caution
    rectangle "API Server\n<size:9>(REST/GraphQL)</size>" as APIS $fill_caution
    rectangle "Cache Server\n<size:9>(Fast access)</size>" as CS $deep_invalid
    rectangle "Auth Server\n<size:9>(Identity/Authorization)</size>" as AUS $fill_invalid
}

TC -[hidden]r- ThC
ThC -[hidden]r- RC
RC -[hidden]r- HC
HC -[hidden]r- MC
MC -[hidden]r- SC

WS -[hidden]r- AS
AS -[hidden]r- DS
DS -[hidden]r- APIS
APIS -[hidden]r- CS
CS -[hidden]r- AUS
@enduml
