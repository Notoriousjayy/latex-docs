@startuml

title Error Handling and Resilience Patterns

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

package "Client-Side Resilience" {
    rectangle "Timeout\nHandling" as TO $fill_caution
    rectangle "Retry with\nBackoff" as RET $fill_caution
    rectangle "Fallback\nBehavior" as FB $fill_caution
    
    TO -r-> RET : failure
    RET -r-> FB : exhausted
}

package "Circuit Breaker Pattern" {
    rectangle "Closed\n(Normal)" as CLOSED $deep_ok
    rectangle "Open\n(Fast Fail)" as OPEN $fill_invalid
    rectangle "Half-Open\n(Test)" as HALF $deep_caution
    
    CLOSED --> CLOSED : success
    CLOSED --> OPEN : failures
    OPEN --> HALF : timeout
    HALF --> CLOSED : probe ok
    HALF --> OPEN : probe fail
}

package "Server-Side Resilience" {
    rectangle "Graceful\nDegradation" as GD $fill_ok
    rectangle "Bulkhead\nIsolation" as BH $fill_ok
    rectangle "Health\nChecks" as HC $fill_ok
    
    GD -r-> BH
    BH -r-> HC
}

note bottom of GD : Partial functionality\nduring partial failures
note bottom of BH : Isolate failures\nprevent cascade
note bottom of HC : LB detects\nfailures

package "Error Response" {
    rectangle "Client" as EC $fill_primary
    rectangle "Server" as ES $fill_ok
    rectangle "Error" as ER $deep_invalid
    
    EC --> ES : request
    ES --> ER : failure
    ER --> EC : code + msg
}

note bottom of ER
  HTTP status, Error code
  Message, Correlation ID
  (No internal details)
end note
@enduml
