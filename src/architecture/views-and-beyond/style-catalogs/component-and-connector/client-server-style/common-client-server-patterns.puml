@startuml

title Common Client-Server Patterns

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

package "API Gateway Pattern" {
    rectangle "Web Client" as WC1 $fill_primary
    rectangle "Mobile Client" as MC1 $fill_primary
    rectangle "API Gateway" as GW $fill_caution
    rectangle "Service A" as SA1 $fill_ok
    rectangle "Service B" as SB1 $fill_ok
    rectangle "Service C" as SC1 $fill_ok
    
    WC1 --> GW
    MC1 --> GW
    GW --> SA1
    GW --> SB1
    GW --> SC1
}
note bottom of GW : Single entry point\nAuth, routing, rate limiting

package "Backend for Frontend (BFF)" {
    rectangle "Web App" as WC2 $fill_primary
    rectangle "Mobile App" as MC2 $fill_primary
    rectangle "Web BFF" as WBFF $fill_alt
    rectangle "Mobile BFF" as MBFF $fill_alt
    rectangle "Core Services" as CORE $fill_ok
    
    WC2 --> WBFF
    MC2 --> MBFF
    WBFF --> CORE
    MBFF --> CORE
}
note bottom of WBFF : Dedicated backends\nfor each client type

package "Service Mesh" {
    rectangle "Service X" as SX $fill_ok
    rectangle "Proxy X" as PX $fill_invalid
    rectangle "Service Y" as SY $fill_ok
    rectangle "Proxy Y" as PY $fill_invalid
    rectangle "Control Plane" as CP $fill_caution
    
    SX - PX
    SY - PY
    PX <--> PY : mTLS
    CP ..> PX : config
    CP ..> PY : config
}
note bottom of CP : Sidecar proxies\nhandle communication

legend right
  |= Component |= Color |
  | Client | <$fill_primary> |
  | Gateway | <$fill_caution> |
  | Service | <$fill_ok> |
  | BFF | <$fill_alt> |
  | Mesh/Proxy | <$fill_invalid> |
endlegend
@enduml
