@startuml

title Data Accessor Component Types\nClassified by read/write patterns

!include ../../../../../../tooling/styles/plantuml/structural/deployment-diagram-style.iuml

database "Shared\nRepository" as repo

rectangle "Data Producers" $deep_ok {
    [Data Entry\nApplication] as entry $fill_ok
    [ETL\nProcess] as etl $fill_ok
    [Event\nCollector] as events $fill_ok
}

rectangle "Data Consumers" $deep_primary {
    [Reporting\nTool] as report $fill_primary
    [Analytics\nEngine] as analytics $fill_primary
    [Dashboard\nUI] as dashboard $fill_primary
}

rectangle "Data Transformers" $fill_alt {
    [Data Quality\nProcessor] as quality $deep_alt
    [Aggregation\nJob] as aggregation $deep_alt
}

rectangle "Interactive Applications" $fill_caution {
    [Business\nApplication] as bizapp $deep_caution
    [CRUD\nService] as crud $deep_caution
}

rectangle "Background Processes" $fill_dynamic {
    [Maintenance\nJob] as maintenance $deep_dynamic
    [Sync\nAgent] as sync $deep_dynamic
}

entry --> repo : write
etl --> repo
events --> repo

repo --> report : read
repo --> analytics
repo --> dashboard

repo <--> quality : read/write
repo <--> aggregation

repo <--> bizapp : bidirectional
repo <--> crud

repo <..> maintenance : scheduled
repo <..> sync

legend right
  | Color | Access Pattern |
  |<$deep_ok>| Write-only |
  |<$deep_primary>| Read-only |
  |<$fill_alt>| Transform (R/W) |
  |<$fill_caution>| Interactive |
  |<$fill_dynamic>| Background |
endlegend

@enduml
