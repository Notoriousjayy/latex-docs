@startuml

title Shared-Data Architectural Style\nData-centric communication through shared repository

!include ../../../../../../tooling/styles/plantuml/structural/deployment-diagram-style.iuml

database "Shared Data\nRepository" as repo $fill_caution

rectangle "Data Producers" as producers $fill_ok {
    [Producer A\n(Data Entry)] as prodA
    [Producer B\n(ETL Process)] as prodB
    [Producer C\n(Event Collector)] as prodC
}

rectangle "Data Consumers" as consumers $fill_primary {
    [Consumer X\n(Reporting)] as consX
    [Consumer Y\n(Analytics)] as consY
    [Consumer Z\n(API Service)] as consZ
}

prodA --> repo : writes
prodB --> repo : writes
prodC --> repo : writes

repo --> consX : reads
repo --> consY : reads
repo --> consZ : reads

note bottom of repo
  Key Characteristic:
  Producers and consumers
  communicate indirectly
  through the shared repository
end note

legend right
  | Color | Meaning |
  |<$fill_ok>| Data Producer |
  |<$fill_primary>| Data Consumer |
  |<$fill_caution>| Repository |
endlegend

@enduml
