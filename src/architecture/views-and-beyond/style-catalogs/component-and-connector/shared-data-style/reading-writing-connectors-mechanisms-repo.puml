@startuml

title Data Reading and Writing Connectors\nMechanisms for repository access

!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

rectangle "Database Connectors" as dbconn $deep_primary {
    rectangle "JDBC / ODBC" as jdbc $fill_primary
    rectangle "Native Drivers" as native $fill_primary
    rectangle "ORM\n(Hibernate, EF)" as orm $fill_primary
    rectangle "Connection Pool" as pool $fill_primary
}

rectangle "Query Connectors" as queryconn $deep_ok {
    rectangle "SQL" as sql $fill_ok
    rectangle "GraphQL" as graphql $fill_ok
    rectangle "Full-Text Search" as fts $fill_ok
    rectangle "Custom DSL" as dsl $fill_ok
}

rectangle "File Connectors" as fileconn $deep_caution {
    rectangle "File System API" as fsapi $fill_caution
    rectangle "NFS / SMB" as nfs $fill_caution
    rectangle "S3 API" as s3 $fill_caution
}

rectangle "Streaming Connectors" as streamconn $deep_alt {
    rectangle "CDC\n(Change Data Capture)" as cdc $fill_alt
    rectangle "Event Streaming\n(Kafka, Kinesis)" as kafka $fill_alt
    rectangle "Real-Time Sync" as realtime $fill_alt
}

note right of dbconn
  Transaction Support
  ACID guarantees
  Connection management
end note

note right of queryconn
  Query Language
  Structured queries
  Flexible retrieval
end note

note right of fileconn
  Bulk Access
  Large file transfer
  Binary data
end note

note right of streamconn
  Continuous Flow
  Real-time updates
  Event-driven
end note

legend bottom
  Connectors provide the communication layer
  with specific protocols and capabilities
endlegend

@enduml
