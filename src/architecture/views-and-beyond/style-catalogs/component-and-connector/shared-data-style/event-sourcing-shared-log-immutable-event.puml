@startuml

!include ../../../../../../tooling/styles/plantuml/structural/deployment-diagram-style.iuml

title Event Sourcing with Shared Log\nImmutable event stream as source of truth

[Order\nService] as orderSvc $fill_ok
[Inventory\nService] as invSvc $fill_ok
[Notification\nService] as notifSvc $fill_ok

rectangle "Event Log (Immutable)" as eventLog $deep_caution {
    queue "Event 1:\nOrderCreated" as e1 $fill_caution
    queue "Event 2:\nPaymentReceived" as e2 $fill_caution
    queue "Event 3:\nItemShipped" as e3 $fill_caution
    queue "Event N:\n..." as en $fill_caution
}

database "Orders\nProjection" as ordersView $fill_primary
database "Inventory\nProjection" as invView $fill_primary
database "Analytics\nProjection" as analyticsView $fill_primary

orderSvc --> eventLog : Append events
invSvc --> eventLog : Append events
notifSvc --> eventLog : Subscribe

eventLog --> ordersView : Project
eventLog --> invView : Project
eventLog --> analyticsView : Project

note bottom of eventLog
  Immutable Event Store
  Append-only operations
  Complete audit trail
  Replay capability
end note

note right of ordersView
  Derived State
  Each projection builds
  its own view by
  replaying relevant events
end note

legend bottom
  Events are the source of truth;
  current state is derived by replaying event history
endlegend

@enduml
