@startuml

!include ../../../../../../tooling/styles/plantuml/structural/deployment-diagram-style.iuml

title Data Lake Pattern\nCentralized raw data for diverse analytics

rectangle "Data Sources" as sources $deep_primary {
    database "Operational\nDatabases" as opdb $fill_dynamic
    [Application\nLogs] as logs $fill_dynamic
    [IoT\nSensors] as iot $fill_dynamic
    [External\nFeeds] as external $fill_dynamic
}

cloud "Data Lake" as lake $fill_caution {
    rectangle "Raw Zone\n(Landing)" as raw $deep_caution
    rectangle "Curated Zone\n(Cleaned)" as curated $fill_invalid
    rectangle "Refined Zone\n(Aggregated)" as refined $deep_invalid
}

rectangle "Analytics Consumers" as consumers $deep_dynamic {
    [SQL\nEngine] as sql $fill_primary
    [Spark\nJobs] as spark $fill_primary
    [ML\nPlatform] as ml $fill_primary
    [BI\nTools] as bi $fill_primary
}

rectangle "Data Governance" as governance $deep_alt {
    [Catalog] as catalog $fill_alt
    [Access\nControl] as access $fill_alt
    [Lineage] as lineage $fill_alt
}

opdb --> raw : Batch/CDC
logs --> raw : Stream
iot --> raw : Stream
external --> raw : API

raw --> curated : Clean & Validate
curated --> refined : Transform

curated --> sql
curated --> spark
refined --> ml
refined --> bi

governance ..> lake

note bottom of lake
  Schema-on-Read
  Store raw data in native format
  Interpret schema at query time
end note

legend right
  | Zone | Purpose |
  | Raw | Original data as-is |
  | Curated | Cleaned, validated |
  | Refined | Business-ready |
endlegend

@enduml
