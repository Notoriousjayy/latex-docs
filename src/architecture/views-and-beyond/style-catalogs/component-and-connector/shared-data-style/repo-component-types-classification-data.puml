@startuml

title Repository Component Types\nClassification by data model and structure

!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

rectangle "Structured Data" as structured $deep_primary {
    database "Relational DB\n(PostgreSQL, MySQL)" as relational $fill_primary
    database "Wide-Column\n(Cassandra, HBase)" as widecolumn $fill_primary
    database "Time-Series\n(InfluxDB, TimescaleDB)" as timeseries $fill_primary
}

rectangle "Semi-Structured Data" as semistructured $deep_ok {
    database "Document DB\n(MongoDB, CouchDB)" as document $fill_ok
    database "Key-Value\n(Redis, DynamoDB)" as keyvalue $fill_ok
    database "Graph DB\n(Neo4j, Neptune)" as graph $fill_ok
}

rectangle "Unstructured Data" as unstructured $deep_caution {
    database "Object Store\n(S3, Azure Blob)" as object $fill_caution
    database "File System\n(HDFS, NFS)" as filesystem $fill_caution
    database "Data Lake\n(Delta Lake, Iceberg)" as datalake $fill_caution
}

rectangle "Caching Layer" as caching $fill_invalid {
    database "In-Memory Grid\n(Hazelcast, Ignite)" as inmemory $fill_alt
}

note right of structured
  ACID transactions
  Strong consistency
  Schema enforcement
end note

note right of semistructured
  Flexible schema
  Horizontal scaling
  Eventual consistency
end note

note right of unstructured
  Any format
  Massive scale
  Schema-on-read
end note

note right of caching
  Low latency
  Distributed state
end note

legend bottom
  Select repository type based on data model,
  consistency requirements, and query patterns
endlegend

@enduml
