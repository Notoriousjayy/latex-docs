@startuml

title Enterprise Application Pattern\nMultiple accessors sharing single database

!include ../../../../../../tooling/styles/plantuml/structural/deployment-diagram-style.iuml

database "Enterprise Database" as db $deep_caution {
    rectangle "Customers" as tblCust $fill_caution
    rectangle "Orders" as tblOrders $fill_caution
    rectangle "Products" as tblProducts $fill_caution
    rectangle "Inventory" as tblInv $fill_caution
}

rectangle "Interactive Applications" as interactive $deep_primary {
    [Web\nApplication] as webapp $fill_primary
    [Mobile\nApp] as mobile $fill_primary
    [Admin\nPortal] as admin $fill_primary
}

rectangle "Background Processing" as background $deep_ok {
    [Batch\nJobs] as batch $fill_ok
    [Scheduled\nReports] as reports $fill_ok
}

rectangle "Integration Layer" as integration $deep_alt {
    [Partner\nAPI] as partnerApi $fill_alt
    [Data\nExport] as export $fill_alt
}

webapp --> db : CRUD
mobile --> db : CRUD
admin --> db : Admin ops

batch --> db : Bulk\nprocessing
reports --> db : Read-only\nqueries

partnerApi --> db : API queries
export --> db : Extract

note right of db
  Single Source of Truth
  ACID transactions
  Referential integrity
  Shared schema
end note

note bottom of interactive
  Benefits: Consistency, SQL joins, familiar tooling
  Challenges: Bottleneck risk, schema coupling
end note

legend bottom
  Traditional enterprise architecture with
  centralized relational database
endlegend

@enduml
