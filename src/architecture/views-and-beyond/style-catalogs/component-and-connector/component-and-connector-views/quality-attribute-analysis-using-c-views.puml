@startuml 10-quality-attribute-analysis
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Quality Attribute Analysis Using C&C Views

rectangle "Quality Attribute Analysis Areas" {
    
    rectangle "**Performance Analysis**" as perf $fill_primary {
        note as n1
          • Data flow paths → latency
          • Processing locations → throughput
          • Concurrency → parallelization
          • Resource sharing → bottlenecks
        end note
    }
    
    rectangle "**Availability Analysis**" as avail $fill_ok {
        note as n2
          • Single points of failure
          • Redundancy structures
          • Failure detection paths
          • Recovery mechanisms
        end note
    }
    
    rectangle "**Security Analysis**" as sec $fill_invalid {
        note as n3
          • Trust boundaries
          • Attack surfaces
          • Sensitive data flows
          • Access control points
        end note
    }
    
    rectangle "**Modifiability Analysis**" as mod $fill_caution {
        note as n4
          • Component coupling
          • Interface stability
          • Cohesion assessment
          • Extension points
        end note
    }
    
    rectangle "**Scalability Analysis**" as scale $fill_alt {
        note as n5
          • Stateless vs stateful
          • Bottleneck identification
          • Partitionability
          • Replication potential
        end note
    }
}

perf -[hidden]r-> avail
avail -[hidden]r-> sec
mod -[hidden]r-> scale

legend bottom
  C&C views reveal runtime structure that enables
  reasoning about system quality attributes.
endlegend

@enduml
