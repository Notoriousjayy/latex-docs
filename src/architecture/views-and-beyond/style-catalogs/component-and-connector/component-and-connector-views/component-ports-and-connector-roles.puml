@startuml 11-ports-and-roles
!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

title Component Ports and Connector Roles

package "Port Types" as ports {
    component "Component with Ports" as cp {
        portin "Required\n(consumes)" as req
        portout "Provided\n(offers)" as prov
        port "Bidirectional" as bi
    }
}

package "Connector Roles" as roles {
    rectangle "Request/Reply Connector" as rr $fill_caution {
        card "caller\nrole" as caller $fill_invalid
        card "callee\nrole" as callee $fill_ok
        caller --> callee : request
        callee --> caller : reply
    }
    
    rectangle "Publish/Subscribe Connector" as ps $fill_caution {
        card "publisher\nrole" as pub $fill_invalid
        card "subscriber\nrole" as sub1 $fill_ok
        card "subscriber\nrole" as sub2 $fill_ok
        pub --> sub1 : event
        pub --> sub2 : event
    }
}

note bottom of cp
  **Port Characteristics**
  • Type (protocol, data format)
  • Direction (in/out/bidirectional)
  • Multiplicity (how many connections)
  • Quality properties
end note

note bottom of rr
  **Role Characteristics**
  • Type of participation
  • Direction of flow
  • Multiplicity of participants
  • Protocol constraints
end note

@enduml
