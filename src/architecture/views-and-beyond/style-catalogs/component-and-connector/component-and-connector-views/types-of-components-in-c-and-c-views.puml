@startuml 02-component-types
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Types of Components in C&C Views

rectangle "Component Types" as main {
    
    rectangle "**Processing Component**\n\nPerforms computation\nTransforms inputs to outputs\nImplements business logic" as proc $fill_primary {
    }
    
    rectangle "**Data Store Component**\n\nMaintains persistent state\nProvides storage/retrieval\nShared data repository" as data $fill_ok {
    }
    
    rectangle "**Controller Component**\n\nManages system behavior\nCoordinates other components\nResponds to events" as ctrl $fill_caution {
    }
    
    rectangle "**Interface Component**\n\nHandles external interaction\nUser interfaces\nSystem interfaces" as intf $fill_invalid {
    }
    
    rectangle "**Composite Component**\n\nContains subarchitecture\nExposes unified interface\nHierarchical decomposition" as comp $fill_alt {
    }
}

proc -[hidden]right-> data
data -[hidden]right-> ctrl
ctrl -[hidden]down-> intf
intf -[hidden]left-> comp

legend right
  |= Type |= Primary Role |
  | Processing | Computation |
  | Data Store | State management |
  | Controller | Coordination |
  | Interface | External interaction |
  | Composite | Hierarchical structure |
endlegend

@enduml
