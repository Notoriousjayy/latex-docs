@startuml 03-connector-types
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Types of Connectors in C&C Views

rectangle "Connector Types" {
    
    together {
        rectangle "**Procedure Call**\n\nRequest/reply interaction\nSynchronous invocation\n\n//Local calls, RPC,//\n//Method invocation//" as proc $fill_caution {
        }
        
        rectangle "**Event**\n\nPublish-subscribe\nAsynchronous notification\n\n//Event bus, Message queue,//\n//Notification service//" as event $fill_ok {
        }
        
        rectangle "**Data Access**\n\nInteraction with data stores\nRead/write/query operations\n\n//Database, File system,//\n//Memory access//" as data $fill_primary {
        }
    }
    
    together {
        rectangle "**Stream**\n\nContinuous data flow\nSequence of data items\n\n//Pipes, Sockets,//\n//Data streams//" as stream $fill_invalid {
        }
        
        rectangle "**Arbitrator**\n\nCoordinates shared access\nManages concurrency\n\n//Locks, Semaphores,//\n//Transaction managers//" as arb $fill_alt {
        }
    }
    
    together {
        rectangle "**Adaptor**\n\nTranslates interfaces\nFormat conversion\n\n//Protocol adapter,//\n//Data transformer//" as adapt $deep_primary {
        }
        
        rectangle "**Distributor**\n\nRoutes interactions\nDirects to handlers\n\n//Load balancer, Router,//\n//Dispatcher//" as dist $deep_caution {
        }
    }
}

proc -[hidden]r-> event
event -[hidden]r-> data
stream -[hidden]r-> arb
adapt -[hidden]r-> dist

legend bottom
  Connectors define **how** components interact.
  Each type supports different interaction patterns.
endlegend

@enduml
