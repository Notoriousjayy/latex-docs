@startuml 05-client-server-style
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Client-Server Architectural Style

package "Clients" as clients {
    component "Web Client" as wc $fill_primary
    component "Mobile Client" as mc $fill_primary
    component "Desktop Client" as dc $fill_primary
}

package "Server Tier" as servers {
    component "Application\nServer" as app $fill_ok {
        portin "API" as api
    }
    
    database "Database\nServer" as db $deep_caution
}

rectangle "Request/Reply\nConnector" as rr1 $fill_caution
rectangle "Request/Reply\nConnector" as rr2 $fill_caution
rectangle "Request/Reply\nConnector" as rr3 $fill_caution
rectangle "Data Access\nConnector" as da $fill_caution

wc --> rr1 : request
mc --> rr2 : request
dc --> rr3 : request

rr1 --> api
rr2 --> api
rr3 --> api

app --> da
da --> db

note right of clients
  **Clients**
  - Initiate requests
  - Present responses
  - Stateless interaction
end note

note right of servers
  **Servers**
  - Handle requests
  - Provide responses
  - May be clients to other servers
end note

legend bottom
  |= Element |= Role |= Characteristics |
  | Client | Requester | Initiates interaction, receives results |
  | Server | Provider | Processes requests, returns responses |
  | Connector | Request/Reply | Synchronous, asymmetric roles |
endlegend

@enduml
