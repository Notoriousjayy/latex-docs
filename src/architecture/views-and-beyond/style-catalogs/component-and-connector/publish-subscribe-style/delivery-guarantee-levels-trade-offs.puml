@startuml

title Delivery Guarantee Levels\nTrade-offs between reliability, performance, and complexity

!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

component "At-Most-Once\n================\nFire and forget\n\n* Events may be lost\n* No retries\n* Fastest option\n* Simplest implementation\n\nGood for: Metrics,\nnon-critical updates" as AMO $deep_ok

component "At-Least-Once\n================\nAcknowledge + Retry\n\n* Events may be duplicated\n* Requires acknowledgment\n* Retries unacked events\n* Needs idempotent handlers\n\nGood for: Most\nbusiness events" as ALO $deep_caution

component "Exactly-Once\n================\nTransactional / Dedupe\n\n* Each event delivered once\n* Most complex\n* Highest latency\n* Requires coordination\n\nGood for: Financial\ntransactions" as EO $deep_primary

AMO -right-> ALO : "+ reliability"
ALO -right-> EO : "+ reliability"

@enduml
