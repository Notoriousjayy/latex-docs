@startuml

title Event Structure Anatomy\nKey components of a well-designed event

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

package "EVENT" {
    component "HEADERS\n(Routing & Processing)\n====================\nContent-Type\nCorrelation-ID\nPartition-Key\nPriority" as H $deep_caution
    
    component "METADATA\n(Identity & Context)\n====================\nEvent ID (unique)\nEvent Type/Topic\nTimestamp\nSource Identifier\nSchema Version" as M $deep_primary
    
    component "PAYLOAD\n(Domain Data)\n====================\nBusiness-specific\ncontent structured\naccording to\nevent schema" as P $deep_ok
}

note right of H
  Used by connector
  for routing decisions
end note

note right of M
  Identifies the event
  and its origin
end note

note right of P
  The "what happened"
  domain information
end note

H -[hidden]down- M
M -[hidden]down- P

@enduml
