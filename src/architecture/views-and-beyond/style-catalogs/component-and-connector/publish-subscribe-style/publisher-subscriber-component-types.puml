@startuml

title Publisher and Subscriber Component Types\nClassification by data production and consumption patterns

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

package "PUBLISHER TYPES" {
    component "Event Source\n-----------\nGenerates events\n(sensors, UI controls)" as P1 $deep_primary
    component "State-Change Publisher\n-----------\nAnnounces state\nmodifications" as P2 $deep_primary
    component "Command Result Publisher\n-----------\nReports operation\noutcomes" as P3 $deep_primary
    component "Aggregating Publisher\n-----------\nConsolidates\nmultiple sources" as P4 $deep_primary
    component "Bridge Publisher\n-----------\nRepublishes from\nexternal systems" as P5 $deep_primary
}

package "SUBSCRIBER TYPES" {
    component "Event Handler\n-----------\nPerforms actions\nin response" as S1 $deep_ok
    component "Event Processor\n-----------\nTransforms events,\nmay republish" as S2 $deep_ok
    component "Event Logger\n-----------\nPersists for\naudit/replay" as S3 $deep_ok
    component "Event Aggregator\n-----------\nComputes summaries,\ndetects patterns" as S4 $deep_ok
    component "UI Component\n-----------\nUpdates displays\nin real-time" as S5 $deep_ok
}

@enduml
