@startuml

title Publish-Subscribe Connector Types\nDifferent mechanisms for event routing and distribution

!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

package "Topic-Based Connector" {
    component "Publisher" as TP $deep_primary
    component "Topic\nRouter" as TR $deep_caution
    component "Sub A\n(topic: orders)" as TS1 $deep_ok
    component "Sub B\n(topic: orders)" as TS2 $deep_ok
    
    TP -right-> TR : "orders/*"
    TR -right-> TS1
    TR -right-> TS2
}

note bottom of TR
  Routes by named topics
  Most common pattern
end note

package "Content-Based Connector" {
    component "Publisher" as CP $deep_primary
    component "Content\nMatcher" as CM $deep_caution
    component "Sub X\n(price > 100)" as CS1 $deep_ok
    component "Sub Y\n(region = US)" as CS2 $deep_ok
    
    CP -right-> CM : "event data"
    CM -right-> CS1
    CM -right-> CS2
}

note bottom of CM
  Routes by predicates
  on event content
end note

package "Type-Based Connector" {
    component "Publisher" as YP $deep_primary
    component "Type\nHierarchy" as TH $deep_caution
    component "Sub M\n(PaymentEvent)" as YS1 $deep_ok
    component "Sub N\n(Event)" as YS2 $deep_ok
    
    YP -right-> TH : "RefundEvent"
    TH -right-> YS1
    TH -right-> YS2
}

note bottom of TH
  Routes by event type
  inheritance hierarchy
end note

@enduml
