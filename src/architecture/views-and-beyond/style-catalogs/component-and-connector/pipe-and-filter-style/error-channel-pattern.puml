@startuml
' Error Channel Pattern
' Shows separate paths for normal data and error handling

!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml
!include pipe-and-filter-roles.iuml

title Error Channel Pattern

rectangle "Main Pipeline" $fill_ok {
    [Source] <<source>> as Source
    [Filter A] <<transformer>> as FilterA
    [Filter B] <<transformer>> as FilterB
    [Sink] <<sink>> as Sink
}

rectangle "Error Channel" $fill_invalid {
    [Error\nHandler] <<e>> as ErrorHandler
    [Error\nLog] <<e>> as ErrorLog
}

Source -right-> FilterA : "data"
FilterA -right-> FilterB : "valid data"
FilterB -right-> Sink : "processed"

FilterA -[$line_invalid]down-> ErrorHandler : "errors"
FilterB -[$line_invalid]down-> ErrorHandler : "errors"
ErrorHandler -[$line_invalid]right-> ErrorLog : "logged"
note bottom of ErrorHandler
    Errors routed separately
    from main data flow
end note

legend right
  |= Flow |= Meaning |
  | <$line_primary> ──→ | Normal data |
  | <$deep_invalid> ──→ | Error data |
endlegend

@enduml
