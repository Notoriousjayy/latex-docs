@startuml
' Execution Models: Push vs Pull
' Contrasts data flow control mechanisms

!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml
!include pipe-and-filter-roles.iuml

title Execution Models: Push vs Pull

rectangle "Push-Based Execution" $fill_primary {
    component "Producer" as PushProd <<source>>
    component "Consumer" as PushCons <<sink>>
    
    PushProd -[$line_primary]right-> PushCons : "**push(data)**"
    note bottom of PushProd
        Producer controls rate
        "I have data for you"
    end note
}

rectangle "Pull-Based Execution" $fill_caution {
    component "Producer" as PullProd <<source>>
    component "Consumer" as PullCons <<sink>>
    
    PullCons -[$line_invalid]left-> PullProd : "**request()**"
    PullProd -[$line_invalid]right-> PullCons : "**data**"
    note bottom of PullCons
        Consumer controls rate
        "Give me next item"
    end note
}

legend bottom
    **Push**: Natural for streaming sources (sensors, events)
    **Pull**: Natural for demand-driven processing (lazy evaluation)
endlegend

@enduml
