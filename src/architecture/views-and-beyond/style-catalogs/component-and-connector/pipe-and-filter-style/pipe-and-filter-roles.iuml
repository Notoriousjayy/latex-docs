' ======================================================================
'  pipe-and-filter-roles.iuml
'  Domain-role helper for the pipe-and-filter style catalogue.
' ----------------------------------------------------------------------
'  This is a DOMAIN include, not a style entry point: every diagram in
'  this directory still includes the shared component leaf first and
'  then this file. It maps the catalogue's filter-role stereotypes
'  (which are the teaching content and stay visible on the elements)
'  onto house role tokens so the colours come from one palette.
'
'  role          house token   rationale
'  source        primary       the producer that starts the flow
'  transformer   ok            the ordinary healthy filter
'  splitter      dynamic       fan-out / routing behaviour
'  aggregator    alt           fan-in / cross-cutting join
'  sink          caution       terminal consumer, draws the eye last
'  tee           neutral       passive duplication side channel
'  error         invalid       error channel / failure path
'
'  Before this migration the same mapping lived in plantuml-config.puml
'  as raw hex skinparams applied through -config, which bypassed the
'  shared palette and could not use the tokens.
' ======================================================================

!ifndef PIPE_AND_FILTER_ROLES_INCLUDED
!define PIPE_AND_FILTER_ROLES_INCLUDED

<style>
componentDiagram {
  component {
    .source { BackgroundColor $fill_primary ; LineColor $line_primary }
    .transformer { BackgroundColor $fill_ok ; LineColor $line_ok }
    .splitter { BackgroundColor $fill_dynamic ; LineColor $line_dynamic }
    .aggregator { BackgroundColor $fill_alt ; LineColor $line_alt }
    .sink { BackgroundColor $fill_caution ; LineColor $line_caution }
    .tee { BackgroundColor $fill_neutral ; LineColor $line_neutral }
    .error { BackgroundColor $fill_invalid ; LineColor $line_invalid }
    .e { BackgroundColor $fill_invalid ; LineColor $line_invalid }
  }
}
</style>

' Legend rows for the roles a diagram uses; call after the elements.
!unquoted procedure PF_LEGEND_ROLE($role, $meaning)
  !if ($role == "source")
  |<$fill_primary>   | <<source>> $meaning |
  !elseif ($role == "transformer")
  |<$fill_ok>   | <<transformer>> $meaning |
  !elseif ($role == "splitter")
  |<$fill_dynamic>   | <<splitter>> $meaning |
  !elseif ($role == "aggregator")
  |<$fill_alt>   | <<aggregator>> $meaning |
  !elseif ($role == "sink")
  |<$fill_caution>   | <<sink>> $meaning |
  !elseif ($role == "tee")
  |<$fill_neutral>   | <<tee>> $meaning |
  !else
  |<$fill_invalid>   | <<error>> $meaning |
  !endif
!endprocedure

!endif
