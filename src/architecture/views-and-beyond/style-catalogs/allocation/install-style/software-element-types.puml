@startuml

!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Software Element Types

rectangle "Software Elements" as main $theme_surface {
    
    together {
        card "Executables\n\nCompiled binaries\nInterpreted scripts\nBytecode files" as exec $fill_primary
        card "Libraries\n\nShared (.so, .dll)\nStatic (.a, .lib)\nManaged assemblies" as libs $fill_primary
    }
    
    together {
        card "Configuration\n\nXML, JSON, YAML\nINI, properties\nFeature flags" as config $fill_caution
        card "Data Files\n\nLookup tables\nTemplates\nML models" as data $fill_caution
    }
    
    together {
        card "Resources\n\nImages, icons\nFonts, stylesheets\nJS bundles" as res $fill_ok
        card "Documentation\n\nUser manuals\nAPI docs\nLicense, readme" as docs $fill_ok
    }
    
    together {
        card "Runtime Generated\n\nLog files\nCache files\nTemporary data" as runtime $fill_invalid
        card "Plugins\n\nOptional extensions\nDynamically loaded\nFeature modules" as plugins $fill_invalid
    }
}

note right of exec
  Primary entry points
  for system functionality
end note

note right of config
  Controls behavior
  without code changes
end note

note right of runtime
  Created during
  system operation
end note

center footer Purpose: Classify artifacts by type to guide installation location decisions
@enduml
