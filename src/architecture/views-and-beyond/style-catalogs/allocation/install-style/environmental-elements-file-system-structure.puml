@startuml

!include ../../../../../../tooling/styles/plantuml/structural/deployment-diagram-style.iuml

title Environmental Elements: File System Structure\n(Unix/Linux FHS Convention)

folder "/" as root $fill_dynamic {
    folder "/usr\nread-only programs" as usr $fill_primary {
        folder "bin/" as usrbin
        folder "lib/" as usrlib
        folder "share/" as usrshare
    }
    
    folder "/etc\nconfiguration" as etc $fill_caution {
        folder "myapp/" as etcapp
        folder "myapp.d/" as etcappd
    }
    
    folder "/var\nvariable data" as var $fill_ok {
        folder "log/" as varlog
        folder "cache/" as varcache
        folder "lib/" as varlib
    }
    
    folder "/opt\noptional packages" as opt $fill_alt {
        folder "myapp/" as optapp
    }
    
    folder "/home\nuser directories" as home $fill_invalid {
        folder "user/" as homeuser {
            folder ".config/" as dotconfig
            folder ".local/" as dotlocal
        }
    }
}

note right of usr
  Static content
  Shared across system
  Read-only at runtime
end note

note right of var
  Dynamic content
  Modified during operation
  Logs, caches, state
end note

note right of home
  Per-user content
  User-specific config
  No admin required
end note

legend bottom
  |= Location |= Purpose |= Permission |
  | /usr | System programs | Read-only |
  | /etc | System config | Admin write |
  | /var | Runtime data | App write |
  | /opt | Add-on packages | Self-contained |
  | ~/.config | User config | User write |
endlegend

center footer Key Principle: Follow platform conventions for discoverability and tool integration
@enduml
