@startuml

!include ../../../../../../tooling/styles/plantuml/structural/deployment-diagram-style.iuml

title Common Installation Patterns

rectangle "Single-Directory\nSelf-contained" as single $fill_primary {
    folder "/opt/myapp/" as s1 {
        folder "bin/" as s1bin
        folder "lib/" as s1lib
        folder "etc/" as s1etc
        folder "data/" as s1data
    }
}
note bottom of single
  + Portable
  + Easy uninstall
  - No system integration
end note

rectangle "Distributed\nPlatform-integrated" as dist $deep_caution {
    folder "/usr/bin/" as d1 $fill_caution
    folder "/usr/lib/" as d2 $fill_caution
    folder "/etc/myapp/" as d3 $fill_caution
    folder "/var/lib/myapp/" as d4 $fill_caution
}
note bottom of dist
  + Follows conventions
  + Package manager support
  - Complex uninstall
end note

rectangle "User-Space\nNo admin required" as user $fill_ok {
    folder "~/.local/" as u1 {
        folder "bin/" as u1bin
        folder "lib/" as u1lib
    }
    folder "~/.config/myapp/" as u2
}
note bottom of user
  + No privileges needed
  + Per-user isolation
  - Duplication
end note

rectangle "Layered (Container)\nImmutable layers" as layer $fill_alt {
    rectangle "Layer 3: App" as l3 $deep_alt
    rectangle "Layer 2: Dependencies" as l2 $fill_neutral
    rectangle "Layer 1: Runtime" as l1 $fill_alt
    rectangle "Layer 0: Base OS" as l0 $theme_surface
    
    l3 -[hidden]down- l2
    l2 -[hidden]down- l1
    l1 -[hidden]down- l0
}
note bottom of layer
  + Reproducible
  + Efficient sharing
  - Layer complexity
end note

rectangle "Side-by-Side\nVersion coexistence" as sxs $deep_invalid {
    folder "/opt/myapp-1.0/" as v1 $fill_invalid
    folder "/opt/myapp-2.0/" as v2 $fill_invalid
    folder "/opt/myapp-2.1/" as v3 $deep_neutral
}
note bottom of sxs
  + Safe upgrades
  + Rollback support
  - Disk usage
end note

center footer Selection Criteria: Choose pattern based on deployment context, platform requirements, and operational needs
@enduml
