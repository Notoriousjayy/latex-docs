@startuml

!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

title Quality Attributes Affected by Installation Decisions

rectangle "Install\nDecisions" as center $deep_primary

rectangle "Security" as sec $fill_invalid {
    card "Permission structure\nSensitive file protection\nSeparation of concerns\nAudit capability" as secd $deep_invalid
}

rectangle "Modifiability" as mod $fill_ok {
    card "Config externalization\nPlugin architecture\nUpdate isolation\nVersion coexistence" as modd $deep_ok
}

rectangle "Portability" as port $fill_primary {
    card "Relative paths\nPlatform abstraction\nContainerization\nNo hardcoded paths" as portd $fill_dynamic
}

rectangle "Performance" as perf $fill_caution {
    card "File locality\nFile system selection\nLoading efficiency\nStartup optimization" as perfd $deep_caution
}

rectangle "Reliability" as rel $fill_alt {
    card "Integrity verification\nCorruption isolation\nRecovery support\nGraceful degradation" as reld $deep_alt
}

rectangle "Usability" as use $deep_dynamic {
    card "Discoverability\nConvention compliance\nDocs accessibility\nClean uninstall" as used $fill_neutral
}

center -[$line_invalid]-> sec
center -[$line_ok]-> mod
center -[$line_primary]-> port
center -[$line_invalid]-> perf
center -[$line_alt]-> rel
center -[$line_dynamic]-> use

center footer Key Insight: Installation architecture impacts multiple quality attributes - consider tradeoffs early
@enduml
