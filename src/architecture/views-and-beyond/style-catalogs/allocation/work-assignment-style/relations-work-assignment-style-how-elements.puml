@startuml 03-relations
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

skinparam nodesep 40
skinparam ranksep 35

title <b>Relations in the Work Assignment Style</b>\nHow Elements Connect and Interact

rectangle "Module A" as mod_a <<sw>>
rectangle "Module B" as mod_b <<sw>>
rectangle "Module C" as mod_c <<sw>>

rectangle "Team Alpha" as team_a <<org>>
rectangle "Team Beta" as team_b <<org>>
rectangle "Platform Team" as team_p <<org>>

rectangle "Engineering\nDirector" as dir <<mgmt>>

mod_a -[$line_primary,bold]-> team_a : <b>allocated-to</b>\n//development//
mod_b -[$line_primary,bold]-> team_b : <b>allocated-to</b>\n//ownership//
mod_c -[$line_primary,bold]-> team_p : <b>allocated-to</b>\n//maintenance//

team_a -[$line_alt,dashed]-> dir : reports-to
team_b -[$line_alt,dashed]-> dir : reports-to
team_p -[$line_alt,dashed]-> dir : reports-to

team_a <-[$line_ok,dotted]-> team_b : collaborates-with

team_p -[$line_caution,dotted]-> team_a : supports
team_p -[$line_caution,dotted]-> team_b : supports

mod_a -[$line_dynamic]-> mod_c : depends-on
mod_b -[$line_dynamic]-> mod_c : depends-on

legend right
  |= Relation |= Meaning |
  | allocated-to | Responsibility assignment |
  | reports-to | Management hierarchy |
  | collaborates-with | Team coordination |
  | supports | Service provision |
  | depends-on | Software dependency |
endlegend

@enduml
