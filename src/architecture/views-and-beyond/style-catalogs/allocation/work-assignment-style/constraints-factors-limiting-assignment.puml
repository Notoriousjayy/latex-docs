@startuml 08-constraints
!include ../../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml

skinparam nodesep 30

title <b>Work Assignment Constraints</b>\nFactors Limiting Assignment Decisions

rectangle "Work Assignment\nDecisions" as center $fill_primary

hexagon "**One Module,\nOne Owner**\nClear accountability" as owner
hexagon "**Skill\nMatching**\nCapabilities align" as skill
hexagon "**Capacity**\nEffort <= Available" as capacity
hexagon "**Communication\nOverhead**\nTeam size limits" as comm
hexagon "**Geographic/\nTime Zone**\nCollaboration windows" as geo
hexagon "**Contractual/\nLegal**\nExternal constraints" as legal

owner -[$line_primary]-> center
skill -[$line_primary]-> center
capacity -[$line_primary]-> center
comm -[$line_primary]-> center
geo -[$line_primary]-> center
legal -[$line_primary]-> center

note bottom of center
  All constraints must be satisfied
  for valid work assignment
end note

note right of capacity
  Brooks's Law: Adding people
  increases communication cost
end note

note left of skill
  Gaps addressed by:
  training, hiring, contractors
end note

@enduml
