@startuml 10-allocated-to-properties
!include ../../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml

skinparam nodesep 30

title <b>The Allocated-To Relation</b>\nProperties of Work Assignment

rectangle "Software\nElement" as sw <<sw>>
rectangle "Organizational\nElement" as org <<org>>

sw -[$line_primary,bold,thickness=3]-> org : <b>allocated-to</b>

package "Responsibility Type" as resp <<prop>> {
    rectangle "Development" as dev $fill_ok
    rectangle "Maintenance" as maint $fill_ok
    rectangle "Ownership" as own $fill_ok
    rectangle "Review" as rev $fill_ok
    rectangle "Support" as supp $fill_ok
}

package "Exclusivity" as excl <<prop>> {
    rectangle "Exclusive" as exclusive $fill_caution
    rectangle "Shared" as shared $fill_caution
    rectangle "Primary/Secondary" as primsec $fill_caution
}

package "Duration" as dur <<prop>> {
    rectangle "Permanent" as perm $fill_alt
    rectangle "Project-based" as proj $fill_alt
    rectangle "Temporary" as temp $fill_alt
    rectangle "Rotational" as rot $fill_alt
}

package "Authority Level" as auth <<prop>> {
    rectangle "Full Authority" as full $fill_primary
    rectangle "Consultative" as consult $fill_primary
    rectangle "Escalation Required" as escal $fill_primary
}

note bottom
  The allocated-to relation answers:
  <b>"Who is responsible for this module?"</b>
end note

@enduml
