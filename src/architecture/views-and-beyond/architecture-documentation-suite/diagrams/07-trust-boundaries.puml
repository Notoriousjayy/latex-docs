@startuml
!include ../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml
title Trust Boundaries | Proposed agent harness
actor "Untrusted user / content" as U
rectangle "Application authority boundary" {
 [E-01 Authenticated API] as API
 [E-09 Core + E-15 Context] as O
 [E-11 Policy] as P
 [E-13 Approval verifier] as A
 [E-12 Broker] as B
 database "E-03 Tenant state" as S
 database "E-04 Redacted audit" as L
}
rectangle "Isolated execution boundary" {
 [E-05 Sandbox] as X
}
cloud "E-06 Model provider" as M
cloud "E-07 External resource" as T
U --> API : task / authenticate
API --> O : tenant-bound task
O --> M : minimized context
M --> O : untrusted proposal
O --> P : evaluate action
O --> B : candidate + identity
B --> P : recheck / fail closed
B --> A : scoped approval check
B --> X : scoped capability / enforced dispatch
X --> T : allowlisted egress
O --> S : tenant-scoped checkpoint
O --> L : redacted events
B --> L : dispatch evidence
legend bottom
Directed arrow = initiating interaction; nesting = stated logical or deployment boundary.
Status: proposed, not implementation evidence.
endlegend
@enduml
