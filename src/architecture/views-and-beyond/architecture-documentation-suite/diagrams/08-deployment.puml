@startuml
!include ../../../../../tooling/styles/plantuml/structural/deployment-diagram-style.iuml
title Deployment | Proposed agent harness
node "Production / proposed" {
 node "Ingress workload" {
  artifact "E-01 API instance" as API
 }
 node "Worker workload" {
  artifact "E-02 Worker instance" as W
 }
 node "Isolated execution workload" {
  artifact "E-05 Sandbox instance" as X
 }
 node "Data service" {
  database "E-03 State instance" as S
 }
 node "Audit service" {
  database "E-04 Audit instance" as A
 }
}
cloud "External E-06 provider" as M
cloud "External E-07 resource" as T
API --> S : authenticated create / approve
API --> A : append redacted approval event
W --> S : workload identity / checkpoint
W --> A : append redacted event
W --> X : scoped execution request
W --> M : controlled egress
X --> T : allowlisted egress
legend bottom
Directed arrow = initiating interaction; nesting = stated logical or deployment boundary.
Status: proposed, not implementation evidence.
endlegend
@enduml
