@startuml
!include ../../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml
title Modules | Proposed agent harness
package "domain" as D {
 [Run state / policy contracts] as CORE
 [Ports] as P
}
package "application" as AP {
 [Orchestrator] as O
 [Broker] as B
}
package "adapters" as AD {
 [Model / storage / telemetry adapters] as A
}
O ..> CORE : imports
O ..> P : imports
B ..> P : imports
A ..> P : implements / imports
O ..> B : imports
legend bottom
Dashed arrow = static implementation dependency; nesting = package ownership.
Status: proposed, not implementation evidence.
endlegend
@enduml
