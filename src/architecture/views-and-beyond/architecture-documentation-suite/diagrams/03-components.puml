@startuml
!include ../../../../../tooling/styles/plantuml/structural/component-diagram-style.iuml
title Components | Proposed agent harness
rectangle "E-02 Worker" {
 component "E-09 Orchestration core" as O
 component "E-10 Model adapter" as M
 component "E-11 Policy engine" as P
 component "E-12 Tool broker" as B
 component "E-13 Approval verifier" as A
 component "E-14 State adapter" as S
 component "E-15 Context builder" as C
 component "E-16 Telemetry" as L
}
rectangle "E-05 Sandbox" as X
rectangle "E-06 Model provider" as MP
O --> C : assemble typed context
O --> M : request structured proposal
M --> MP : inference request
O --> P : evaluate canonical action
O --> B : submit validated action
B --> P : re-evaluate at dispatch
B --> A : verify required approval
B --> X : scoped execution
O --> S : conditional checkpoint
O --> L : emit redacted event
B --> L : emit dispatch outcome
legend bottom
Directed arrow = initiating interaction; nesting = stated logical or deployment boundary.
Status: proposed, not implementation evidence.
endlegend
@enduml
