@startuml
!include ../../../../../tooling/styles/plantuml/c4/container-diagram-style.iuml
title Containers | Proposed agent harness
actor "User / approver" as U
rectangle "SYS-01 Harness" {
 rectangle "E-01 API\n[Application]" as API
 rectangle "E-02 Worker\n[Application]" as W
 database "E-03 State\n[Data store]" as S
 database "E-04 Audit\n[Data store]" as A
 rectangle "E-05 Sandbox\n[Application]" as X
}
rectangle "E-06 Model provider\n[External system]" as M
rectangle "E-07 Resource service\n[External system]" as T
U --> API : submit / approve, HTTPS
API --> S : create task / persist approval
W --> S : claim / checkpoint
W --> M : request proposal, HTTPS
W --> X : scoped dispatch
X --> T : authorized request
W --> A : redacted event
API --> A : approval event
legend bottom
Directed arrow = initiating interaction; nesting = stated logical or deployment boundary.
Status: proposed, not implementation evidence.
endlegend
@enduml
