@startuml software-system-container-view
' ------------------------------------------------------------------
' Diagram   : Software System - Container View (teaching example)
' Type      : C4 Container diagram (C4-PlantUML, house c4 style)
' Model kind: C4 container view (see src/architecture/readme.md, AD index)
' Owns      : Shows which applications and data stores make up a generic
'             layered software system and how they communicate.
' Subject   : Reference pattern - there is no implemented system behind
'             this view. Element names are illustrative; no technology is
'             stated because none is known, so every Container carries
'             "technology not specified" rather than an invented stack.
' Status    : approved teaching example (target-state style is not implied)
' History   : Migrated 2026-09 from a UML component/package sketch that
'             included the UML *deployment* leaf under the block name
'             "architecture-overview". Layers became C4 containers because
'             the picture answers "what applications and data stores make
'             up the system", not "which nodes host which artifacts".
' ------------------------------------------------------------------
!include ../../../tooling/styles/plantuml/c4/container-diagram-style.iuml

C4_TITLE(Generic Layered Software System, teaching example - illustrative elements)

Person(user, "End User", "Uses the system through a web, mobile or command-line client")

System_Boundary(system, "Software System (in scope)") {
  Container(web, "Web Application", "technology not specified", "Browser-facing user interface")
  Container(mobile, "Mobile App", "technology not specified", "Handset user interface")
  Container(cli, "CLI Tool", "technology not specified", "Scripting and administration interface")
  Container(gateway, "REST API Gateway", "technology not specified", "Single entry point; authenticates callers and routes requests")
  Container(graphql, "GraphQL Service", "technology not specified", "Query interface for the web application")
  Container(core, "Core Services", "technology not specified", "Business logic; orchestrates domain logic and events")
  Container(events, "Event Processor", "technology not specified", "Handles asynchronous domain events")
  ContainerDb(db, "Primary Database", "PostgreSQL", "System of record")
  ContainerDb(cache, "Cache", "Redis", "Read-through cache for hot data")
  ContainerQueue(mq, "Message Queue", "technology not specified", "Buffers domain events")
}

System_Ext(storage, "Cloud Storage", "Object storage for files and exports")
System_Ext(auth, "Auth Provider", "External identity provider")

Rel(user, web, "Uses", "HTTPS")
Rel(user, mobile, "Uses")
Rel(user, cli, "Runs")
Rel(web, gateway, "Calls", "protocol not specified")
Rel(web, graphql, "Queries", "GraphQL")
Rel(mobile, gateway, "Calls", "protocol not specified")
Rel(cli, gateway, "Calls", "protocol not specified")
Rel(gateway, core, "Forwards requests")
Rel(graphql, core, "Resolves through")
Rel(core, events, "Raises domain events")
Rel(core, db, "Reads / writes")
Rel(core, cache, "Reads / writes")
Rel(events, mq, "Publishes / consumes")
Rel(core, storage, "Stores files", "protocol not specified")
Rel(gateway, auth, "Validates identity", "protocol not specified")

SHOW_LEGEND()
@enduml
