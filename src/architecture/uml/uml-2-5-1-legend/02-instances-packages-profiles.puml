@startuml
' Source block: uml251_02_instances_packages_profiles (uml-2.5.1-legend.puml intake)
!include ../../../../tooling/styles/plantuml/structural/package-diagram-style.iuml
' ============================================================================
' Section 02 — InstanceSpecifications, Packages, Profiles
'
' UML traceability:
'   UML 2.5.1 §9.8 Instances
'   UML 2.5.1 §12.2 Packages
'   UML 2.5.1 §12.3 Profiles
'
' Support:
'   Object / instance notation: Native
'   Packages and package dependencies: Native/Partial
'   Profile definitions: Partial; exact Extension arrow is approximated
' ============================================================================

title UML 2.5.1 Notation Reference — Instances, Packages, and Profiles
left to right direction
skinparam monochrome true
skinparam classAttributeIconSize 0

package "InstanceSpecifications" {
  object "order1 : Order" as order1 {
    status = PAID
    total = 42.00
  }

  object ": Order" as anonymousOrder {
    status = NEW
  }

  object "customer1 : Customer" as customer1 {
    name = "Example"
  }

  customer1 -- order1 : link

  note bottom of order1
    UML InstanceSpecification notation underlines
    the instance specification string in canonical UML.
    PlantUML's object element provides the closest
    native object/slot rendering.
  end note
}

package "Package organization" {
  package "Application" as Application {
    package "Domain" as DomainPackage {
      class DomainType
    }
  }

  package "Shared Library" as SharedLibrary {
    class SharedType
  }

  package "Receiving Package" as ReceivingPackage {

  }
  package "Merged Package" as MergedPackage {
  }
  Application ..> SharedLibrary : <<import>>
  ReceivingPackage ..> MergedPackage : <<merge>>

  note bottom of SharedLibrary
    UML PackageImport:
    dashed open-arrow dependency from the importing
    Namespace to the imported Package; keyword «import»
    (or «access» for private import).
  end note

  note bottom of MergedPackage
    UML PackageMerge:
    dashed open-arrow dependency from receivingPackage
    to mergedPackage; keyword «merge».
  end note
}

package "Profile notation — partial PlantUML mapping" {
  package "SecurityProfile" as SecurityProfile <<profile>> {
    stereotype Audited
    metaclass UMLClass
  }

  package "DomainModel" as DomainModel {

  }
  class "PaymentService" as PaymentService <<Audited>>

  DomainModel ..> SecurityProfile : <<apply>>

  ' UML Extension is an Association with a filled triangular arrowhead
  ' from Stereotype to the extended metaclass. PlantUML has no dedicated
  ' UML Profile Extension connector, so this link is explicitly approximate.
  Audited --> UMLClass : Extension\n(approx.)

  note right of PaymentService
    <b>Applied stereotype</b>
    «Audited»
    {owner = "AppSec"}
    {criticality = "high"}

    Tagged values shown here are explanatory
    values of Stereotype Properties.
  end note

  note bottom of SecurityProfile
    <b>UML profile rules</b>
    • Profile: Package notation + keyword «profile»
    • Stereotype: Class notation + keyword «stereotype»
    • ProfileApplication: dashed open arrow Package → Profile,
      keyword «apply» (or «strict»)
    • Extension: Stereotype → extended metaclass with a
      filled triangular arrowhead

    PlantUML natively declares stereotype/metaclass elements,
    but the exact UML Extension arrowhead is not first-class.
  end note
}

legend
  |= Area |= Mapping |
  | InstanceSpecification / slots | Native object syntax; UML underlining semantics may vary |
  | Nested Package | Native |
  | PackageImport / PackageMerge | Partial: dependency + UML keyword label |
  | Stereotype / metaclass declarations | Native PlantUML class-diagram declarations |
  | Profile / ProfileApplication | Partial |
  | UML Extension | Approximation: exact filled triangular head is not first-class |
endlegend
@enduml
