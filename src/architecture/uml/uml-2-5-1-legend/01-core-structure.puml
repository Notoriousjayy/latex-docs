@startuml
' Source block: uml251_01_core_structure (uml-2.5.1-legend.puml intake)
!include ../../../../tooling/styles/plantuml/structural/class-diagram-style.iuml
' ============================================================================
' UML 2.5.1 PlantUML Legend and Notation Reference
' Section 01 — General notation, classifiers, class notation, relationships
'
' UML traceability:
'   UML 2.5.1 §7.5 Types and Multiplicity
'   UML 2.5.1 §7.6 Constraints
'   UML 2.5.1 §7.7 Dependencies
'   UML 2.5.1 §9 Classification
'   UML 2.5.1 §10 Simple Classifiers
'   UML 2.5.1 §11.4 Classes
'   UML 2.5.1 §11.5 Associations
'
' PlantUML mapping target: v1.2026.8 official stable syntax (checked 2026-09-18)
' Support level: Native for core class notation; Partial for some adornments.
' ============================================================================

title UML 2.5.1 Notation Reference — Core Structure and Class Diagrams
left to right direction
' Framework monochrome mode (replaces `skinparam monochrome true`).
UML_MONOCHROME()
' NOTE: the retired `skinparam classAttributeIconSize 0` rendered +/- as
' text; member visibility is now shown with PlantUML's default icons
' (same UML visibility semantics, icon-encoded).
hide circle

package "Classifier notation" {
  abstract class "AbstractService" as AbstractService

  class "Order<T>" as Order {
    - id : UUID
    # subtotal : Money
    ~ validate() : Boolean
    {static} + nextNumber : Integer
    + {abstract} authorize(amount : Money) : Boolean
    + /computedTotal : Money
  }

  interface "Payable" as Payable {
    + pay(amount : Money) : Receipt
  }

  enum "OrderStatus" as OrderStatus {
    NEW
    PAID
    CANCELLED
  }

  class "Money" as Money <<dataType>>
  class "Integer" as IntegerType <<primitive>>
  class "PaymentAuthorized" as PaymentSignal <<signal>>

  class "Ledger" as Ledger
  note right of Ledger
    {balance >= 0}
    UML Constraint notation uses braces around
    a Boolean constraint expression.
  end note

  namespace com.example.billing {
    class "BillingFacade" as BillingFacade
  }

  note right of Order
    <b>Feature notation</b>
    + public
    - private
    # protected
    ~ package
    / derived Property
    {static} classifier/static feature
    {abstract} abstract feature

    PlantUML renders UML-like feature text,
    but UML semantics come from the model,
    not from the renderer.
  end note
}

package "Structural relationships" {
  class "GeneralClassifier" as General
  class "SpecificClassifier" as Specific
  General <|-- Specific : Generalization

  interface "Contract" as Contract
  class "Implementation" as Implementation
  Contract <|.. Implementation : InterfaceRealization

  class "Specification" as Specification
  class "Realizer" as Realizer
  Specification <|.. Realizer : Realization

  class "Supplier" as Supplier
  class "Client" as Client
  Client ..> Supplier : Dependency

  class "Whole" as Whole
  class "SharedPart" as SharedPart
  Whole "1" o-- "0..*" SharedPart : shared aggregation

  class "Composite" as Composite
  class "OwnedPart" as OwnedPart
  Composite "1" *-- "1..*" OwnedPart : composite aggregation

  class "Source" as Source
  class "Target" as Target
  Source "1" --> "0..*" Target : navigable Association

  class "PeerA" as PeerA
  class "PeerB" as PeerB
  PeerA "0..1" -- "2..5" PeerB : Association

  note bottom of Whole
    <b>Shared aggregation</b>
    Hollow diamond is placed at the aggregate (whole) end.
    UML 2.5.1 intentionally does not impose one universal
    lifecycle/ownership semantics for shared aggregation.
  end note

  note bottom of Composite
    <b>Composite aggregation</b>
    Filled diamond is placed at the composite (whole) end.
    A part is included in at most one composite at a time;
    composite destruction normally destroys contained parts.
  end note
}

package "Association adornments" {
  class "Directory" as Directory
  class "File" as File
  Directory [name : String] --> "0..1" File

  class "Customer" as Customer
  class "Purchase" as Purchase
  Customer "1"/customer -- "0..*"/orders Purchase : places

  class "Student" as Student
  class "Course" as Course
  class "Enrollment" as Enrollment
  Student "0..*" -- "1..*" Course
  (Student, Course) .. Enrollment

  note bottom of Directory
    Qualified Association:
    the qualifier is attached at an Association end.
  end note

  note bottom of Enrollment
    AssociationClass:
    PlantUML has first-class association-class syntax
    for a binary Association.
  end note
}

package "Multiplicity quick reference" {
  class "A" as M_A
  class "B" as M_B
  M_A "0..1" -- "1" M_B : optional ↔ exactly one

  class "C" as M_C
  class "D" as M_D
  M_C "*" -- "0..*" M_D : unlimited forms

  class "E" as M_E
  class "F" as M_F
  M_E "1..*" -- "2..5" M_F : bounded / non-empty range

  class "G" as M_G
  class "H" as M_H
  M_G "1" -- "0..* {ordered, nonunique}" M_H : collection modifiers

  note bottom
    Multiplicity is a property of the relevant UML
    MultiplicityElement / Association end. It is not
    decorative edge text.
  end note
}

legend
  |= UML concept |= PlantUML form |= Mapping |
  | Class / abstract class / interface / enumeration | class, abstract class, interface, enum | Native |
  | Generalization | General <|-- Specific | Native |
  | InterfaceRealization / Realization | Supplier <|.. Client | Native |
  | Dependency | Client ..> Supplier | Native |
  | Shared aggregation | Whole o-- Part | Native notation |
  | Composite aggregation | Whole *-- Part | Native notation |
  | Navigable Association | Source --> Target | Native |
  | Multiplicity | quoted endpoint labels | Native |
  | Qualifier | Class [qualifier] -- Class | Native |
  | AssociationClass | (A, B) .. AssociationClass | Native |
endlegend
@enduml
