@startuml
' Source block: uml251_07_state_machines (uml-2.5.1-legend.puml intake)
!include ../../../../tooling/styles/plantuml/behavioral/statemachine-diagram-style.iuml
' ============================================================================
' Section 07 — StateMachines
'
' UML traceability:
'   UML 2.5.1 §14.2 Behavior StateMachines
'   UML 2.5.1 §14.2.4 Notation
'
' PlantUML support: Native/Partial.
' Direct support is documented for start/end, choice, fork/join,
' shallow/deep history, entry/exit points, composite/concurrent states.
' No first-class documented junction or terminate Pseudostate mapping.
' ============================================================================

title UML 2.5.1 Notation Reference — State Machines
' Framework monochrome mode (replaces `skinparam monochrome true`).
UML_MONOCHROME()
hide empty description

state "Operating" as Operating {
  state "entry" as Entry <<entryPoint>>
  state "exit" as Exit <<exitPoint>>

  state "Idle" as Idle
  Idle : entry / clear()
  Idle : do / wait()
  Idle : exit / log()

  state "Processing" as Processing
  state "Decision" as Choice <<choice>>
  state "Fork" as ForkNode <<fork>>
  state "Join" as JoinNode <<join>>
  state "History" as ShallowHistory <<history>>
  state "DeepHistory" as DeepHistory <<history*>>
  state "Done" as Done
  state "Error" as Error

  Entry --> Idle
  [*] --> Idle

  Idle --> Processing : submit [valid] / begin()
  Processing --> Choice : evaluate
  Choice --> ForkNode : [accepted]
  Choice --> Error : [rejected]

  ForkNode --> Done : branch A
  ForkNode --> Processing : branch B
  Done --> JoinNode
  Processing --> JoinNode
  JoinNode --> Exit

  --
  [*] --> Monitoring
  Monitoring --> Monitoring : tick
}

[*] --> Operating
Operating --> [*] : shutdown
Exit --> [*]

note right of Operating
  <b>Transition label grammar</b>
  trigger [guard] / effect

  <b>State behaviors</b>
  entry / behavior
  do / behavior
  exit / behavior

  Orthogonal Regions are separated by dashed lines
  in UML; PlantUML uses -- or || inside a composite state.
end note

note as StateLimits
  <b>Pseudostate coverage note</b>
  UML junction = small filled circle.
  UML terminate = cross.
  PlantUML's official state syntax does not document
  dedicated junction or terminate mappings; do not
  substitute choice or FinalState because their semantics differ.
end note

legend
  |= UML concept |= PlantUML mapping |= Support |
  | State | state | Native |
  | Initial Pseudostate | [*] as source | Native |
  | FinalState | [*] as target / <<end>> | Native |
  | Choice | <<choice>> | Native |
  | Fork / Join | <<fork>> / <<join>> | Native |
  | shallowHistory / deepHistory | <<history>> / <<history*>> or [H]/[H*] | Native |
  | entryPoint / exitPoint | <<entryPoint>> / <<exitPoint>> | Native |
  | Composite State | state { ... } | Native |
  | Orthogonal Regions | -- or || | Native |
  | Junction | no dedicated documented mapping | Unsupported |
  | Terminate | no dedicated documented mapping | Unsupported |
endlegend
@enduml
