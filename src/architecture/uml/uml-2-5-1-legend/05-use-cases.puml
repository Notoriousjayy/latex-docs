@startuml
' Source block: uml251_05_use_cases (uml-2.5.1-legend.puml intake)
!include ../../../../tooling/styles/plantuml/behavioral/usecase-diagram-style.iuml
' ============================================================================
' Section 05 — Use Cases
'
' UML traceability:
'   UML 2.5.1 §18.1 Use Cases
'
' Direction rules:
'   Include: including/base UseCase → included UseCase
'   Extend: extending UseCase → extended UseCase
' ============================================================================

title UML 2.5.1 Notation Reference — Use Cases
left to right direction
skinparam monochrome true

actor "Customer" as CustomerActor
actor "Premium Customer" as PremiumActor

rectangle "Ordering System\n(subject / system boundary)" {
  usecase "Place Order" as PlaceOrder
  usecase "Checkout" as Checkout
  usecase "Authenticate" as Authenticate
  usecase "Apply Promotional Discount" as ApplyDiscount
}

CustomerActor -- PlaceOrder : Association
PlaceOrder ..> Checkout : <<include>>
Checkout ..> Authenticate : <<include>>
ApplyDiscount ..> Checkout : <<extend>>

CustomerActor <|-- PremiumActor : Actor Generalization

note right of Authenticate
  «include»
  Dashed open arrow from the including/base UseCase
  to the included UseCase.
end note

note right of ApplyDiscount
  «extend»
  Dashed open arrow from the extending UseCase
  to the extended UseCase.
end note

legend
  |= UML concept |= PlantUML mapping |
  | Actor | Native |
  | UseCase | Native |
  | Subject/system boundary | Native rectangle grouping |
  | Actor–UseCase Association | Native |
  | Generalization | Native |
  | Include | Native dependency-style arrow + «include» |
  | Extend | Native dependency-style arrow + «extend» |
endlegend
@enduml
